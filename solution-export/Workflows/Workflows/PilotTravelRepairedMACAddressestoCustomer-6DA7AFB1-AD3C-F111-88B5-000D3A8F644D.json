                    "actions": {
                      "Send_an_email_(V2)-copy": {
                        "type": "OpenApiConnection",
                        "inputs": {
                          "parameters": {
                            "emailMessage/To": "pqmn34@zebra.com",
                            "emailMessage/Subject": "PT: Repaired MAC addresses past two days",
