          "inputs": "<hr>\n<div style=\"font-family: Calibri, sans-serif; font-size: 11pt; color: #595959;\">\n    <p>\n        <i><b>Important:</b> This is an automated notification sent from an unmonitored mailbox. Please do not reply to this email.</i>\n    </p>\n    <ul>\n        <li>Send an email to <a href=\"mailto:strategicinnovationandautomation@zebra.com\">strategicinnovationandautomation@zebra.com</a> if there is any error in the data or email.</li>\n        <li><a href=\"https://apps.powerapps.com/play/e/79b05c38-71f1-4aab-b05e-a84fc8639bc8/a/4b38b2ea-8805-4f86-8dfc-782be0184e3d?tenantId=4d3d260a-9c40-4306-8dac-0d64717039ec&hint=b66d7893-cd22-40bd-8c2e-b0380e970971&source=sharebutton&sourcetime=1776331989538#\">Raise the CSI</a> if there is any change or improvement required.</li>\n    </ul>\n    <p>\n        Regards,<br>\n        Strategic Innovation and Automation\n    </p>\n    <p style=\"font-size: 10pt; color: #7F7F7F;\">\n        <b>- CONFIDENTIAL -</b><br>\n        This email and any files transmitted with it are confidential and may also be legally privileged. If you are not the intended recipient, you may not review, use, copy, or distribute this message. If you receive this email in error, please notify the sender immediately by reply email and then delete this email.\n    </p>\n</div>\n",
          "runAfter": {
            "CC": [
              "Succeeded"
            ]
          }
        },
        "ComposeRepairedMACCount": {
          "type": "Compose",
          "inputs": "@int(coalesce(outputs('RepairedPast2Days')?['body/firstTableRows']?[0]?['RepairedMACCount'], '0'))",
          "runAfter": {
