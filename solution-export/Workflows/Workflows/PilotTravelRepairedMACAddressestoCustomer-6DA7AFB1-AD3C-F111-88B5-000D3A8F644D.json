                            "parameters": {
                              "emailMessage/To": "@outputs('TO')",
                              "emailMessage/Subject": "PT: Repaired MAC addresses past two days",
                              "emailMessage/Body": "<p class=\"editor-paragraph\">Greetings!<br>Please find attached the reports of the Serial Out after repair.</p><p class=\"editor-paragraph\">@{outputs('Compose')}</p><br><p class=\"editor-paragraph\">@{outputs('EmailFooter-Internal')}</p>",
                              "emailMessage/Sensitivity": "85dc9e1d-66dc-457c-899d-453f6880d6d6",
                              "emailMessage/From": "strategicinnovationandautomation@zebra.com",
                              "emailMessage/Cc": "@outputs('CC')",
                              "emailMessage/Bcc": "StrategicInnovationandAutomation@Zebra.com",
                              "emailMessage/Attachments": [
                                {
                                  "Name": "repaired_mac_address_@{utcNow()}.csv",
                                  "ContentBytes": "@body('Create_CSV_table')"
                                }
                              ],
                              "emailMessage/Importance": "Normal"
                            },
                            "host": {
                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                              "operationId": "SendEmailV2",
                              "connectionName": "shared_office365"
                            }
                          },
                          "metadata": {
                            "operationMetadataId": "e6f6822a-6a99-4569-8c54-fce4ceabd249"
                          }
                        }
                      }
                    },
                    "runAfter": {
                      "Create_CSV_table": [
                        "Succeeded"
                      ]
                    },
                    "metadata": {
                      "operationMetadataId": "17ba7cd5-11ce-4546-8f6a-14785cedaad7"
                    }
                  },
                  "Create_HTML_table": {
                    "type": "Table",
                    "inputs": {
                      "from": "@body('Select_RepairedMAC')",
                      "format": "HTML"
                    },
                    "runAfter": {
                      "Select_RepairedMAC": [
                        "Succeeded"
                      ]
                    },
                    "metadata": {
                      "operationMetadataId": "8eda08a8-3d37-4ec3-b5a7-164e7b69c72c"
                    }
                  },
                  "Compose": {
                    "type": "Compose",
                    "inputs": "<style>\n    table {\n        width:100%;\n        height:100%;\n        border:1px solid #b3adad;\n        border-collapse:collapse;\n    }\n    table th {\n        border:1px solid #b3adad;\n        background: #0000FF; /* Blue background color */\n        color: #FFFFFF; /* White font color */\n    }\n    table td {\n        border:1px solid #b3adad;\n        text-align:center;\n        background: #ffffff;\n        color: #313030;\n    }\n</style>\n@{body('Create_HTML_table')}",
                    "runAfter": {
                      "Create_HTML_table": [
                        "Succeeded"
                      ]
                    },
                    "metadata": {
                      "operationMetadataId": "e6de21c2-2407-4e47-a528-c80fecd0ee85"
                    }
                  }
                }
              },
              "metadata": {
                "operationMetadataId": "9c8feab9-b5fa-4fea-8809-7c01cad2c477"
              }
            }
          },
          "runAfter": {
            "VariableRepairedPast2Days": [
              "Succeeded"
            ]
          }
        },
        "CatchError": {
          "type": "Scope",
          "actions": {
            "Post_message_in_a_chat_or_channel": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "poster": "Flow bot",
                  "location": "Channel",
                  "body/recipient/groupId": "02deece1-19d7-41b6-b50c-75e3cd5178ea",
                  "body/recipient/channelId": "19:b32c3b1c47a04ebf909717aa6eb147bc@thread.tacv2",
                  "body/messageBody": "<div style=\"border: 1px solid #e0e0e0; border-radius: 5px; overflow: hidden; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\">\n    <div style=\"background-color: #d83b01; color: white; padding: 10px; font-weight: bold; font-size: 16px;\">\n        🚨 FAILED: @{workflow()?['tags']['flowDisplayName']}\n    </div>\n    <div style=\"padding: 15px; background-color: #f9f9f9;\">\n        <table style=\"width: 100%; border-collapse: collapse;\">\n            <tbody>\n                <tr>\n                    <td style=\"padding: 5px 0; color: #666; width: 30%;\"><strong>Flow Name:</strong></td>\n                    <td style=\"padding: 5px 0;\">@{workflow()?['tags']['flowDisplayName']}</td>\n                </tr>\n                <tr>\n                    <td style=\"padding: 5px 0; color: #666;\"><strong>Failed Action:</strong></td>\n                    <td style=\"padding: 5px 0;\">@{body('Filter_array')?[0]?['name']}</td>\n                </tr>\n                <tr>\n                    <td style=\"padding: 5px 0; color: #d83b01;\"><strong>Error Message:</strong></td>\n                    <td style=\"padding: 5px 0; color: #d83b01;\"><b><u>@{outputs('Error_Message')}</u></b></td>\n                </tr>\n                <tr>\n                    <td style=\"padding: 5px 0; color: #666;\"><strong>Run ID:</strong></td>\n                    <td style=\"padding: 5px 0; font-family: monospace; font-size: 12px;\">@{workflow()?['run']?['name']}</td>\n                </tr>\n            </tbody>\n        </table>\n        <br>\n        <a href=\"@{concat('https://make.powerautomate.com/environments/', workflow()?['tags']?['environmentName'], '/flows/', workflow()?['name'], '/runs/', workflow()?['run']?['name'])}\" style=\"background-color: #0078d4; color: white; padding: 8px 16px; text-decoration: none; border-radius: 4px; display: inline-block;\">\n           View Failed Run\n        </a>\n    </div>\n</div>"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams",
                  "operationId": "PostMessageToConversation",
                  "connectionName": "shared_teams"
                }
              },
              "runAfter": {
                "Error_Message": [
                  "Succeeded"
                ]
              }
            },
            "Filter_array": {
              "type": "Query",
              "inputs": {
                "from": "@result('Scope')",
                "where": "@equals(item()?['status'],'Failed')"
              }
            },
            "Error_Message": {
              "type": "Compose",
              "inputs": "@coalesce(\r\n    first(body('Filter_Array'))?['body']?['error']?['message'],\r\n    first(body('Filter_Array'))?['outputs']?['body']?['error']?['message'],\r\n    first(body('Filter_Array'))?['error']?['message'],\r\n    'Unknown Error')",
              "runAfter": {
                "Filter_array": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {
            "Scope": [
              "TimedOut",
              "Skipped",
              "Failed"
            ]
          }
        },
        "RepairedPast2Days": {
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "groupid": "ed7233e2-1daf-4288-a3fd-d4943f0b8f89",
              "datasetid": "6c176de8-1bfb-4322-a464-f749fb13f45d",
              "specification/query": "// DAX Query\nEVALUATE\n\tROW(\n\t\"RepairedMACCount\", 'RMA_Proactive_MAC'[RepairedMACCount]\n)",
              "specification/serializerSettings/includeNulls": false
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_powerbi",
              "operationId": "ExecuteDatasetQuery",
              "connectionName": "shared_powerbi"
            }
          },
