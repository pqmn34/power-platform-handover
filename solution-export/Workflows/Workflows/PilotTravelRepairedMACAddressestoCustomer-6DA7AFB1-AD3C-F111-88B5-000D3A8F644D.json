      "actions": {
        "Scope": {
          "type": "Scope",
          "actions": {
            "Condition": {
              "type": "If",
              "expression": {
                "and": [
                  {
                    "lessOrEquals": [
                      "@outputs('ComposeRepairedMACCount')",
                      0
                    ]
                  }
                ]
              },
              "actions": {},
              "else": {
                "actions": {
                  "RepairedLastDay": {
                    "type": "OpenApiConnection",
                    "inputs": {
                      "parameters": {
                        "groupid": "ed7233e2-1daf-4288-a3fd-d4943f0b8f89",
                        "datasetid": "6c176de8-1bfb-4322-a464-f749fb13f45d",
                        "specification/query": "DEFINE\n\tVAR __DS0FilterTable = \n\t\tFILTER(\n\t\t\tKEEPFILTERS(VALUES('RMA_Proactive_MAC'[MAC])),\n\t\t\tNOT('RMA_Proactive_MAC'[MAC] IN {BLANK()})\n\t\t)\n\n\tVAR __DS0FilterTable2 = \n\t\tFILTER(\n\t\t\tKEEPFILTERS(VALUES('RMA_Proactive_MAC'[Serial Out])),\n\t\t\t'RMA_Proactive_MAC'[Serial Out] <> \"(Blank)\"\n\t\t)\n\n\tVAR __DS0FilterTable3 = \n\t\tFILTER(\n\t\t\tKEEPFILTERS(VALUES('pilot_siebel_repair_info'[Repair Created Date])),\n            -- This filters for any date from 2 days ago until the end of today\n\t\t\t'pilot_siebel_repair_info'[Repair Created Date] >= NOW() - 1\n\t\t)\n\n\tVAR __DS0Core = \n\t\tCALCULATETABLE(\n\t\t\tSUMMARIZE(\n\t\t\t\t'RMA_Proactive_MAC',\n\t\t\t\t'RMA_Proactive_MAC'[IMEI],\n\t\t\t\t'RMA_Proactive_MAC'[Inbound Tracking],\n\t\t\t\t'RMA_Proactive_MAC'[Device Registered],\n\t\t\t\t'RMA_Proactive_MAC'[MAC],\n\t\t\t\t'RMA_Proactive_MAC'[Outbound Tracking],\n\t\t\t\t'RMA_Proactive_MAC'[RMA],\n\t\t\t\t'RMA_Proactive_MAC'[Serial In],\n\t\t\t\t'RMA_Proactive_MAC'[Serial Out],\n\t\t\t\t'RMA_Proactive_MAC'[Ship to Address],\n\t\t\t\t'RMA_Proactive_MAC'[Ship to City],\n\t\t\t\t'RMA_Proactive_MAC'[Ship to State],\n\t\t\t\t'RMA_Proactive_MAC'[Ship to Store],\n\t\t\t\t'RMA_Proactive_MAC'[Serial Number],\n\t\t\t\t'RMA_Proactive_MAC'[Ship Date]\n\t\t\t),\n\t\t\tKEEPFILTERS(__DS0FilterTable),\n\t\t\tKEEPFILTERS(__DS0FilterTable2),\n\t\t\tKEEPFILTERS(__DS0FilterTable3)\n\t\t)\n\nEVALUATE\n\t__DS0Core\n\nORDER BY\n\t'RMA_Proactive_MAC'[Serial Out],\n\t'RMA_Proactive_MAC'[IMEI],\n\t'RMA_Proactive_MAC'[Inbound Tracking],\n\t'RMA_Proactive_MAC'[Device Registered],\n\t'RMA_Proactive_MAC'[MAC],\n\t'RMA_Proactive_MAC'[Outbound Tracking],\n\t'RMA_Proactive_MAC'[RMA],\n\t'RMA_Proactive_MAC'[Serial In],\n\t'RMA_Proactive_MAC'[Ship to Address],\n\t'RMA_Proactive_MAC'[Ship to City],\n\t'RMA_Proactive_MAC'[Ship to State],\n\t'RMA_Proactive_MAC'[Ship to Store],\n\t'RMA_Proactive_MAC'[Serial Number],\n\t'RMA_Proactive_MAC'[Ship Date]",
                        "specification/serializerSettings/includeNulls": false
                      },
                      "host": {
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_powerbi",
                        "operationId": "ExecuteDatasetQuery",
                        "connectionName": "shared_powerbi-1"
                      }
                    },
                    "metadata": {
                      "operationMetadataId": "ccaa465d-4163-4488-8927-3bf69158edde"
                    }
                  },
                  "Select_RepairedMAC": {
                    "type": "Select",
                    "inputs": {
                      "from": "@outputs('RepairedLastDay')?['body/firstTableRows']",
                      "select": {
                        "Serial Number": "@item()?['RMA_Proactive_MAC[Serial Number]']",
                        "IMEI": "@item()?['RMA_Proactive_MAC[IMEI]']",
                        "MAC": "@item()?['RMA_Proactive_MAC[MAC]']",
                        "Device Registered": "@formatDateTime(item()?['RMA_Proactive_MAC[Device Registered]'], 'MM/dd/yyyy', 'en-US')",
                        "RMA": "@item()?['RMA_Proactive_MAC[RMA]']",
                        "Serial In": "@item()?['RMA_Proactive_MAC[Serial In]']",
                        "Serial Out": "@item()?['RMA_Proactive_MAC[Serial Out]']",
                        "Ship to Store (Site)": "@item()?['RMA_Proactive_MAC[Ship to Store]']",
                        "Ship to Address": "@item()?['RMA_Proactive_MAC[Ship to Address]']",
                        "Ship to City": "@item()?['RMA_Proactive_MAC[Ship to City]']",
                        "Ship to State": "@item()?['RMA_Proactive_MAC[Ship to State]']",
                        "Ship Date": "@formatDateTime(item()?['RMA_Proactive_MAC[Ship Date]'], 'MM/dd/yyyy', 'en-US')",
                        "Inbound Tracking": "@item()?['RMA_Proactive_MAC[Inbound Tracking]']",
                        "Outbound Tracking": "@item()?['RMA_Proactive_MAC[Outbound Tracking]']"
                      }
                    },
                    "runAfter": {
                      "RepairedLastDay": [
                        "Succeeded"
                      ]
                    },
                    "metadata": {
                      "operationMetadataId": "6ce05d4f-206b-4f20-895c-59a9fb123009"
                    }
                  },
                  "Create_CSV_table": {
                    "type": "Table",
                    "inputs": {
                      "from": "@body('Select_RepairedMAC')",
                      "format": "CSV"
                    },
                    "runAfter": {
                      "Compose": [
                        "Succeeded"
                      ]
                    },
                    "metadata": {
                      "operationMetadataId": "c0ac1ad5-275c-4ce6-92c5-b3db106290ec"
                    }
                  },
                  "Condition_2": {
                    "type": "If",
                    "expression": {
                      "and": [
                        {
                          "lessOrEquals": [
