        "Scope": {
          "type": "Scope",
          "actions": {
            "RMG_RML_APK_Daily_CR_HIT_Rate_By_Site": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "groupid": "ed7233e2-1daf-4288-a3fd-d4943f0b8f89",
                  "datasetid": "b6a56604-7b3d-487e-9038-96e00e480413",
                  "specification/query": "DEFINE\n\tVAR __DS0Core = \n\t\tSUMMARIZECOLUMNS(\n\t\t\tROLLUPADDISSUBTOTAL(\n\t\t\t\tROLLUPGROUP(\n\t\t\t\t\t'RML Release Table TC57X'[RML Site Name | Code],\n\t\t\t\t\t'RML Release Table TC57X'[Prerequisites FT Type]\n\t\t\t\t), \"IsGrandTotalRowTotal\"\n\t\t\t),\n\t\t\t\"Total_RML_Active_Devices_TC57X\", 'RML Release Table TC57X'[Total RML Active Devices TC57X],\n\t\t\t\"RML_APK_Pending_Due_to_Offline_TC57X\", 'RML Release Table TC57X'[RML APK Pending Due to Offline TC57X],\n\t\t\t\"RML_APK_Pending_NOT_on_WiFi_TC57X\", 'RML Release Table TC57X'[RML APK Pending NOT on WiFi TC57X],\n\t\t\t\"RML_APK_FT_Completed_TC57X\", 'RML Release Table TC57X'[RML APK FT Completed TC57X],\n\t\t\t\"v__RML_APK_Offline_TC57X\", 'RML Release Table TC57X'[% RML APK Offline TC57X],\n\t\t\t\"v__RML_APK_NOT_on_Wifi_TC57X\", 'RML Release Table TC57X'[% RML APK NOT on Wifi TC57X],\n\t\t\t\"v__RML_APK_FT_Completed_TC57X\", 'RML Release Table TC57X'[% RML APK FT Completed TC57X],\n\t\t\t\"RML_APK_Upgraded_TC57X\", 'RML Release Table TC57X'[RML APK Upgraded TC57X],\n\t\t\t\"RML_APK_Pending_TC57X\", 'RML Release Table TC57X'[RML APK Pending TC57X],\n\t\t\t\"v__RML_APK_Upgraded_TC57X\", 'RML Release Table TC57X'[% RML APK Upgraded TC57X],\n\t\t\t\"v__RML_APK_Pending_TC57X\", 'RML Release Table TC57X'[% RML APK Pending TC57X]\n\t\t)\n\nEVALUATE\n\t__DS0Core\n\nORDER BY\n\t[IsGrandTotalRowTotal] DESC,\n\t'RML Release Table TC57X'[RML Site Name | Code],\n\t'RML Release Table TC57X'[Prerequisites FT Type]",
                  "specification/serializerSettings/includeNulls": false
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_powerbi",
                  "operationId": "ExecuteDatasetQuery",
                  "connectionName": "shared_powerbi"
                }
              },
              "runAfter": {
                "Get_Banner_Image": [
                  "Succeeded"
                ]
              }
            },
            "Export_To_File_for_Power_BI_Reports": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "groupid": "ed7233e2-1daf-4288-a3fd-d4943f0b8f89",
                  "reportid": "4c90ed8f-73d3-40de-ad49-00771b646298",
                  "ExportPayloadPowerBIReport/format": "PNG",
                  "ExportPayloadPowerBIReport/PowerBIReportExportConfiguration/settings/includeHiddenPages": true,
                  "ExportPayloadPowerBIReport/PowerBIReportExportConfiguration/pages": [
                    {
                      "pageName": "d9fa07804133212314aa"
                    }
                  ]
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_powerbi",
                  "operationId": "InitiateExportToFileForPbiReports",
                  "connectionName": "shared_powerbi"
                }
              },
              "runAfter": {
                "Create_CSV_table-Site": [
                  "Succeeded"
                ]
              }
            },
            "Filter_array": {
              "type": "Query",
              "inputs": {
                "from": "@outputs('RMG_RML_APK_Daily_CR_HIT_Rate_By_Site')?['body/firstTableRows']",
                "where": "@equals(item()?['[IsGrandTotalRowTotal]'],false)"
              },
              "runAfter": {
                "RMG_RML_APK_Daily_CR_HIT_Rate_By_Site": [
                  "Succeeded"
                ]
              }
            },
            "Select-Site": {
              "type": "Select",
              "inputs": {
                "from": "@body('Filter_array')",
                "select": {
                  "Site Name": "@item()?['RML Release Table TC57X[RML Site Name | Code]']",
                  "Total Active Devices": "@item()?['[Total_RML_Active_Devices_TC57X]']",
                  "Offline": "@item()?['[RML_APK_Pending_Due_to_Offline_TC57X]']",
                  "Not on WiFi": "@item()?['[RML_APK_Pending_NOT_on_WiFi_TC57X]']",
                  "FT Completed": "@item()?['[RML_APK_FT_Completed_TC57X]']",
                  "Offline %": "@formatNumber(coalesce(item()?['[v__RML_APK_Offline_TC57X]'], 0), '0.0%')",
                  "Not on WiFi %": "@formatNumber(coalesce(item()?['[v__RML_APK_NOT_on_Wifi_TC57X]'], 0), '0.0%')",
                  "FT Completed %": "@formatNumber(coalesce(item()?['[v__RML_APK_FT_Completed_TC57X]'], 0), '0.0%')",
                  "Upgraded": "@item()?['[RML_APK_Upgraded_TC57X]']",
                  "Pending": "@item()?['[RML_APK_Pending_TC57X]']",
                  "Upgraded %": "@formatNumber(coalesce(item()?['[v__RML_APK_Upgraded_TC57X]'], 0), '0.0%')",
                  "Pending %": "@formatNumber(coalesce(item()?['[v__RML_APK_Pending_TC57X]'], 0), '0.0%')"
                }
              },
              "runAfter": {
                "Filter_array": [
                  "Succeeded"
                ]
              }
            },
            "Create_CSV_table-Site": {
              "type": "Table",
              "inputs": {
                "from": "@body('Select-Site')",
                "format": "CSV"
              },
              "runAfter": {
                "Select-Site": [
                  "Succeeded"
                ]
              }
            },
            "Compose_dashboard": {
              "type": "Compose",
              "inputs": "<img src=\"data:image/png;base64,@{base64(outputs('Export_to_File_for_Power_BI_Reports')?['body'])}\" \n     style=\"display:block; width:100%; max-width:900px; height:auto;\" />",
              "runAfter": {
                "Export_To_File_for_Power_BI_Reports": [
                  "Succeeded"
                ]
              }
            },
            "Compose_EmailTop": {
              "type": "Compose",
              "inputs": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta name=\"color-scheme\" content=\"light only\">\n  <meta name=\"supported-color-schemes\" content=\"light only\">\n  <meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n\n  <style>\n    :root {\n      color-scheme: light only;\n      supported-color-schemes: light only;\n    }\n\n    body, table, td, p, h1, h2, h3, ul, li {\n      margin: 0;\n      padding: 0;\n      font-family: Arial, Helvetica, sans-serif;\n    }\n\n    table {\n      border-collapse: collapse;\n      mso-table-lspace: 0pt;\n      mso-table-rspace: 0pt;\n    }\n\n    img {\n      border: 0;\n      outline: none;\n      text-decoration: none;\n      -ms-interpolation-mode: bicubic;\n      display: block;\n    }\n\n    .outer-wrapper {\n      width: 100%;\n      background-color: #ffffff;\n    }\n\n    .container {\n      width: 100%;\n      max-width: 1200px;\n      background-color: #ffffff;\n    }\n\n    .content-padding {\n      padding: 24px 32px 16px 32px;\n    }\n\n    .footer-padding {\n      padding: 16px 32px;\n    }\n\n    .body-text {\n      font-size: 13px;\n      line-height: 1.7;\n      color: #222222 !important;\n    }\n\n    .small-text {\n      font-size: 12px;\n      line-height: 1.6;\n      color: #666666 !important;\n    }\n\n    .title-text {\n      font-size: 24px;\n      line-height: 1.3;\n      font-weight: bold;\n      color: #111111 !important;\n    }\n\n    .subtitle-text {\n      font-size: 15px;\n      line-height: 1.5;\n      font-weight: bold;\n      color: #111111 !important;\n    }\n\n    .chart-box {\n      background-color: #fafafa;\n      border: 1px solid #dddddd;\n      border-radius: 4px;\n      padding: 10px;\n    }\n\n    .notice-box {\n      margin-top: 18px;\n      margin-bottom: 18px;\n      padding: 12px 14px;\n      background-color: #f7f7f7;\n      border-left: 4px solid #999999;\n      font-size: 12px;\n      line-height: 1.6;\n      color: #666666 !important;\n      font-style: italic;\n    }\n\n    @media only screen and (max-width: 640px) {\n      .content-padding {\n        padding: 18px 16px 14px 16px !important;\n      }\n\n      .footer-padding {\n        padding: 14px 16px !important;\n      }\n\n      .title-text {\n        font-size: 20px !important;\n        line-height: 1.3 !important;\n      }\n\n      .subtitle-text {\n        font-size: 14px !important;\n      }\n\n      .body-text {\n        font-size: 13px !important;\n        line-height: 1.7 !important;\n      }\n\n      .small-text {\n        font-size: 11px !important;\n      }\n\n      .mobile-full {\n        width: 100% !important;\n      }\n\n      .mobile-padding-reset {\n        padding-left: 0 !important;\n        padding-right: 0 !important;\n      }\n    }\n\n    @media (prefers-color-scheme: dark) {\n      .outer-wrapper,\n      .container,\n      .content-cell {\n        background-color: #ffffff !important;\n      }\n\n      .footer-cell {\n        background-color: #f4f4f4 !important;\n      }\n\n      p, h1, h2, h3, li, div, td, span {\n        color: #222222 !important;\n      }\n    }\n  </style>\n</head>\n\n<body style=\"margin:0; padding:0; background-color:#ffffff;\">\n\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" class=\"outer-wrapper\" style=\"width:100%; background-color:#ffffff;\">\n  <tr>\n    <td align=\"center\" style=\"padding:0;\">\n\n      <!--[if mso]>\n      <table role=\"presentation\" width=\"1200\" align=\"center\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n        <tr>\n          <td>\n      <![endif]-->\n\n      <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" class=\"container\" style=\"width:100%; max-width:1200px; background-color:#ffffff;\">\n        \n        <!-- Banner -->\n        <tr>\n          <td style=\"padding:0; margin:0; line-height:0; font-size:0; background-color:#1a1a2e;\">\n            <img src=\"data:image/png;base64,@{base64(outputs('Get_Banner_Image')?['body'])}\"\n                 alt=\"Zebra Technologies | Royal Mail\"\n                 width=\"1200\"\n                 style=\"width:100%; max-width:1200px; height:auto;\">\n          </td>\n        </tr>\n\n        <!-- Content -->\n        <tr>\n          <td class=\"content-cell content-padding\" style=\"padding:24px 32px 16px 32px; background-color:#ffffff;\">\n\n            <p class=\"body-text\" style=\"margin:0 0 14px 0; font-size:13px; line-height:1.7; color:#222222;\">\n              Dear All,\n            </p>\n\n            <h1 class=\"title-text\" style=\"margin:0 0 8px 0; font-size:24px; line-height:1.3; font-weight:bold; color:#111111;\">\n              RMG &ndash; RML &amp; PFW: June Release 2026 Update\n            </h1>\n\n            <h2 class=\"subtitle-text\" style=\"margin:0 0 18px 0; font-size:15px; line-height:1.5; font-weight:bold; color:#111111;\">\n              Current Release Summary:\n              @{formatDateTime(utcNow(), 'dd')}<sup>th</sup>\n              @{formatDateTime(utcNow(), 'MMMM yyyy')}\n            </h2>\n\n            <!-- Chart -->\n            <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin:0 0 22px 0;\">\n              <tr>\n                <td class=\"chart-box\" style=\"background-color:#fafafa; border:1px solid #dddddd; border-radius:12px; padding:12px; overflow:hidden;\">\n  <img src=\"data:image/png;base64,@{base64(outputs('Export_to_File_for_Power_BI_Reports')?['body'])}\"\n       alt=\"Power BI Dashboard\"\n       width=\"1136\"\n       style=\"display:block; width:100%; max-width:1136px; height:auto; border:none; border-radius:10px;\">\n</td>\n\n              </tr>\n            </table>\n\n            <p class=\"body-text\" style=\"margin:0 0 14px 0; font-size:13px; line-height:1.7; color:#222222;\">\n              <strong>The Upgrade Hit Rate has now reached or exceeded 95%</strong>, so customer-facing daily communications have been stopped in line with the agreed process.\n            </p>\n\n            <p class=\"body-text\" style=\"margin:0 0 4px 0; font-size:13px; line-height:1.7; color:#222222;\">\n              <strong>Important Considerations</strong>\n            </p>\n\n            <p class=\"body-text\" style=\"margin:0 0 16px 0; font-size:13px; line-height:1.7; color:#555555; font-style:italic;\">\n              Devices over 14 days offline are not included in this report.\n            </p>\n\n            <p class=\"body-text\" style=\"margin:0 0 8px 0; font-size:13px; line-height:1.7; color:#222222;\">\n              Please find attached:\n            </p>\n\n            <ul style=\"margin:0 0 20px 20px; padding:0; color:#222222;\">\n              <li class=\"body-text\" style=\"margin:0 0 4px 0; font-size:13px; line-height:1.7; color:#222222;\">\n                Release Hit Rate Detailed Data By Site CSV\n              </li>\n              <li class=\"body-text\" style=\"margin:0; font-size:13px; line-height:1.7; color:#222222;\">\n                Release Hit Rate Detailed Data By IMEI\n              </li>\n            </ul>\n\n            <div class=\"notice-box\" style=\"margin-top:18px; margin-bottom:18px; padding:12px 14px; background-color:white; border-left:0px solid #999999; font-size:12px; line-height:1.6; color:#666666; font-style:italic;\">\n              Important: This is an automated notification sent from an unmonitored mailbox. Please do not reply to this email. Please reach out to Change Management if you have any questions.\n            </div>\n\n            <p class=\"body-text\" style=\"margin:0 0 4px 0; font-size:13px; line-height:1.7; color:#222222;\">\n              Sincerely,\n            </p>\n\n            <p class=\"body-text\" style=\"margin:0 0 24px 0; font-size:13px; line-height:1.7; color:#222222; font-weight:bold;\">\n              Zebra Change &amp; Release Management Team\n            </p>\n\n          </td>\n        </tr>\n\n        <!-- Footer -->\n        <tr>\n          <td class=\"footer-cell footer-padding\" style=\"background-color:#f5f5f5; padding:16px 32px; border-top:1px solid #dddddd; text-align:center;\">\n            <p class=\"small-text\" style=\"margin:0 0 4px 0; font-size:11px; line-height:1.6; color:#666666;\">\n              ZEBRA and the stylized Zebra head are trademarks of Zebra Technologies Corporation,\n            </p>\n            <p class=\"small-text\" style=\"margin:0 0 4px 0; font-size:11px; line-height:1.6; color:#666666;\">\n              registered in many jurisdictions worldwide. All other trademarks are the property of their respective owners.\n            </p>\n            <p class=\"small-text\" style=\"margin:0; font-size:11px; line-height:1.6; color:#666666;\">\n              &copy; 2026 Zebra Technologies Corporation and/or its affiliates. All rights reserved.\n            </p>\n          </td>\n        </tr>\n\n      </table>\n\n      <!--[if mso]>\n          </td>\n        </tr>\n      </table>\n      <![endif]-->\n\n    </td>\n  </tr>\n</table>\n\n</body>\n</html>",
              "runAfter": {
                "Compose_dashboard": [
                  "Succeeded"
                ]
              }
            },
            "Calculate_Loops": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "groupid": "ed7233e2-1daf-4288-a3fd-d4943f0b8f89",
                  "datasetid": "b6a56604-7b3d-487e-9038-96e00e480413",
                  "specification/query": "EVALUATE\nROW(\n    \"loopsNeeded\", ROUNDUP(\n        CALCULATE(DISTINCTCOUNT('RML Release Table TC57X'[Index]))/@{variables('incrRows')}, 1) + 1\n    )",
                  "specification/serializerSettings/includeNulls": false
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_powerbi",
                  "operationId": "ExecuteDatasetQuery",
                  "connectionName": "shared_powerbi"
                }
              }
            },
            "Loops2run": {
              "type": "Compose",
              "inputs": "@outputs('Calculate_Loops')?['body/firstTableRows']?[0]?['[loopsNeeded]']",
              "runAfter": {
                "Calculate_Loops": [
                  "Succeeded"
                ]
              }
            },
            "Do_until": {
              "type": "Until",
              "expression": "@greaterOrEquals(variables('LoopsVar'),outputs('Loops2run'))",
              "limit": {
                "count": 60,
                "timeout": "PT1H"
              },
              "actions": {
                "Run_a_query_against_a_dataset": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "parameters": {
                      "groupid": "ed7233e2-1daf-4288-a3fd-d4943f0b8f89",
                      "datasetid": "b6a56604-7b3d-487e-9038-96e00e480413",
                      "specification/query": "DEFINE\n    // 1. Create the pagination filter using the new Zebra table and your Power Automate variables\n    VAR __DS0FilterTable = \n        FILTER(\n            KEEPFILTERS(VALUES('RML Release Table TC57X'[Index])), \n            AND(\n                'RML Release Table TC57X'[Index] >= @{variables('MinRows')}, \n                'RML Release Table TC57X'[Index] <= @{variables('incrRows')}\n            )\n        )\n\n    // 2. Wrap your SUMMARIZE function inside CALCULATE TABLE to apply the filter\n    VAR __DS0Core = \n        CALCULATETABLE(\n            SUMMARIZE(\n                'RML Release Table TC57X',\n                'RML Release Table TC57X'[RML Site Name | Code],\n                'RML Release Table TC57X'[Asset No],\n                'RML Release Table TC57X'[IMEI],\n                'RML Release Table TC57X'[Connection Status],\n                'RML Release Table TC57X'[Last Time Stamp],\n                'RML Release Table TC57X'[RML FT Done TC57X],\n                'RML Release Table TC57X'[RML Upgraded],\n                'RML Release Table TC57X'[Last Known Connection],\n                'RML Release Table TC57X'[Prerequisites Release Version],\n                'RML Release Table TC57X'[FT Type],\n                'RML Release Table TC57X'[Index],\n                'RML Release Table TC57X'[Day(s) Offline]\n            ),\n            __DS0FilterTable\n        )\n\nEVALUATE\n    __DS0Core\n\nORDER BY\n    // It is highly recommended to order by Index first when paginating in Power Automate\n    'RML Release Table TC57X'[Index],\n    'RML Release Table TC57X'[FT Type],\n    'RML Release Table TC57X'[RML Site Name | Code],\n    'RML Release Table TC57X'[Asset No],\n    'RML Release Table TC57X'[IMEI],\n    'RML Release Table TC57X'[Connection Status],\n    'RML Release Table TC57X'[Last Time Stamp],\n    'RML Release Table TC57X'[RML FT Done TC57X],\n    'RML Release Table TC57X'[RML Upgraded],\n    'RML Release Table TC57X'[Last Known Connection],\n    'RML Release Table TC57X'[Prerequisites Release Version],\n    'RML Release Table TC57X'[Day(s) Offline]",
                      "specification/serializerSettings/includeNulls": false
                    },
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_powerbi",
                      "operationId": "ExecuteDatasetQuery",
                      "connectionName": "shared_powerbi"
                    }
                  }
                },
                "Create_CSV_table": {
                  "type": "Table",
                  "inputs": {
                    "from": "@body('Select')",
                    "format": "CSV"
                  },
                  "runAfter": {
                    "Select": [
                      "Succeeded"
                    ]
                  }
                },
                "IncrMinRows": {
                  "type": "IncrementVariable",
                  "inputs": {
                    "name": "MinRows",
                    "value": 5000
                  },
                  "runAfter": {
                    "Create_CSV_table": [
                      "Succeeded"
                    ]
                  }
                },
                "IncrRows2": {
                  "type": "IncrementVariable",
                  "inputs": {
                    "name": "incrRows",
                    "value": 5000
                  },
                  "runAfter": {
                    "IncrMinRows": [
                      "Succeeded"
                    ]
                  }
                },
                "IncrLoops": {
                  "type": "IncrementVariable",
                  "inputs": {
                    "name": "LoopsVar",
                    "value": 1
                  },
                  "runAfter": {
                    "IncrRows2": [
                      "Succeeded"
                    ]
                  }
                },
                "Append_to_string_variable": {
                  "type": "AppendToStringVariable",
                  "inputs": {
                    "name": "appendCSV",
                    "value": "@if(equals(variables('LoopsVar'), 2), body('Create_CSV_Table'), join(skip(split(body('Create_CSV_Table'), decodeUriComponent('%0A')),1), decodeUriComponent('%0A')))"
                  },
                  "runAfter": {
                    "IncrLoops": [
                      "Succeeded"
                    ]
                  }
                },
                "Select": {
                  "type": "Select",
                  "inputs": {
                    "from": "@outputs('Run_a_query_against_a_dataset')?['body/firstTableRows']",
                    "select": {
                      "Site Name | Code": "@item()?['RML Release Table TC57X[RML Site Name | Code]']",
                      "Asset Number": "@item()?['RML Release Table TC57X[Asset No]']",
                      "IMEI": "@item()?['RML Release Table TC57X[IMEI]']",
                      "Connection Status": "@item()?['RML Release Table TC57X[Connection Status]']",
                      "Last Known Connection": "@item()?['RML Release Table TC57X[Last Known Connection]']",
                      "FT Completed": "@item()?['RML Release Table TC57X[RML FT Done TC57X]']",
                      "Upgraded": "@item()?['RML Release Table TC57X[RML Upgraded]']",
                      "Last Seen": "@formatDateTime(item()?['RML Release Table TC57X[Last Time Stamp]'],'dd-mm-yyyy HH:mm')",
                      "Days Offline": "@item()?['RML Release Table TC57X[Day(s) Offline]']",
                      "Release Version": "@item()?['RML Release Table TC57X[Prerequisites Release Version]']",
                      "FT Type": "@item()?['RML Release Table TC57X[FT Type]']"
                    }
                  },
                  "runAfter": {
                    "Run_a_query_against_a_dataset": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "runAfter": {
                "Loops2run": [
                  "Succeeded"
                ]
              }
            },
            "convert2csv": {
              "type": "Compose",
              "inputs": "@variables('appendCSV')",
              "runAfter": {
                "Do_until": [
                  "Succeeded"
                ]
              }
            },
            "Create_file": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "dataset": "https://zebra.sharepoint.com/sites/DMSBAExternal",
                  "folderPath": "/Shared Documents/RMG/CRM/RML/APK/BY_IMEI/",
                  "name": "rml_apk_imei_@{utcNow()}.csv",
                  "body": "@outputs('convert2csv')"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "operationId": "CreateFile",
                  "connectionName": "shared_sharepointonline-1"
                }
              },
              "runAfter": {
                "convert2csv": [
                  "Succeeded"
                ]
              },
              "runtimeConfiguration": {
                "contentTransfer": {
                  "transferMode": "Chunked"
                }
              }
            },
            "Get_Banner_Image": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "dataset": "https://zebra.sharepoint.com/sites/DMSBAExternal",
                  "id": "%252fShared%2bDocuments%252fRMG%252fCRM%252frmg_release_banner.png",
                  "inferContentType": true
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "operationId": "GetFileContent",
                  "connectionName": "shared_sharepointonline"
                }
              },
              "runAfter": {
                "Create_file": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "%252fShared%2bDocuments%252fRMG%252fCRM%252frmg_release_banner.png": "/Shared Documents/RMG/CRM/rmg_release_banner.png"
              }
            }
          },
          "runAfter": {
            "LoopsVar": [
              "Succeeded"
            ]
          }
        },
        "EmailTO": {
          "type": "Compose",
          "inputs": "matthew.mcdonnell@zebra.com;jocasta.malinova@zebra.com;jana.hermannova@zebra.com;jan.hanak@zebra.com;pqmn34@zebra.com",
          "runAfter": {}
        }
      }
    },
