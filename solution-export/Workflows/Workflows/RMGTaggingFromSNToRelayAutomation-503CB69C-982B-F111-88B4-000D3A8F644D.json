              "minutes": [
                10
              ],
              "weekDays": [
                "Monday",
                "Tuesday",
                "Wednesday",
                "Thursday",
                "Friday",
                "Saturday"
              ]
            },
            "startTime": "2025-11-05T08:46:37Z"
          }
        }
      },
      "actions": {
        "Scope": {
          "type": "Scope",
          "actions": {
            "Get_secret_UID": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "secretName": "rmg-LnS-42g-uid"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_keyvault",
                  "operationId": "GetSecret",
                  "connectionName": "shared_keyvault"
                }
              },
              "runAfter": {
