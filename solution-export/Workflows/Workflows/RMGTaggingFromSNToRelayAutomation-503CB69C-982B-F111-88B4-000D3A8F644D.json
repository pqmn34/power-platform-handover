      "triggers": {
        "Recurrence": {
          "type": "Recurrence",
          "recurrence": {
            "interval": 1,
            "frequency": "Week",
            "timeZone": "Central Europe Standard Time",
            "schedule": {
              "hours": [
                "18",
                "10"
