            "Get_secret_PSWD": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "secretName": "rmg-LnS-42g-pswd"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_keyvault",
                  "operationId": "GetSecret",
                  "connectionName": "shared_keyvault"
                }
              },
              "runAfter": {
                "Get_secret_UID": [
                  "Succeeded"
                ]
              },
              "runtimeConfiguration": {
                "secureData": {
                  "properties": [
                    "inputs",
                    "outputs"
                  ]
                }
              }
            },
            "Run_a_query_against_a_dataset": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "groupid": "ed7233e2-1daf-4288-a3fd-d4943f0b8f89",
                  "datasetid": "b6a56604-7b3d-487e-9038-96e00e480413",
                  "specification/query": "// DAX Query\nEVALUATE\n\tROW(\n\t\"CountRelayTag\", 'Relay PDA Tagging Table'[CountRelayTag]\n)\n",
                  "specification/serializerSettings/includeNulls": false
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_powerbi",
                  "operationId": "ExecuteDatasetQuery",
                  "connectionName": "shared_powerbi"
                }
              },
              "runAfter": {
                "Get_secret_PSWD": [
                  "Succeeded"
                ]
              }
            },
            "Compose": {
              "type": "Compose",
              "inputs": "@int(coalesce(first(body('Run_a_query_against_a_dataset')?['firstTableRows'])?['[CountRelayTag]'], 0))",
              "runAfter": {
                "Run_a_query_against_a_dataset": [
                  "Succeeded"
                ]
              }
            },
            "Condition": {
              "type": "If",
              "expression": {
                "and": [
                  {
                    "greater": [
                      "@outputs('Compose')",
                      0
                    ]
                  }
                ]
              },
              "actions": {
                "SN_Needs_to_be_Tagged_Relay": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "parameters": {
                      "groupid": "ed7233e2-1daf-4288-a3fd-d4943f0b8f89",
                      "datasetid": "b6a56604-7b3d-487e-9038-96e00e480413",
                      "specification/query": "DEFINE\n\tVAR __DS0Core = \n\t\tSUMMARIZE(\n\t\t\t'Relay PDA Tagging Table',\n\t\t\t'Relay PDA Tagging Table'[Address],\n\t\t\t'Relay PDA Tagging Table'[Device ID],\n\t\t\t'Relay PDA Tagging Table'[Device Name],\n\t\t\t'Relay PDA Tagging Table'[DOBI],\n\t\t\t'Relay PDA Tagging Table'[Group Path],\n\t\t\t'Relay PDA Tagging Table'[IMEI],\n\t\t\t'Relay PDA Tagging Table'[Serial Number],\n\t\t\t'Relay PDA Tagging Table'[Status],\n\t\t\t'Relay PDA Tagging Table'[Stock],\n\t\t\t'Relay PDA Tagging Table'[Asset No.],\n\t\t\t'Relay PDA Tagging Table'[Asset Tag],\n\t\t\t'Relay PDA Tagging Table'[Contract ID],\n\t\t\t'Relay PDA Tagging Table'[Serial No.]\n\t\t)\n\nEVALUATE\n\t__DS0Core\n\nORDER BY\n\t'Relay PDA Tagging Table'[Address],\n\t'Relay PDA Tagging Table'[Device ID],\n\t'Relay PDA Tagging Table'[Device Name],\n\t'Relay PDA Tagging Table'[DOBI],\n\t'Relay PDA Tagging Table'[Group Path],\n\t'Relay PDA Tagging Table'[IMEI],\n\t'Relay PDA Tagging Table'[Serial Number],\n\t'Relay PDA Tagging Table'[Status],\n\t'Relay PDA Tagging Table'[Stock],\n\t'Relay PDA Tagging Table'[Asset No.],\n\t'Relay PDA Tagging Table'[Asset Tag],\n\t'Relay PDA Tagging Table'[Contract ID],\n\t'Relay PDA Tagging Table'[Serial No.]",
                      "specification/serializerSettings/includeNulls": false
                    },
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_powerbi",
                      "operationId": "ExecuteDatasetQuery",
                      "connectionName": "shared_powerbi"
                    }
                  }
                },
                "Select": {
                  "type": "Select",
                  "inputs": {
                    "from": "@outputs('SN_Needs_to_be_Tagged_Relay')?['body/firstTableRows']",
                    "select": {
                      "Device Name": "@item()?['Relay PDA Tagging Table[Device Name]']",
                      "Serial Number": "@item()?['Relay PDA Tagging Table[Serial No.]']",
                      "IMEI": "@item()?['Relay PDA Tagging Table[IMEI]']",
                      "Device Group Path": "@item()?['Relay PDA Tagging Table[Group Path]']",
                      "Address": "@item()?['Relay PDA Tagging Table[Address]']",
                      "Asset No.": "@item()?['Relay PDA Tagging Table[Asset No.]']",
                      "Asset Tag": "@item()?['Relay PDA Tagging Table[Asset Tag]']",
                      "Contract ID": "@item()?['Relay PDA Tagging Table[Contract ID]']",
                      "DOBI": "@item()?['Relay PDA Tagging Table[DOBI]']",
                      "Status": "@item()?['Relay PDA Tagging Table[Status]']",
                      "Stock": "@item()?['Relay PDA Tagging Table[Stock]']",
                      "Device ID": "@item()?['Relay PDA Tagging Table[Device ID]']"
                    }
                  },
                  "runAfter": {
                    "SN_Needs_to_be_Tagged_Relay": [
                      "Succeeded"
                    ]
                  }
                },
                "Create_CSV_table": {
                  "type": "Table",
                  "inputs": {
                    "from": "@body('Select')",
                    "format": "CSV"
                  },
                  "runAfter": {
                    "Select": [
                      "Succeeded"
                    ]
                  }
                },
                "Create_file": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "parameters": {
                      "dataset": "https://zebra.sharepoint.com/sites/DMSBAExternal",
                      "folderPath": "/Shared Documents/RMG/PROJECTS/RELAY/RELAY TAGGING/",
                      "name": "SN_TO_RELAY_TAG_@{concat(formatDateTime(utcNow(), 'dd.MM.yyyy HH:mm'), '.csv')}",
                      "body": "@body('Create_CSV_table')"
                    },
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                      "operationId": "CreateFile",
                      "connectionName": "shared_sharepointonline"
                    }
                  },
                  "runAfter": {
                    "Create_CSV_table": [
                      "Succeeded"
                    ]
                  },
                  "runtimeConfiguration": {
                    "contentTransfer": {
                      "transferMode": "Chunked"
                    }
                  }
                },
                "Apply_to_each": {
                  "type": "Foreach",
                  "foreach": "@body('Select')",
                  "actions": {
                    "ComposeDeviceID": {
                      "type": "Compose",
                      "inputs": "@items('Apply_to_each')?['Device ID']"
                    },
                    "ComposeDeviceName": {
                      "type": "Compose",
                      "inputs": "@items('Apply_to_each')?['Device Name']",
                      "runAfter": {
                        "ComposeDeviceID": [
                          "Succeeded"
                        ]
                      }
                    },
                    "ComposeSerialNumber": {
                      "type": "Compose",
                      "inputs": "@items('Apply_to_each')?['Serial Number']",
                      "runAfter": {
                        "ComposeDeviceName": [
                          "Succeeded"
                        ]
                      }
                    },
                    "HTTP": {
                      "type": "Http",
                      "inputs": {
                        "uri": "https://zebrams001.eu.suremdm.io/api/dynamicjob",
                        "method": "POST",
                        "headers": {
                          "ApiKey": "@{outputs('Get_secret')?['body/value']}",
                          "Content-Type": "application/json"
                        },
                        "body": {
                          "DeviceID": "@{outputs('ComposeDeviceID')}",
                          "JobType": "Set_Devicename",
                          "PayLoad": "@{outputs('ComposeSerialNumber')}-R"
                        },
                        "authentication": {
                          "type": "Basic",
                          "username": "@{outputs('Get_secret_UID')?['body/value']}",
                          "password": "@{outputs('Get_secret_PSWD')?['body/value']}"
                        }
                      },
                      "runAfter": {
                        "ComposeSerialNumber": [
                          "Succeeded"
                        ]
                      },
                      "metadata": {
                        "operationMetadataId": "c4a0f7d2-3c92-431c-b147-7397b27532f7"
                      }
                    }
                  },
                  "runAfter": {
                    "Create_file": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "Compose": [
                  "Succeeded"
                ]
              }
            },
            "Get_secret": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "secretName": "rmg-prod42g-key"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_keyvault",
