        "Error_Handling": {
          "type": "Scope",
          "actions": {
            "Post_message_in_a_chat_or_channel": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "poster": "Flow bot",
                  "location": "Channel",
                  "body/recipient/groupId": "02deece1-19d7-41b6-b50c-75e3cd5178ea",
                  "body/recipient/channelId": "19:b32c3b1c47a04ebf909717aa6eb147bc@thread.tacv2",
                  "body/messageBody": "<p class=\"editor-paragraph\">&lt;div style=\"border: 1px solid #e0e0e0; border-radius: 5px; overflow: hidden; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\"&gt;<br>&lt;div style=\"background-color: #d83b01; color: white; padding: 10px; font-weight: bold; font-size: 16px;\"&gt;<br>🚨 FAILED: @{workflow()?['tags']['flowDisplayName']}<br>&lt;/div&gt;<br>&lt;div style=\"padding: 15px; background-color: #f9f9f9;\"&gt;<br>&lt;table style=\"width: 100%; border-collapse: collapse;\"&gt;<br>&lt;tbody&gt;<br>&lt;tr&gt;<br>&lt;td style=\"padding: 5px 0; color: #666; width: 30%;\"&gt;&lt;strong&gt;Flow Name:&lt;/strong&gt;&lt;/td&gt;<br>&lt;td style=\"padding: 5px 0;\"&gt;@{workflow()?['tags']['flowDisplayName']}&lt;/td&gt;<br>&lt;/tr&gt;<br>&lt;tr&gt;<br>&lt;td style=\"padding: 5px 0; color: #666;\"&gt;&lt;strong&gt;Failed Action:&lt;/strong&gt;&lt;/td&gt;<br>&lt;td style=\"padding: 5px 0;\"&gt;@{body('Filter_array')?[0]?['name']}&lt;/td&gt;<br>&lt;/tr&gt;<br>&lt;tr&gt;<br>&lt;td style=\"padding: 5px 0; color: #d83b01;\"&gt;&lt;strong&gt;Error Message:&lt;/strong&gt;&lt;/td&gt;<br>&lt;td style=\"padding: 5px 0; color: #d83b01;\"&gt;&lt;b&gt;&lt;u&gt;&lt;/u&gt;&lt;/b&gt;&lt;/td&gt;<br>&lt;/tr&gt;<br>&lt;tr&gt;<br>&lt;td style=\"padding: 5px 0; color: #666;\"&gt;&lt;strong&gt;Run ID:&lt;/strong&gt;&lt;/td&gt;<br>&lt;td style=\"padding: 5px 0; font-family: monospace; font-size: 12px;\"&gt;@{workflow()?['run']?['name']}&lt;/td&gt;<br>&lt;/tr&gt;<br>&lt;/tbody&gt;<br>&lt;/table&gt;<br>&lt;br&gt;<br>&lt;a href=\"@{concat('https://make.powerautomate.com/environments/', workflow()?['tags']?['environmentName'], '/flows/', workflow()?['name'], '/runs/', workflow()?['run']?['name'])}\" style=\"background-color: #0078d4; color: white; padding: 8px 16px; text-decoration: none; border-radius: 4px; display: inline-block;\"&gt;<br>View Failed Run<br>&lt;/a&gt;<br>&lt;/div&gt;<br>&lt;/div&gt;</p>"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams",
                  "operationId": "PostMessageToConversation",
                  "connectionName": "shared_teams"
                }
              },
              "runAfter": {
                "ERROR_MESSAGE": [
                  "SUCCEEDED"
                ]
              }
            },
            "Filter_array": {
              "type": "Query",
              "inputs": {
                "from": "@result('Scope')",
                "where": "@equals(item()?['status'],'Failed')"
              }
            },
            "ERROR_MESSAGE": {
              "type": "Compose",
              "inputs": "@coalesce(\n    first(body('Filter_Array'))?['body']?['error']?['message'],\n    first(body('Filter_Array'))?['outputs']?['body']?['error']?['message'],\n    first(body('Filter_Array'))?['error']?['message'],\n    'Unknown Error')",
              "runAfter": {
                "Filter_array": [
                  "SUCCEEDED"
                ]
              }
            }
          },
          "runAfter": {
            "Scope": [
              "TimedOut",
              "Skipped",
              "Failed"
            ]
          }
        }
      }
    },
    "templateName": null
