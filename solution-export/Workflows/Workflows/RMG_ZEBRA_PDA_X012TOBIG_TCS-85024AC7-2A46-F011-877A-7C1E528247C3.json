{
  "properties": {
    "connectionReferences": {
      "shared_powerbi": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "dms_sharedpowerbi_50189"
        },
        "api": {
          "name": "shared_powerbi"
        }
      },
      "shared_sharepointonline": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "dms_sharedsharepointonline_4deeb"
        },
        "api": {
          "name": "shared_sharepointonline"
        }
      },
      "shared_sftpwithssh-1": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "new_sharedsftpwithssh_e6bdc"
        },
        "api": {
          "name": "shared_sftpwithssh"
        }
      },
      "shared_sharepointonline-1": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "cr4bb_b6599cff35a24544bcf663b98e2da320"
        },
        "api": {
          "name": "shared_sharepointonline"
        }
      },
      "shared_office365": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "new_sharedoffice365_bd676"
        },
        "api": {
          "name": "shared_office365"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "undefined",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        }
      },
      "triggers": {
        "Recurrence": {
          "recurrence": {
            "interval": 1,
            "frequency": "Day",
            "timeZone": "Central Europe Standard Time",
            "startTime": "2025-03-16T09:00:00Z",
            "schedule": {
              "hours": [
                "9"
              ]
            }
          },
          "type": "Recurrence"
        }
      },
      "actions": {
        "MinRows": {
          "runAfter": {},
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "MinRows",
                "type": "integer",
                "value": 1
              }
            ]
          }
        },
        "IncrRows": {
          "runAfter": {
            "MinRows": [
              "Succeeded"
            ]
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "incrRows",
                "type": "integer",
                "value": 5000
              }
            ]
          }
        },
        "Calculate_Loops": {
          "runAfter": {
            "IncrRows": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "groupid": "ed7233e2-1daf-4288-a3fd-d4943f0b8f89",
              "datasetid": "b6a56604-7b3d-487e-9038-96e00e480413",
              "specification/query": "EVALUATE\nROW(\n    \"loopsNeeded\", ROUNDUP(\n        CALCULATE(DISTINCTCOUNT('RMGX012_TBW'[Index]))/@{variables('incrRows')}, 1) + 1\n    )",
              "specification/serializerSettings/includeNulls": false
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_powerbi",
              "connectionName": "shared_powerbi",
              "operationId": "ExecuteDatasetQuery"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Loops2run": {
          "runAfter": {
            "Calculate_Loops": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@outputs('Calculate_Loops')?['body/firstTableRows']?[0]?['[loopsNeeded]']"
        },
        "LoopsVar": {
          "runAfter": {
            "appendCSV": [
              "Succeeded"
            ]
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "LoopsVar",
                "type": "integer",
                "value": 1
              }
            ]
          }
        },
        "Do_until": {
          "actions": {
            "Run_a_query_against_a_dataset": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "groupid": "ed7233e2-1daf-4288-a3fd-d4943f0b8f89",
                  "datasetid": "b6a56604-7b3d-487e-9038-96e00e480413",
                  "specification/query": "DEFINE\n    VAR __DS0FilterTable = FILTER(KEEPFILTERS(VALUES('RMGX012_TBW'[Index])), AND('RMGX012_TBW'[Index] >= @{variables('MinRows')}, 'RMGX012_TBW'[Index] <= @{variables('incrRows')}))\nVAR __DS0Core = \n        CALCULATETABLE(\n            SELECTCOLUMNS(\n                'RMGX012_TBW',\n                \"RMGX012_TBW[Stock]\", 'RMGX012_TBW'[Stock],\n                \"RMGX012_TBW[Serial No.]\", 'RMGX012_TBW'[Serial No.],\n                \"RMGX012_TBW[Asset No.]\", 'RMGX012_TBW'[Asset No.],\n                \"RMGX012_TBW[Address]\", 'RMGX012_TBW'[Address],\n                \"RMGX012_TBW[Post Code]\", 'RMGX012_TBW'[Post Code],\n                \"RMGX012_TBW[DOBI]\", 'RMGX012_TBW'[DOBI],\n                \"RMGX012_TBW[Tel No.]\", COALESCE('RMGX012_TBW'[Tel No.], \"\"),\n                \"RMGX012_TBW[SIM No.]\", COALESCE('RMGX012_TBW'[SIM No.], \"\"),\n                \"RMGX012_TBW[Contract ID]\", 'RMGX012_TBW'[Contract ID],\n                \"RMGX012_TBW[Additional Information 5]\", 'RMGX012_TBW'[Additional Information 5],\n                \"RMGX012_TBW[Last Shipped Date]\", 'RMGX012_TBW'[Last Shipped Date],\n                \"RMGX012_TBW[Operational Status]\", 'RMGX012_TBW'[Operational Status],\n                \"RMGX012_TBW[Name]\", 'RMGX012_TBW'[Name],\n                \"RMGX012_TBW[Build Profile]\", \n                    VAR JoinCol = 'RMGX012_TBW'[Serial No.]\n                    VAR NewCol = IF(ISBLANK('RMGX012_TBW'[Serial No.]), \"\", CALCULATE(MAX('Device Info X012'[SW-Build]), 'Device Info X012'[Serial Number] = JoinCol))\n                    RETURN NewCol,\n                \"RMGX012_TBW[Client Version]\", COALESCE('RMGX012_TBW'[Client Version], \"\"),\n                \"RMGX012_TBW[Build Date]\", \n                    VAR JoinCol = 'RMGX012_TBW'[Serial No.]\n                    VAR NewCol = IF(ISBLANK('RMGX012_TBW'[Serial No.]), BLANK(), CALCULATE(MAX('Device Info X012'[MSPI]), 'Device Info X012'[Serial Number] = JoinCol))\n                    RETURN NewCol,\n                \"RMGX012_TBW[OS Build Number]\", COALESCE('RMGX012_TBW'[OS Build Number], \"\"),\n                \"RMGX012_TBW[Status]\", 'RMGX012_TBW'[Status],\n                \"RMGX012_TBW[IMEI]\", COALESCE('RMGX012_TBW'[IMEI], \"\")\n            ),\n            __DS0FilterTable\n        )\nEVALUATE\n    __DS0Core\nORDER BY\n    'RMGX012_TBW'[Serial No.]",
                  "specification/serializerSettings/includeNulls": false
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_powerbi",
                  "connectionName": "shared_powerbi",
                  "operationId": "ExecuteDatasetQuery"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Create_CSV_table": {
              "runAfter": {
                "Select": [
                  "Succeeded"
                ]
              },
              "type": "Table",
              "inputs": {
                "from": "@body('Select')",
                "format": "CSV"
              }
            },
            "IncrMinRows": {
              "runAfter": {
                "Create_CSV_table": [
                  "Succeeded"
                ]
              },
              "type": "IncrementVariable",
              "inputs": {
                "name": "MinRows",
                "value": 5000
              }
            },
            "IncrRows2": {
              "runAfter": {
                "IncrMinRows": [
                  "Succeeded"
                ]
              },
              "type": "IncrementVariable",
              "inputs": {
                "name": "incrRows",
                "value": 5000
              }
            },
            "IncrLoops": {
              "runAfter": {
                "IncrRows2": [
                  "Succeeded"
                ]
              },
              "type": "IncrementVariable",
              "inputs": {
                "name": "LoopsVar",
                "value": 1
              }
            },
            "Append_to_string_variable": {
              "runAfter": {
                "IncrLoops": [
                  "Succeeded"
                ]
              },
              "type": "AppendToStringVariable",
              "inputs": {
                "name": "appendCSV",
                "value": "@if(equals(variables('LoopsVar'), 2), body('Create_CSV_Table'), join(skip(split(body('Create_CSV_Table'), decodeUriComponent('%0A')),1), decodeUriComponent('%0A')))"
              }
            },
            "Select": {
              "runAfter": {
                "Run_a_query_against_a_dataset": [
                  "Succeeded"
                ]
              },
              "type": "Select",
              "inputs": {
                "from": "@outputs('Run_a_query_against_a_dataset')?['body/firstTableRows']",
                "select": {
                  "Stock": "@item()?['RMGX012_TBW[Stock]']",
                  "Serial No.": "@item()?['RMGX012_TBW[Serial No.]']",
                  "Asset No.": "@item()?['RMGX012_TBW[Asset No.]']",
                  "IMEI": "@item()?['RMGX012_TBW[IMEI]']",
                  "Status": "@item()?['RMGX012_TBW[Status]']",
                  "Address": "@item()?['RMGX012_TBW[Address]']",
                  "Post Code": "@item()?['RMGX012_TBW[Post Code]']",
                  "DOBI": "@item()?['RMGX012_TBW[DOBI]']",
                  "Tel No.": "@item()?['RMGX012_TBW[Tel No.]']",
                  "SIM No.": "@item()?['RMGX012_TBW[SIM No.]']",
                  "Contract ID": "@item()?['RMGX012_TBW[Contract ID]']",
                  "Additional Information 5": "@item()?['RMGX012_TBW[Additional Information 5]']",
                  "Last Shipped Date": "@item()?['RMGX012_TBW[Last Shipped Date]']",
                  "Operational Status": "@item()?['RMGX012_TBW[Operational Status]']",
                  "Name": "@item()?['RMGX012_TBW[Name]']",
                  "Build Profile": "@item()?['RMGX012_TBW[Build Profile]']",
                  "Client Version": "@item()?['RMGX012_TBW[Client Version]']",
                  "Build Date": "@item()?['RMGX012_TBW[Build Date]']",
                  "OS Build Number": "@item()?['RMGX012_TBW[OS Build Number]']"
                }
              }
            }
          },
          "runAfter": {
            "LoopsVar": [
              "Succeeded"
            ]
          },
          "expression": "@greaterOrEquals(variables('LoopsVar'),outputs('Loops2run'))",
          "limit": {
            "count": 60,
            "timeout": "PT1H"
          },
          "type": "Until"
        },
        "appendCSV": {
          "runAfter": {
            "Loops2run": [
              "Succeeded"
            ]
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "appendCSV",
                "type": "string"
              }
            ]
          }
        },
        "Create_file": {
          "runAfter": {
            "convert2csv": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "dataset": "https://zebra.sharepoint.com/sites/DMSBAExternal",
              "folderPath": "/Shared Documents/RMG/RMG SNOW/ARCHIVE/@{formatDateTime(utcNow(), 'yyyy')}/@{formatDateTime(utcNow(), 'MMMM')}/",
              "name": "RMG_ZEBRA_PDA_@{concat(formatDateTime(utcNow(), 'yyyy-MM-ddTHH-mm-ss'), '.csv')}",
              "body": "@outputs('convert2csv')"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "CreateFile"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runtimeConfiguration": {
            "contentTransfer": {
              "transferMode": "Chunked"
            }
          }
        },
        "convert2csv": {
          "runAfter": {
            "Do_until": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@variables('appendCSV')"
        },
        "RMG_CMDB_csv_on_SFTP": {
          "runAfter": {
            "Update_file_RMG_ZEBRA_PDA": [
              "Succeeded"
            ]
          },
          "metadata": {
            "L3NlcnZpY2Vub3cvaW5jb21pbmc=": "/servicenow/incoming"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "id": "L3NlcnZpY2Vub3cvaW5jb21pbmc="
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sftpwithssh",
              "connectionName": "shared_sftpwithssh-1",
              "operationId": "ListFolder"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Update_file": {
          "runAfter": {
            "RMG_CMDB_csv_on_SFTP": [
              "Succeeded"
            ]
          },
          "metadata": {
            "L3NlcnZpY2Vub3cvaW5jb21pbmcvUk1HX1pFQlJBX1BEQS5jc3Y=": "/servicenow/incoming/RMG_ZEBRA_PDA.csv"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "id": "L3NlcnZpY2Vub3cvaW5jb21pbmcvUk1HX1pFQlJBX1BEQS5jc3Y=",
              "body": "@outputs('convert2csv')",
              "ReadFileMetadataFromServer": true
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sftpwithssh",
              "connectionName": "shared_sftpwithssh-1",
              "operationId": "UpdateFile"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Update_file_RMG_ZEBRA_PDA": {
          "runAfter": {
            "Create_file": [
              "Succeeded"
            ]
          },
          "metadata": {
            "%252fShared%2bDocuments%252fRMG%252fRMG%2bSNOW%252fRMG_ZEBRA_PDA.csv": "/Shared Documents/RMG/RMG SNOW/RMG_ZEBRA_PDA.csv"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "dataset": "https://zebra.sharepoint.com/sites/DMSBAExternal",
              "id": "%252fShared%2bDocuments%252fRMG%252fRMG%2bSNOW%252fRMG_ZEBRA_PDA.csv",
              "body": "@outputs('convert2csv')"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline-1",
              "operationId": "UpdateFile"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "To_BA_Site_for_Service_Management": {
          "runAfter": {
            "Update_file": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "dataset": "https://zebra.sharepoint.com/sites/WeeklyDashboardData",
              "folderPath": "/Shared Documents/Royal Mail/RMG asset register/Raw Data Archive/TBW_confidential/X012 ARCHIVE/@{formatDateTime(utcNow(), 'yyyy')}/@{formatDateTime(utcNow(), 'MMMM')}",
              "name": "RMG_ZEBRA_PDA_@{concat(formatDateTime(utcNow(), 'yyyy-MM-ddTHH-mm-ss'), '.csv')}",
              "body": "@outputs('convert2csv')"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "CreateFile"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runtimeConfiguration": {
            "contentTransfer": {
              "transferMode": "Chunked"
            }
          }
        },
        "Send_an_email_(V2)": {
          "runAfter": {
            "To_BA_Site_for_Service_Management": [
              "Failed"
            ],
            "Update_file": [
              "Failed"
            ],
            "RMG_CMDB_csv_on_SFTP": [
              "Failed"
            ],
            "Update_file_RMG_ZEBRA_PDA": [
              "Failed"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "emailMessage/To": "premier.analytics@zebra.com;PQMN34@zebra.com",
              "emailMessage/Subject": "RMG: X012 to RMG is FAILED",
              "emailMessage/Body": "<p class=\"editor-paragraph\">Greetings,</p><br><p class=\"editor-paragraph\">RMG: X012 to RMG is <u><b><strong class=\"editor-text-bold editor-text-underline\" style=\"color: rgb(208, 2, 27);\">FAILED.</strong></b></u></p><br><p class=\"editor-paragraph\">Regards</p><br><p class=\"editor-paragraph\">Strategic Innovation and Automation</p>",
              "emailMessage/From": "StrategicInnovationandAutomation@Zebra.com",
              "emailMessage/Importance": "High"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
              "connectionName": "shared_office365",
              "operationId": "SendEmailV2"
            },
            "authentication": "@parameters('$authentication')"
          }
        }
      }
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}