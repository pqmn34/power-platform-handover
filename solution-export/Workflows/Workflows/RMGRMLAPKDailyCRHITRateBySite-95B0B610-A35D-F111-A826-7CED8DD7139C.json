{
  "properties": {
    "connectionReferences": {
      "shared_powerbi": {
        "api": {
          "name": "shared_powerbi"
        },
        "connection": {
          "connectionReferenceLogicalName": "dms_sharedpowerbi_50189"
        },
        "runtimeSource": "embedded"
      },
      "shared_sharepointonline": {
        "api": {
          "name": "shared_sharepointonline"
        },
        "connection": {
          "connectionReferenceLogicalName": "dms_sharedsharepointonline_4deeb"
        },
        "runtimeSource": "embedded"
      },
      "shared_teams": {
        "api": {
          "name": "shared_teams"
        },
        "connection": {
          "connectionReferenceLogicalName": "new_sharedteams_e6afa"
        },
        "runtimeSource": "embedded"
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "undefined",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        }
      },
      "triggers": {
        "Recurrence": {
          "type": "Recurrence",
          "recurrence": {
            "interval": 1,
            "frequency": "Week",
            "timeZone": "UTC",
            "schedule": {
              "weekDays": [
                "Monday",
                "Tuesday",
                "Wednesday",
                "Thursday",
                "Friday",
                "Saturday",
                "Sunday"
              ],
              "hours": [
                "7"
              ],
              "minutes": [
                45
              ]
            }
          }
        }
      },
      "actions": {
        "Scope": {
          "type": "Scope",
          "actions": {
            "RMG_RML_APK_Daily_CR_HIT_Rate_By_Site": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "groupid": "ed7233e2-1daf-4288-a3fd-d4943f0b8f89",
                  "datasetid": "b6a56604-7b3d-487e-9038-96e00e480413",
                  "specification/query": "DEFINE\n\tVAR __DS0Core = \n\t\tSUMMARIZECOLUMNS(\n\t\t\tROLLUPADDISSUBTOTAL(\n\t\t\t\tROLLUPGROUP(\n\t\t\t\t\t'RML Release Table TC57X'[RML Site Name | Code],\n\t\t\t\t\t'RML Release Table TC57X'[Prerequisites FT Type]\n\t\t\t\t), \"IsGrandTotalRowTotal\"\n\t\t\t),\n\t\t\t\"Total_RML_Active_Devices_TC57X\", 'RML Release Table TC57X'[Total RML Active Devices TC57X],\n\t\t\t\"RML_APK_Pending_Due_to_Offline_TC57X\", 'RML Release Table TC57X'[RML APK Pending Due to Offline TC57X],\n\t\t\t\"RML_APK_Pending_NOT_on_WiFi_TC57X\", 'RML Release Table TC57X'[RML APK Pending NOT on WiFi TC57X],\n\t\t\t\"RML_APK_FT_Completed_TC57X\", 'RML Release Table TC57X'[RML APK FT Completed TC57X],\n\t\t\t\"v__RML_APK_Offline_TC57X\", 'RML Release Table TC57X'[% RML APK Offline TC57X],\n\t\t\t\"v__RML_APK_NOT_on_Wifi_TC57X\", 'RML Release Table TC57X'[% RML APK NOT on Wifi TC57X],\n\t\t\t\"v__RML_APK_FT_Completed_TC57X\", 'RML Release Table TC57X'[% RML APK FT Completed TC57X],\n\t\t\t\"RML_APK_Upgraded_TC57X\", 'RML Release Table TC57X'[RML APK Upgraded TC57X],\n\t\t\t\"RML_APK_Pending_TC57X\", 'RML Release Table TC57X'[RML APK Pending TC57X],\n\t\t\t\"v__RML_APK_Upgraded_TC57X\", 'RML Release Table TC57X'[% RML APK Upgraded TC57X],\n\t\t\t\"v__RML_APK_Pending_TC57X\", 'RML Release Table TC57X'[% RML APK Pending TC57X]\n\t\t)\n\nEVALUATE\n\t__DS0Core\n\nORDER BY\n\t[IsGrandTotalRowTotal] DESC,\n\t'RML Release Table TC57X'[RML Site Name | Code],\n\t'RML Release Table TC57X'[Prerequisites FT Type]",
                  "specification/serializerSettings/includeNulls": false
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_powerbi",
                  "operationId": "ExecuteDatasetQuery",
                  "connectionName": "shared_powerbi"
                }
              }
            },
            "Filter_array": {
              "type": "Query",
              "inputs": {
                "from": "@outputs('RMG_RML_APK_Daily_CR_HIT_Rate_By_Site')?['body/firstTableRows']",
                "where": "@equals(item()?['[IsGrandTotalRowTotal]'],false)"
              },
              "runAfter": {
                "RMG_RML_APK_Daily_CR_HIT_Rate_By_Site": [
                  "Succeeded"
                ]
              }
            },
            "Select": {
              "type": "Select",
              "inputs": {
                "from": "@body('Filter_array')",
                "select": {
                  "Site Name": "@item()?['RML Release Table TC57X[RML Site Name | Code]']",
                  "Total Active Devices": "@item()?['[Total_RML_Active_Devices_TC57X]']",
                  "Offline": "@item()?['[RML_APK_Pending_Due_to_Offline_TC57X]']",
                  "Not on WiFi": "@item()?['[RML_APK_Pending_NOT_on_WiFi_TC57X]']",
                  "FT Completed": "@item()?['[RML_APK_FT_Completed_TC57X]']",
                  "Offline %": "@formatNumber(coalesce(item()?['[v__RML_APK_Offline_TC57X]'], 0), '0.0%')",
                  "Not on WiFi %": "@formatNumber(coalesce(item()?['[v__RML_APK_NOT_on_Wifi_TC57X]'], 0), '0.0%')",
                  "FT Completed %": "@formatNumber(coalesce(item()?['[v__RML_APK_FT_Completed_TC57X]'], 0), '0.0%')",
                  "Upgraded": "@item()?['[RML_APK_Upgraded_TC57X]']",
                  "Pending": "@item()?['[RML_APK_Pending_TC57X]']",
                  "Upgraded %": "@formatNumber(coalesce(item()?['[v__RML_APK_Upgraded_TC57X]'], 0), '0.0%')",
                  "Pending %": "@formatNumber(coalesce(item()?['[v__RML_APK_Pending_TC57X]'], 0), '0.0%')"
                }
              },
              "runAfter": {
                "Filter_array": [
                  "Succeeded"
                ]
              }
            },
            "Create_CSV_table": {
              "type": "Table",
              "inputs": {
                "from": "@body('Select')",
                "format": "CSV"
              },
              "runAfter": {
                "Select": [
                  "Succeeded"
                ]
              }
            },
            "Create_file": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "dataset": "https://zebra.sharepoint.com/sites/DMSBAExternal",
                  "folderPath": "/Shared Documents/RMG/CRM/RML/APK/BY_SITE",
                  "name": "rml_apk_@{utcNow()}.csv",
                  "body": "@body('Create_CSV_table')"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "operationId": "CreateFile",
                  "connectionName": "shared_sharepointonline"
                }
              },
              "runAfter": {
                "Create_CSV_table": [
                  "Succeeded"
                ]
              },
              "runtimeConfiguration": {
                "contentTransfer": {
                  "transferMode": "Chunked"
                }
              }
            }
          },
          "runAfter": {}
        },
        "Error_Handling": {
          "type": "Scope",
          "actions": {
            "FilterArray": {
              "type": "Query",
              "inputs": {
                "from": "@result('Scope')",
                "where": "@equals(item()?['status'],'Failed')"
              }
            },
            "COMPOSE-ERROR_MESSAGE": {
              "type": "Compose",
              "inputs": "@coalesce(\r\n    first(body('FilterArray'))?['body']?['error']?['message'],\r\n    first(body('FilterArray'))?['outputs']?['body']?['error']?['message'],\r\n    first(body('FilterArray'))?['error']?['message'],\r\n    'Unknown Error')",
              "runAfter": {
                "FilterArray": [
                  "Succeeded"
                ]
              }
            },
            "Post_message_in_a_chat_or_channel": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "poster": "Flow bot",
                  "location": "Channel",
                  "body/recipient/groupId": "02deece1-19d7-41b6-b50c-75e3cd5178ea",
                  "body/recipient/channelId": "19:b32c3b1c47a04ebf909717aa6eb147bc@thread.tacv2",
                  "body/messageBody": "<div style=\"border: 1px solid #e0e0e0; border-radius: 5px; overflow: hidden; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\">\n<div style=\"background-color: #d83b01; color: white; padding: 10px; font-weight: bold; font-size: 16px;\">\n🚨 FAILED: @{workflow()?['tags']['flowDisplayName']}\n</div>\n<div style=\"padding: 15px; background-color: #f9f9f9;\">\n<table style=\"width: 100%; border-collapse: collapse;\">\n<tbody>\n<tr>\n<td style=\"padding: 5px 0; color: #666; width: 30%;\"><strong>Flow Name:</strong></td>\n<td style=\"padding: 5px 0;\">@{workflow()?['tags']['flowDisplayName']}</td>\n</tr>\n<tr>\n<td style=\"padding: 5px 0; color: #666;\"><strong>Failed Action:</strong></td>\n<td style=\"padding: 5px 0;\">@{body('Filter_array')?[0]?['name']}</td>\n</tr>\n<tr>\n<td style=\"padding: 5px 0; color: #d83b01;\"><strong>Error Message:</strong></td>\n<td style=\"padding: 5px 0; color: #d83b01;\"><b><u>@{outputs('COMPOSE-ERROR_MESSAGE')}</u></b></td>\n</tr>\n<tr>\n<td style=\"padding: 5px 0; color: #666;\"><strong>Run ID:</strong></td>\n<td style=\"padding: 5px 0; font-family: monospace; font-size: 12px;\">@{workflow()?['run']?['name']}</td>\n</tr>\n</tbody>\n</table>\n<br>\n<a href=\"@{concat('https://make.powerautomate.com/environments/', workflow()?['tags']?['environmentName'], '/flows/', workflow()?['name'], '/runs/', workflow()?['run']?['name'])}\" style=\"background-color: #0078d4; color: white; padding: 8px 16px; text-decoration: none; border-radius: 4px; display: inline-block;\">\nView Failed Run\n</a>\n</div>\n</div>"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams",
                  "operationId": "PostMessageToConversation",
                  "connectionName": "shared_teams"
                }
              },
              "runAfter": {
                "COMPOSE-ERROR_MESSAGE": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {
            "Scope": [
              "TimedOut",
              "Skipped",
              "Failed"
            ]
          }
        }
      }
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}