    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "undefined",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        }
      },
      "triggers": {
        "Recurrence": {
          "type": "Recurrence",
          "recurrence": {
            "interval": 1,
            "frequency": "Week",
            "timeZone": "UTC",
            "startTime": "2025-11-27T00:00Z",
            "schedule": {
              "hours": [
                "1"
              ],
              "minutes": [
                30
              ],
              "weekDays": [
                "Tuesday"
              ]
            }
          }
        }
      },
      "actions": {
        "varCSVContent": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "varCSVContent",
                "type": "string"
              }
            ]
          },
          "runAfter": {
            "EmailCC": [
              "Succeeded"
            ]
          }
        },
        "Scope": {
          "type": "Scope",
          "actions": {
            "Run_a_query_against_a_dataset": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "groupid": "ed7233e2-1daf-4288-a3fd-d4943f0b8f89",
                  "datasetid": "3f0a252e-8705-4d80-96bc-e2060c3e501d",
                  "specification/query": "DEFINE\n\tVAR __DS0Core = \n\t\tSUMMARIZE(\n\t\t\t'Weekly Asset Report',\n\t\t\t'Weekly Asset Report'[DevID],\n\t\t\t'Weekly Asset Report'[BusinessArea],\n\t\t\t'Weekly Asset Report'[Application],\n\t\t\t'Weekly Asset Report'[Site],\n\t\t\t'Weekly Asset Report'[HardwareSerialNumber],\n\t\t\t'Weekly Asset Report'[LastConnTime],\n\t\t\t'Weekly Asset Report'[LastDisConnTime],\n\t\t\t'Weekly Asset Report'[DaysOffline],\n\t\t\t'Weekly Asset Report'[Status],\n\t\t\t'Weekly Asset Report'[Model]\n\t\t)\n\t\t\nEVALUATE\n\t__DS0Core\n\nORDER BY\n\t'Weekly Asset Report'[DevID],\n\t'Weekly Asset Report'[BusinessArea],\n\t'Weekly Asset Report'[Application],\n\t'Weekly Asset Report'[Site],\n\t'Weekly Asset Report'[HardwareSerialNumber],\n\t'Weekly Asset Report'[LastConnTime],\n\t'Weekly Asset Report'[LastDisConnTime],\n\t'Weekly Asset Report'[DaysOffline],\n\t'Weekly Asset Report'[Status],\n\t'Weekly Asset Report'[Model]",
                  "specification/serializerSettings/includeNulls": false
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_powerbi",
                  "operationId": "ExecuteDatasetQuery",
                  "connectionName": "shared_powerbi-1"
                }
              }
            },
            "Select": {
              "type": "Select",
              "inputs": {
                "from": "@outputs('Run_a_query_against_a_dataset')?['body/firstTableRows']",
                "select": {
                  "DevID": "@concat('''', item()?['Weekly Asset Report[DevID]'])",
                  "BusinessArea": "@item()?['Weekly Asset Report[BusinessArea]']",
                  "Application": "@item()?['Weekly Asset Report[Application]']",
                  "Site": "@item()?['Weekly Asset Report[Site]']",
                  "HardwareSerialNumber": "@concat('''', item()?['Weekly Asset Report[HardwareSerialNumber]'])",
                  "LastConnTime": "@if(empty(item()?['Weekly Asset Report[LastConnTime]']), '', formatDateTime(item()?['Weekly Asset Report[LastConnTime]'], 'yyyy-MM-dd HH:mm:ss'))",
                  "LastDisConnTime": "@if(empty(item()?['Weekly Asset Report[LastDisConnTime]']), '', formatDateTime(item()?['Weekly Asset Report[LastDisConnTime]'], 'yyyy-MM-dd HH:mm:ss'))",
                  "DaysOffline": "@formatNumber(coalesce(item()?['Weekly Asset Report[DaysOffline]'], 0), '0.00')",
                  "Status": "@item()?['Weekly Asset Report[Status]']",
                  "Model": "@item()?['Weekly Asset Report[Model]']"
                }
              },
              "runAfter": {
                "Run_a_query_against_a_dataset": [
                  "Succeeded"
                ]
              }
            },
            "Condition": {
              "type": "If",
              "expression": {
                "and": [
                  {
                    "greater": [
                      "@length(body('Select'))",
                      0
                    ]
                  }
                ]
              },
              "actions": {
                "Create_CSV_table": {
                  "type": "Table",
                  "inputs": {
                    "from": "@body('Select')",
                    "format": "CSV"
                  }
                },
                "Set_variable": {
                  "type": "SetVariable",
                  "inputs": {
                    "name": "varCSVContent",
                    "value": "@body('Create_CSV_table')"
                  },
                  "runAfter": {
                    "Create_CSV_table": [
                      "Succeeded"
                    ]
                  }
                },
                "Create_HTML_table": {
                  "type": "Table",
                  "inputs": {
                    "from": "@body('Select')",
                    "format": "HTML"
                  },
                  "runAfter": {
                    "Set_variable": [
                      "Succeeded"
                    ]
                  }
                },
                "Compose": {
                  "type": "Compose",
                  "inputs": "<style>\n    table {\n        width:100%;\n        height:100%;\n        border:1px solid #b3adad;\n        border-collapse:collapse;\n    }\n    table th {\n        border:1px solid #b3adad;\n        background: #FFCC00; /* Changed to red */\n        color: #d40511;\n    }\n    table td {\n        border:1px solid #b3adad;\n        text-align:center;\n        background: #ffffff;\n        color: #313030;\n    }\n</style>\n@{body('Create_HTML_table')}",
                  "runAfter": {
                    "Create_HTML_table": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "else": {
                "actions": {
                  "Set_variable_1": {
                    "type": "SetVariable",
                    "inputs": {
                      "name": "varCSVContent",
                      "value": "DevID,\tBusinessArea,\tApplication,\tSite,\tHardwareSerialNumber,\tLastConnTime,\tLastDisConnTime,\tDaysOffline,\tStatus,\tModel\n"
                    }
                  }
                }
              },
              "runAfter": {
                "Select": [
                  "Succeeded"
                ]
              }
            },
            "Create_file": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "dataset": "https://zebra.sharepoint.com/sites/DMSBAExternal",
                  "folderPath": "/Shared Documents/DHLPARCEL/SSIS_WEEKLYASSETREPORT/@{formatDateTime(utcNow(),'yyyy')}/@{formatDateTime(utcNow(),'MMMM')}",
                  "name": "DHL_Weekly_Asset_Report_@{formatDateTime(utcNow(), 'yyyy-MM-dd')}.csv",
                  "body": "@variables('varCSVContent')"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "operationId": "CreateFile",
                  "connectionName": "shared_sharepointonline"
                }
              },
              "runAfter": {
                "Condition": [
                  "Succeeded"
                ]
              },
              "runtimeConfiguration": {
                "contentTransfer": {
                  "transferMode": "Chunked"
                }
              }
            },
            "Send_an_email_(V2)": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "emailMessage/To": "@outputs('EmailTO')",
                  "emailMessage/Subject": "EVRI Premium: Weekly Asset Report - @{formatDateTime(utcNow(),'ddMMyyyy')}",
                  "emailMessage/Body": "<p class=\"editor-paragraph\">Dear Team,</p><br><p class=\"editor-paragraph\">Please find attached the weekly asset report.</p><p class=\"editor-paragraph\"><br>Important: This is an automated notification sent from an unmonitored mailbox. Please do not reply to this email.</p><p class=\"editor-paragraph\"><br>For any questions regarding the report data, please reach out to the Premier Analytics team at <b><strong class=\"editor-text-bold\">premier.analytics@zebra.com</strong></b>.<br><br>Regards,<br>Strategic Innovation and Automation<br><br><br><span style=\"color: rgb(208, 2, 27);\">- CONFIDENTIAL-</span><br><br>This email and any files transmitted with it are confidential and may also be legally privileged. If you are not the intended recipient, you may not review, use, copy, or distribute this message. If you receive this email in error, please notify the sender immediately by reply email and then delete this email.</p>",
                  "emailMessage/From": "strategicinnovationandautomation@zebra.com",
                  "emailMessage/Cc": "@trim(outputs('EmailCC'))",
                  "emailMessage/Attachments": [
                    {
                      "Name": "EVRIPremium_Weekly_Asset_Report_@{formatDateTime(utcNow(), 'yyyy-MM-dd')}.csv",
                      "ContentBytes": "@variables('varCSVContent')"
                    }
                  ],
                  "emailMessage/Importance": "Normal"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                  "operationId": "SendEmailV2",
                  "connectionName": "shared_office365"
                }
              },
              "runAfter": {
                "Create_file": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {
            "varCSVContent": [
              "Succeeded"
            ]
          }
        },
        "Error_Handling": {
          "type": "Scope",
          "actions": {
            "Post_message_in_a_chat_or_channel": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "poster": "Flow bot",
                  "location": "Channel",
                  "body/recipient/groupId": "02deece1-19d7-41b6-b50c-75e3cd5178ea",
                  "body/recipient/channelId": "19:b32c3b1c47a04ebf909717aa6eb147bc@thread.tacv2",
                  "body/messageBody": "<p class=\"editor-paragraph\">🚨 <b><strong class=\"editor-text-bold\" style=\"color: rgb(208, 2, 27);\">FLOW FAILED ALERT</strong></b>: DHL SSIS-Weekly Asset Report 🚨<br><br>Flow Name: @{workflow()?['tags']['flowDisplayName']}<br>Run ID: @{workflow()?['run']['name']}<br>Link to Run: @{concat('https://make.powerautomate.com/environments/', workflow()?['name'], '/flows/', workflow()?['tags']['logicAppName'], '/runs/', workflow()?['run']['name'])}</p>"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams",
                  "operationId": "PostMessageToConversation",
                  "connectionName": "shared_teams"
                }
              }
            },
            "FAILED_Send_an_email_(V2)": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "emailMessage/To": "PQMN34@zebra.com",
                  "emailMessage/Subject": "🚨 FLOW FAILED ALERT: DHL SSIS-Weekly Asset Report 🚨",
                  "emailMessage/Body": "<p class=\"editor-paragraph\">🚨 FLOW FAILED ALERT: DHL SSIS-Weekly Asset Report 🚨<br><br><br>Flow Name: @{workflow()?['tags']['flowDisplayName']}<br>Run ID: @{workflow()?['run']['name']}<br>Link to Run: @{concat('https://make.powerautomate.com/environments/', workflow()?['name'], '/flows/', workflow()?['tags']['logicAppName'], '/runs/', workflow()?['run']['name'])}</p>",
                  "emailMessage/From": "strategicinnovationandautomation@zebra.com",
                  "emailMessage/Importance": "High"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                  "operationId": "SendEmailV2",
                  "connectionName": "shared_office365"
                }
              },
              "runAfter": {
                "Post_message_in_a_chat_or_channel": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {
            "Scope": [
              "Skipped",
              "TimedOut",
              "Failed"
            ]
          }
        },
        "EmailTO": {
          "type": "Compose",
          "inputs": " stephanie.keats@dhlevripremium.com;sam.turki@evri.com;Paul.Tate@Evri.com;",
          "runAfter": {}
        },
        "EmailCC": {
          "type": "Compose",
          "inputs": "Jakub.Polak@zebra.com;GMSSBA@zebra.com;james.currey@zebra.com;GLOBALDMSLEVEL2@zebra.com;DMSDeliveryLeads@zebra.com;ManagedAndIntegrationServices@zebra.com;MS_CRM@zebra.com",
          "runAfter": {
            "EmailTO": [
              "Succeeded"
            ]
          }
        }
      }
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}