        "Scope": {
          "type": "Scope",
          "actions": {
            "OfflineGT60Days": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "groupid": "ed7233e2-1daf-4288-a3fd-d4943f0b8f89",
                  "datasetid": "3f0a252e-8705-4d80-96bc-e2060c3e501d",
                  "specification/query": "// DAX Query\nDEFINE\n\tVAR __DS0Core = \n\t\tSUMMARIZE(\n\t\t\t'LostDevicesGT60DaysDeletion',\n\t\t\t'LostDevicesGT60DaysDeletion'[DeviceID],\n\t\t\t'LostDevicesGT60DaysDeletion'[DeviceName],\n\t\t\t'LostDevicesGT60DaysDeletion'[DeviceOffline>60Days],\n\t\t\t'LostDevicesGT60DaysDeletion'[HardwareSerialNumber],\n\t\t\t'LostDevicesGT60DaysDeletion'[ICCID],\n\t\t\t'LostDevicesGT60DaysDeletion'[Model],\n\t\t\t'LostDevicesGT60DaysDeletion'[OfflineDays],\n\t\t\t'LostDevicesGT60DaysDeletion'[Path],\n\t\t\t'LostDevicesGT60DaysDeletion'[EnrollmentTime],\n\t\t\t'LostDevicesGT60DaysDeletion'[LastSeen]\n\t\t)\n\nEVALUATE\n\t__DS0Core\n\nORDER BY\n\t'LostDevicesGT60DaysDeletion'[DeviceID],\n\t'LostDevicesGT60DaysDeletion'[DeviceName],\n\t'LostDevicesGT60DaysDeletion'[DeviceOffline>60Days],\n\t'LostDevicesGT60DaysDeletion'[HardwareSerialNumber],\n\t'LostDevicesGT60DaysDeletion'[ICCID],\n\t'LostDevicesGT60DaysDeletion'[Model],\n\t'LostDevicesGT60DaysDeletion'[OfflineDays],\n\t'LostDevicesGT60DaysDeletion'[Path],\n\t'LostDevicesGT60DaysDeletion'[EnrollmentTime],\n\t'LostDevicesGT60DaysDeletion'[LastSeen]\n",
                  "specification/serializerSettings/includeNulls": false
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_powerbi",
                  "operationId": "ExecuteDatasetQuery",
                  "connectionName": "shared_powerbi-2"
                }
              }
            },
            "SelectGT60Days": {
              "type": "Select",
              "inputs": {
                "from": "@outputs('OfflineGT60Days')?['body/firstTableRows']",
                "select": {
                  "DeviceName": "@{item()?['LostDevicesGT60DaysDeletion[DeviceName]']}",
                  "HardwareSerialNumber": "@{item()?['LostDevicesGT60DaysDeletion[HardwareSerialNumber]']}",
                  "Model": "@{item()?['LostDevicesGT60DaysDeletion[Model]']}",
                  "Offline MoreThan 60 Days": "@{item()?['LostDevicesGT60DaysDeletion[DeviceOffline>60Days]']}",
                  "EnrollmentTime": "@{if(empty(item()?['LostDevicesGT60DaysDeletion[EnrollmentTime]']), '', formatDateTime(item()?['LostDevicesGT60DaysDeletion[EnrollmentTime]'], 'dd/MM/yyyy'))}",
                  "LastSeen": "@{if(empty(item()?['LostDevicesGT60DaysDeletion[LastSeen]']), '', formatDateTime(item()?['LostDevicesGT60DaysDeletion[LastSeen]'], 'dd/MM/yyyy'))}",
                  "OfflineDays": "@{item()?['LostDevicesGT60DaysDeletion[OfflineDays]']}",
                  "ICCID": "@{item()?['LostDevicesGT60DaysDeletion[ICCID]']}",
                  "Path": "@{item()?['LostDevicesGT60DaysDeletion[Path]']}",
                  "DeviceID": "@{item()?['LostDevicesGT60DaysDeletion[DeviceID]']}"
                }
              },
              "runAfter": {
                "OfflineGT60Days": [
                  "Succeeded"
                ]
              }
            },
            "Create_CSV_tableGT60Days": {
              "type": "Table",
              "inputs": {
                "from": "@body('SelectGT60Days')",
                "format": "CSV"
              },
              "runAfter": {
                "SelectGT60Days": [
                  "Succeeded"
                ]
              }
            },
            "Create_HTML_table": {
              "type": "Table",
              "inputs": {
                "from": "@body('SelectGT60Days')",
                "format": "HTML"
              },
              "runAfter": {
                "Create_CSV_tableGT60Days": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "8eda08a8-3d37-4ec3-b5a7-164e7b69c72c"
              }
            },
            "Compose": {
              "type": "Compose",
              "inputs": "<style>\n    table {\n        width:100%;\n        height:100%;\n        border:1px solid #b3adad;\n        border-collapse:collapse;\n    }\n    table th {\n        border:1px solid #b3adad;\n        background: #0000FF; /* Blue background color */\n        color: #FFFFFF; /* White font color */\n    }\n    table td {\n        border:1px solid #b3adad;\n        text-align:center;\n        background: #ffffff;\n        color: #313030;\n    }\n</style>\n@{body('Create_HTML_table')}",
              "runAfter": {
                "Create_HTML_table": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "e6de21c2-2407-4e47-a528-c80fecd0ee85"
              }
            },
            "Condition": {
              "type": "If",
              "expression": {
                "and": [
