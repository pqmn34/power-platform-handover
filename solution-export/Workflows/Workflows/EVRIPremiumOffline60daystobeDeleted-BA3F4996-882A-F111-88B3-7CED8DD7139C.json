                    "actions": {
                      "Send_an_email_(V2)": {
                        "type": "OpenApiConnection",
                        "inputs": {
                          "parameters": {
                            "emailMessage/To": "@outputs('EmailTO')",
                            "emailMessage/Subject": "EVRi Premium: Offline > 60 Days Lost Devices",
                            "emailMessage/Body": "<p class=\"editor-paragraph\"><i><em class=\"editor-text-italic\">Greetings!,</em></i><br><br>Please find attached the report of Offline &gt; 60 Days Lost devices.<br><b><strong class=\"editor-text-bold\">EVRI PREMIUM DEVICES</strong></b></p><p class=\"editor-paragraph\">@{outputs('Compose')}</p><br><p class=\"editor-paragraph\">For any questions regarding the report data, please contact your Zebra Service Manager (jakub.polak@zebra.com).<br><br><i><em class=\"editor-text-italic\">Important: This is an automated notification sent from an unmonitored mailbox. Please do not reply to this email.</em></i><br><br>Regards,<br>Strategic Innovation and Automation<br><br><br><span style=\"color: rgb(208, 2, 27);\">- CONFIDENTIAL-</span><br><br>This email and any files transmitted with it are confidential and may also be legally privileged. If you are not the intended recipient, you may not review, use, copy, or distribute this message. If you receive this email in error, please notify the sender immediately by reply email and then delete this email.</p><br>",
                            "emailMessage/Sensitivity": "9ca67e64-6921-4a30-921f-923231455f5f",
                            "emailMessage/From": "strategicinnovationandautomation@zebra.com",
                            "emailMessage/Cc": "@outputs('EmailCC')",
                            "emailMessage/Bcc": "PQMN34@zebra.com",
                            "emailMessage/Attachments": [
                              {
                                "Name": "evri_premium_offlineGT60days_lost.csv",
                                "ContentBytes": "@body('Create_CSV_tableGT60Days')"
                              }
                            ],
                            "emailMessage/Importance": "High"
                          },
                          "host": {
                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                            "operationId": "SendEmailV2",
                            "connectionName": "shared_office365"
                          }
                        },
                        "metadata": {
                          "operationMetadataId": "e6f6822a-6a99-4569-8c54-fce4ceabd249"
                        }
                      }
                    }
                  },
                  "runAfter": {
                    "Create_file": [
                      "Succeeded"
                    ]
                  },
                  "metadata": {
                    "operationMetadataId": "17ba7cd5-11ce-4546-8f6a-14785cedaad7"
                  }
                },
                "Create_file": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "parameters": {
                      "dataset": "https://zebra.sharepoint.com/sites/DMSBAExternal",
                      "folderPath": "/Shared Documents/EVRI PREMIUM/LOST AND STOLEN/LOST OFFLINE MORE THAN 60 DAYS/@{formatDateTime(utcNow(),'yyyy')}/@{formatDateTime(utcNow(),'MM')}/",
                      "name": "evri_premium_lostofflineGT60days_@{formatDateTime(utcNow(),'yyyy-MM-dd')}.csv",
                      "body": "@body('Create_CSV_tableGT60Days')"
                    },
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                      "operationId": "CreateFile",
                      "connectionName": "shared_sharepointonline-1"
                    }
                  },
                  "runtimeConfiguration": {
                    "contentTransfer": {
                      "transferMode": "Chunked"
                    }
                  }
                }
              },
              "else": {
                "actions": {
                  "Terminate_1": {
                    "type": "Terminate",
                    "inputs": {
                      "runStatus": "Succeeded"
                    }
                  }
                }
              },
              "runAfter": {
                "Compose": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "379f5002-e3ce-4a39-a16b-23439d641c38"
              }
            }
          },
          "runAfter": {
            "Offlinemorethan60days": [
              "Succeeded"
            ]
          }
        },
        "CountOfflineGT60Days": {
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "groupid": "ed7233e2-1daf-4288-a3fd-d4943f0b8f89",
              "datasetid": "3f0a252e-8705-4d80-96bc-e2060c3e501d",
              "specification/query": "// DAX Query\nEVALUATE\n\tROW(\n\t\t\"CountLostSNGT60Days\", 'LostDevicesGT60DaysDeletion'[CountLostSNGT60Days]\n\t)\n",
              "specification/serializerSettings/includeNulls": false
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_powerbi",
              "operationId": "ExecuteDatasetQuery",
              "connectionName": "shared_powerbi-2"
            }
          },
          "runAfter": {
            "EmailCC": [
              "Succeeded"
            ]
          }
        },
        "Offlinemorethan60days": {
          "type": "Compose",
          "inputs": "@int(coalesce(outputs('CountOfflineGT60Days')?['body']?['firstTableRows']?[0]?['[CountLostSNGT60Days]'], 0))",
          "runAfter": {
            "CountOfflineGT60Days": [
              "Succeeded"
            ]
          }
        }
      }
