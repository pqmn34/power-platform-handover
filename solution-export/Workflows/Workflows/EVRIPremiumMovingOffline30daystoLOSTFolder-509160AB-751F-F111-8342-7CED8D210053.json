                  "specification/query": "// DAX Query\nDEFINE\n\tVAR __DS0Core = \n\t\tSUMMARIZE(\n\t\t\t'LnSOffilineGT30DaysDevices',\n\t\t\t'LnSOffilineGT30DaysDevices'[DeviceName],\n\t\t\t'LnSOffilineGT30DaysDevices'[HardwareSerialNumber],\n\t\t\t'LnSOffilineGT30DaysDevices'[Model],\n\t\t\t'LnSOffilineGT30DaysDevices'[EnrollmentTime],\n\t\t\t'LnSOffilineGT30DaysDevices'[LastSeen],\n\t\t\t'LnSOffilineGT30DaysDevices'[OfflineDays],\n\t\t\t'LnSOffilineGT30DaysDevices'[DeviceOffline>30Days],\n\t\t\t'LnSOffilineGT30DaysDevices'[ICCID],\n\t\t\t'LnSOffilineGT30DaysDevices'[Path],\n\t\t\t'LnSOffilineGT30DaysDevices'[Site],\n\t\t\t'LnSOffilineGT30DaysDevices'[DeviceID]\n\t\t)\n\nEVALUATE\n\t__DS0Core\n\nORDER BY\n\t'LnSOffilineGT30DaysDevices'[Path],\n\t'LnSOffilineGT30DaysDevices'[DeviceName],\n\t'LnSOffilineGT30DaysDevices'[HardwareSerialNumber],\n\t'LnSOffilineGT30DaysDevices'[Model],\n\t'LnSOffilineGT30DaysDevices'[EnrollmentTime],\n\t'LnSOffilineGT30DaysDevices'[LastSeen],\n\t'LnSOffilineGT30DaysDevices'[OfflineDays],\n\t'LnSOffilineGT30DaysDevices'[DeviceOffline>30Days],\n\t'LnSOffilineGT30DaysDevices'[ICCID],\n\t'LnSOffilineGT30DaysDevices'[Site],\n\t'LnSOffilineGT30DaysDevices'[DeviceID]\n",
                  "specification/serializerSettings/includeNulls": false
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_powerbi",
                  "operationId": "ExecuteDatasetQuery",
                  "connectionName": "shared_powerbi-2"
                }
              }
            },
