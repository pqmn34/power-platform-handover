              "specification/query": "DEFINE\n\tVAR __DS0FilterTable = \n\t\tTREATAS({\"EMEA\"}, 'Zebra DB'[Region Path])\n\n\tVAR __DS0FilterTable2 = \n\t\tTREATAS({\"Offline\"}, 'Zebra DB'[Offline > 60 Days])\n\n\tVAR __DS0Core = \n\t\tCALCULATETABLE(\n\t\t\tSUMMARIZE(\n\t\t\t\t'Zebra DB',\n\t\t\t\t'Zebra DB'[EnrollmentTime],\n\t\t\t\t'Zebra DB'[Offline Days],\n\t\t\t\t'Zebra DB'[Device Name],\n\t\t\t\t'Zebra DB'[DeviceGroupPath],\n\t\t\t\t'Zebra DB'[Model],\n\t\t\t\t'Zebra DB'[SerialNo],\n\t\t\t\t'Zebra DB'[Business Division],\n\t\t\t\t'Zebra DB'[Business Site],\n\t\t\t\t'Zebra DB'[Business Unit],\n\t\t\t\t'Zebra DB'[Offline > 60 Days],\n\t\t\t\t'Zebra DB'[Star ID],\n\t\t\t\t'Zebra DB'[LastDisConnTime],\n\t\t\t\t'Zebra DB'[DevID],\n\t\t\t\t'Zebra DB'[ICCID]\n\t\t\t),\n\t\t\tKEEPFILTERS(__DS0FilterTable),\n\t\t\tKEEPFILTERS(__DS0FilterTable2)\n\t\t)\n\nEVALUATE\n\t__DS0Core \n\nORDER BY\n\t'Zebra DB'[ICCID] DESC,\n\t'Zebra DB'[EnrollmentTime],\n\t'Zebra DB'[Offline Days],\n\t'Zebra DB'[Device Name],\n\t'Zebra DB'[DeviceGroupPath],\n\t'Zebra DB'[Model],\n\t'Zebra DB'[SerialNo],\n\t'Zebra DB'[Business Division],\n\t'Zebra DB'[Business Site],\n\t'Zebra DB'[Business Unit],\n\t'Zebra DB'[Offline > 60 Days],\n\t'Zebra DB'[Star ID],\n\t'Zebra DB'[DevID],\n\t'Zebra DB'[LastDisConnTime]",
              "specification/serializerSettings/includeNulls": false
            },
