            "select": {
              "Device Name": "@item()?['Zebra DB[Device Name]']",
              "Serial Number": "@item()?['Zebra DB[SerialNo]']",
              "Model": "@item()?['Zebra DB[Model]']",
              "Business Division": "@item()?['Zebra DB[Business Division]']",
              "Business Site": "@item()?['Zebra DB[Business Site]']",
              "Business Unit": "@item()?['Zebra DB[Business Unit]']",
              "Offline Days": "@item()?['Zebra DB[Offline Days]']",
              "Offline > 60 Days": "@item()?['Zebra DB[Offline > 60 Days]']",
              "Last Seen": "@if(equals(item()?['Zebra DB[LastDisConnTime]'], null), '', formatDateTime(item()?['Zebra DB[LastDisConnTime]'],'dd/MM/yyyy', 'en-GB'))",
              "Enrollment Time": "@if(equals(item()?['Zebra DB[EnrollmentTime]'], null), '', formatDateTime(item()?['Zebra DB[EnrollmentTime]'],'dd/MM/yyyy HH:mm', 'en-GB'))",
              "Star ID": "@item()?['Zebra DB[Star ID]']",
              "Device Group Path": "@item()?['Zebra DB[DeviceGroupPath]']",
              "ICCID": "@concat('`', item()?['Zebra DB[ICCID]'], '`')",
              "Device ID": "@item()?['Zebra DB[DevID]']"
            }
