        "EVRiCountMoreThan60DaysOffline": {
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "groupid": "ed7233e2-1daf-4288-a3fd-d4943f0b8f89",
              "datasetid": "197b214a-ad12-4a8d-bb1f-ec6f7a6e218f",
