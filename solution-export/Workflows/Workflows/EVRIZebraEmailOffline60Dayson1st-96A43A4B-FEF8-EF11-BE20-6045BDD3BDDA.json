        "Send_an_email_(V2)": {
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "emailMessage/To": "dms.support@zebra.com;Iva.Musialkova@zebra.com",
              "emailMessage/Subject": "EVRi: Offline > 60 Days Devices for the Star ID",
              "emailMessage/Body": "<p class=\"editor-paragraph\">Dear SvD L1,<br><br><b><strong class=\"editor-text-bold\">1st of the Month: </strong></b>Receive the list of devices offline for more than 15 days&nbsp;for the Service Desk record only.</p><p class=\"editor-paragraph\"><br><b><strong class=\"editor-text-bold\">15th of the Month: </strong></b>Receive the list of devices offline for more than 30 days&nbsp;before moving the devices to the \"Lost\" category for the Service Desk record.<br><b><strong class=\"editor-text-bold\">Review the report: </strong></b>If there is any PEAK device, move it back to the site folder mentioned in the attached report.<br><br><b><strong class=\"editor-text-bold\">28th of the Month: </strong></b>Receive the list of devices offline for more than 60 days&nbsp;for the Service Desk record.<br><br><b><strong class=\"editor-text-bold\">1st of the Month (again): </strong></b>Receive the list of devices offline for more than 60 days&nbsp;for the Service Desk.<br><b><strong class=\"editor-text-bold\">Review the report:</strong></b><br><b><strong class=\"editor-text-bold\">If a PEAK device is found:</strong></b><br>Move the device back to the site where it belongs (site information can be found in the offline &gt; 30 days report received on the 15th of the month).<br><b><strong class=\"editor-text-bold\">If no PEAK device is found:</strong></b><br>Click on the \"<span style=\"color: rgb(243, 15, 15);\">CLICK HERE</span>\" <b><strong class=\"editor-text-bold\">button below</strong></b> once the data has been reviewed successfully. [Note: A blank webpage will open after clicking on the click here button. It means the process has started]<br>Raise a case&nbsp;with the Device Managed Services Business Analytical team and CC:&nbsp;strategicinnovationandautomation@zebra.com&nbsp;if there are any concerns or questions in the reported data.</p><br><p class=\"editor-paragraph\">To delete the devices: <span style=\"color: rgb(247, 9, 9);\">[</span><a href=\"https://prod-173.westus.logic.azure.com:443/workflows/3c03e4e200ef4c0eb8f22be3fe5cf182/triggers/manual/paths/invoke?api-version=2016-06-01&amp;sp=%2Ftriggers%2Fmanual%2Frun&amp;sv=1.0&amp;sig=megFEMafbnKdknSbnbXhKD4qjdh8IFxrht1h0ErAL0Q\" class=\"editor-link\"><b><strong class=\"editor-text-bold\" style=\"color: rgb(247, 9, 9);\">CLICK HERE</strong></b></a><b><strong class=\"editor-text-bold\" style=\"color: rgb(247, 9, 9);\">] - </strong></b><u><b><strong class=\"editor-text-bold editor-text-underline\" style=\"color: rgb(247, 9, 9);\">CURRENTLY ON HOLD</strong></b></u></p><p class=\"editor-paragraph\">ZEBRA DEVICES<br>@{outputs('Compose')}<br></p><br><p class=\"editor-paragraph\">If there are any issues with this report, don't hesitate to get in touch with strategicinnovationandautomation@zebra.com.</p><br><p class=\"editor-paragraph\">Warm regards</p><br><p class=\"editor-paragraph\">Zebra DMS Support</p>",
              "emailMessage/From": "strategicinnovationandautomation@zebra.com",
              "emailMessage/Cc": "elena.brusentsova@zebra.com;GMSSBA@zebra.com",
              "emailMessage/Bcc": "StrategicInnovationandAutomation@Zebra.com",
              "emailMessage/Attachments": [
                {
                  "Name": "ZebraOfflineMoreThan60Days.csv",
                  "ContentBytes": "@body('Create_CSV_table')"
                }
              ],
              "emailMessage/Sensitivity": "7913cad2-a247-4f49-9740-2c85886f613a",
              "emailMessage/Importance": "High"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
              "operationId": "SendEmailV2",
              "connectionName": "shared_office365"
            }
          },
