            "Send_an_email_(V2)": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "emailMessage/To": "@trim(outputs('EmailTO'))",
                  "emailMessage/Subject": "ACTION REQUIRED: Devices Offline > 14/44 days updated to Lost/Wipe",
                  "emailMessage/Body": "<p class=\"editor-paragraph\">Dear Partner Team,</p><p class=\"editor-paragraph\">Attached are this week's reports for Lost and Wiped devices. Please update the asset register X012 with the data provided in these files.</p><ul class=\"editor-list-ul\"><li class=\"editor-listitem\"><b><strong class=\"editor-text-bold\">PFW_Moved_To_LOST.csv:</strong></b> Devices reported as Offline &gt; 14 Days (ParcelForce).</li><li class=\"editor-listitem\"><b><strong class=\"editor-text-bold\">RML_Moved_To_WIPE.csv:</strong></b> Devices reported as Offline &gt; 14 Days (Royal Mail).</li><li class=\"editor-listitem\"><b><strong class=\"editor-text-bold\">RML_Moved_To_LOST.csv:</strong></b> Devices confirmed as Offline &gt; 44 Days (Royal Mail).</li><li class=\"editor-listitem\"><b><strong class=\"editor-text-bold\">PFW_Moved_To_WIPE.csv:</strong></b> Devices confirmed as Offline &gt; 44 Days (ParcelForce).</li></ul><p class=\"editor-paragraph\"><i><em class=\"editor-text-italic\">A file will only be attached if there is data to report.</em></i></p><p class=\"editor-paragraph\">This is an automated notification. Should you have any questions regarding the data, please contact the <b><strong class=\"editor-text-bold\">Zebra PDA Service Desk L1</strong></b>.</p><br><p class=\"editor-paragraph\">Kind regards</p><br><p class=\"editor-paragraph\">Strategic Innovation and Automation</p>",
                  "emailMessage/Sensitivity": "9ca67e64-6921-4a30-921f-923231455f5f",
                  "emailMessage/From": "strategicinnovationandautomation@zebra.com",
                  "emailMessage/Cc": "@trim(outputs('EmailCC'))",
                  "emailMessage/Attachments": "@variables('AttachmentsArray')",
                  "emailMessage/Importance": "High"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                  "operationId": "SendEmailV2",
                  "connectionName": "shared_office365"
                }
              },
              "runAfter": {
                "RML_WIPE_FILE": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {
            "AttachmentsArray": [
              "Succeeded"
            ]
          }
