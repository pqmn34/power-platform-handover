                  "type": "OpenApiConnection",
                  "inputs": {
                    "parameters": {
                      "dataset": "https://zebra.sharepoint.com/sites/DMSBAExternal",
                      "table": "1333b483-ec3b-48e9-a400-71208aaa9db2",
                      "$filter": "FileLeafRef eq '@{outputs('Compose_Expected_PFW_WIPE_Filename')}'",
                      "folderPath": "/Shared Documents/RMG/LOST AND STOLEN/WIPE/PFWD/MOVED"
                    },
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                      "operationId": "GetFileItems",
                      "connectionName": "shared_sharepointonline"
                    }
                  },
                  "runAfter": {
                    "Compose_Expected_PFW_WIPE_Filename": [
                      "Succeeded"
                    ]
                  },
                  "runtimeConfiguration": {
                    "paginationPolicy": {
                      "minimumItemCount": 2000
                    }
                  }
                },
                "Filter_array_PFWWIPE": {
                  "type": "Query",
                  "inputs": {
                    "from": "@outputs('Get_files_(properties_only)_PFWWIPE')?['body/value']",
                    "where": "@equals(item()?['{FilenameWithExtension}'],outputs('Compose_Expected_PFW_WIPE_Filename'))"
