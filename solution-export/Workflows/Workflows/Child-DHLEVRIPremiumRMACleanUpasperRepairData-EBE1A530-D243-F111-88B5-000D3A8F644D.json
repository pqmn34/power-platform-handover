        "DHLRMAReceivedByZebra": {
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "groupid": "ed7233e2-1daf-4288-a3fd-d4943f0b8f89",
              "datasetid": "3f0a252e-8705-4d80-96bc-e2060c3e501d",
              "specification/query": "// DAX Query\nDEFINE\n\tVAR __DS0FilterTable = \n\t\tFILTER(\n\t\t\tKEEPFILTERS(VALUES('RMA Repaired Devices'[OfflineDays])),\n\t\t\t'RMA Repaired Devices'[OfflineDays] >= 1\n\t\t)\n\n\tVAR __DS0FilterTable2 = \n\t\tFILTER(\n\t\t\tKEEPFILTERS(VALUES('RMA Repaired Devices'[Path])),\n\t\t\tNOT(SEARCH(\"Staging\", 'RMA Repaired Devices'[Path], 1, 0) >= 1)\n\t\t)\n\n\tVAR __DS0FilterTable3 = \n\t\tTREATAS({\"Offline\"}, 'RMA Repaired Devices'[Connection Status])\n\t\n\tVAR __DS0FilterTable4 = \n\t\tTREATAS({\"Received\"}, 'RMA Repaired Devices'[Line Status])\n\n\tVAR __DS0Core = \n\t\tCALCULATETABLE(\n\t\t\tSUMMARIZE(\n\t\t\t\t'RMA Repaired Devices',\n\t\t\t\t'RMA Repaired Devices'[DeviceName],\n\t\t\t\t'RMA Repaired Devices'[DeviceOffline>30Days],\n\t\t\t\t'RMA Repaired Devices'[DeviceOffline>40Days],\n\t\t\t\t'RMA Repaired Devices'[DevID],\n\t\t\t\t'RMA Repaired Devices'[HardwareSerialNumber],\n\t\t\t\t'RMA Repaired Devices'[ICCID],\n\t\t\t\t'RMA Repaired Devices'[IMEI],\n\t\t\t\t'RMA Repaired Devices'[Line Status],\n\t\t\t\t'RMA Repaired Devices'[OfflineDays],\n\t\t\t\t'RMA Repaired Devices'[Path],\n\t\t\t\t'RMA Repaired Devices'[RMA #],\n\t\t\t\t'RMA Repaired Devices'[Serial # In],\n\t\t\t\t'RMA Repaired Devices'[Site],\n\t\t\t\t'RMA Repaired Devices'[Ship Date],\n\t\t\t\t'RMA Repaired Devices'[Connection Status],\n\t\t\t\t'RMA Repaired Devices'[Billed Account Name]\n\t\t\t),\n\t\t\tKEEPFILTERS(__DS0FilterTable),\n\t\t\tKEEPFILTERS(__DS0FilterTable2),\n\t\t\tKEEPFILTERS(__DS0FilterTable3),\n\t\t\tKEEPFILTERS(__DS0FilterTable4)\n\t\t)\n\nEVALUATE\n\t__DS0Core\n\nORDER BY\n\t'RMA Repaired Devices'[Connection Status],\n\t'RMA Repaired Devices'[DeviceName],\n\t'RMA Repaired Devices'[DeviceOffline>30Days],\n\t'RMA Repaired Devices'[DeviceOffline>40Days],\n\t'RMA Repaired Devices'[DevID],\n\t'RMA Repaired Devices'[HardwareSerialNumber],\n\t'RMA Repaired Devices'[ICCID],\n\t'RMA Repaired Devices'[IMEI],\n\t'RMA Repaired Devices'[Line Status],\n\t'RMA Repaired Devices'[OfflineDays],\n\t'RMA Repaired Devices'[Path],\n\t'RMA Repaired Devices'[RMA #],\n\t'RMA Repaired Devices'[Serial # In],\n\t'RMA Repaired Devices'[Site],\n\t'RMA Repaired Devices'[Ship Date],\n\t'RMA Repaired Devices'[Billed Account Name]",
              "specification/serializerSettings/includeNulls": false
            },
            "host": {
