        "SelectDHLOfflineMoreThan40Days": {
          "type": "Select",
          "inputs": {
            "from": "@outputs('DHLRMAReceivedByZebra')?['body/firstTableRows']",
            "select": {
              "Device Name": "@item()?['RMA Repaired Devices[DeviceName]']",
              "Connection Status": "@item()?['RMA Repaired Devices[Connection Status]']",
              "Serial Number": "@item()?['RMA Repaired Devices[HardwareSerialNumber]']",
              "IMEI": "@item()?['RMA Repaired Devices[IMEI]']",
