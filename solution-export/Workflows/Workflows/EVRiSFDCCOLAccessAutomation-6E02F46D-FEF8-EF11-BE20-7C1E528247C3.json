[Internal Reference],\n\t'EVRi BYOD'[Resolution Type],\n\t'EVRi BYOD'[DateTimeOpened],\n\t'EVRi BYOD'[IsRecent],\n\t'EVRi BYOD'[DateTimeClosed],\n\t'EVRi BYOD'[First Name],\n\t'EVRi BYOD'[Last Name],\n\t'EVRi BYOD'[Number],\n\t'EVRi BYOD'[test],\n\t'EVRi BYOD'[name1],\n\t'EVRi BYOD'[name2]",
              "specification/serializerSettings/includeNulls": false
            },
            "host": {
