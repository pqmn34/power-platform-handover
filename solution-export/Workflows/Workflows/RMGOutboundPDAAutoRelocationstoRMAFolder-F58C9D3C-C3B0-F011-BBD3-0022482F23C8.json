        "SUCCESS_Handling": {
          "type": "Scope",
          "actions": {
            "SUCCESS_Send_an_email_(V2)": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "emailMessage/To": "PQMN34@zebra.com",
                  "emailMessage/Subject": "RMG: SUCCESSFULLY COMPLETED-RMG PEAK Device Auto Relocations as per X012",
                  "emailMessage/Body": "<p class=\"editor-paragraph\"><b><strong class=\"editor-text-bold\" style=\"background-color: rgb(126, 211, 33); color: rgb(255, 255, 255);\">SUCCESSFULLY COMPLETED</strong></b><b><strong class=\"editor-text-bold\" style=\"background-color: rgb(126, 211, 33); color: rgb(255, 255, 255);\"> </strong></b><b><strong class=\"editor-text-bold\" style=\"background-color: rgb(126, 211, 33); color: rgb(255, 255, 255);\">: </strong></b><b><strong class=\"editor-text-bold\" style=\"background-color: rgb(126, 211, 33); color: rgb(255, 255, 255);\">RMG Outbound PDA Auto Relocations to RMA Folder</strong></b><br>Flow Name: @{workflow()?['tags']['flowDisplayName']}<br>Run ID: @{workflow()?['run']['name']}<br>Link to Run: @{concat('https://make.powerautomate.com/environments/', workflow()?['name'], '/flows/', workflow()?['tags']['logicAppName'], '/runs/', workflow()?['run']['name'])}<br>Link to Run: @{concat('https://make.powerautomate.com/environments/', workflow()?['name'], '/flows/', workflow()?['tags']['logicAppName'], '/runs/', workflow()?['run']['name'])}</p><p class=\"editor-paragraph\">SUCCESSFUL MOVES:@{if(empty(variables('arrSuccessLog')), 'None', outputs('Compose_PASSED_HTML_Table'))}<br>FAILED MOVES:<br>@{if(empty(variables('arrFailureLog')), 'None', outputs('Compose_FAILED_HTML_Table'))}</p><br>",
                  "emailMessage/Importance": "High"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                  "operationId": "SendEmailV2",
                  "connectionName": "shared_office365"
                }
              },
              "runAfter": {
                "Post_PASSED_message_in_a_chat_or_channel": [
                  "Succeeded"
                ]
