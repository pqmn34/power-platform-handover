        "Scope": {
          "type": "Scope",
          "actions": {
            "Apply_to_each": {
              "type": "Foreach",
              "foreach": "@body('Select_RMADevices')",
              "actions": {
                "Condition": {
                  "type": "If",
                  "expression": {
                    "and": [
                      {
                        "equals": [
                          "@outputs('Compose')",
                          200
                        ]
                      }
                    ]
                  },
                  "actions": {
                    "Append_to_string_variable_PASSED": {
                      "type": "AppendToStringVariable",
                      "inputs": {
                        "name": "varSuccessLog",
                        "value": "SUCCESS: Moved SN  to group "
                      },
                      "runAfter": {
                        "Append_to_array_variable_PASSED": [
                          "Succeeded"
                        ]
                      }
                    },
                    "Append_to_array_variable_PASSED": {
                      "type": "AppendToArrayVariable",
                      "inputs": {
                        "name": "arrSuccessLog",
                        "value": {
                          "Asset": "@{item()?['Asset']}",
                          "Serial Number": "@{item()?['Serial Number']}",
                          "Group Path": "@{item()?['Group Path']}"
                        }
                      }
                    }
                  },
                  "else": {
                    "actions": {
                      "Append_to_string_variable_FAILED": {
                        "type": "AppendToStringVariable",
                        "inputs": {
                          "name": "varFailureLog",
                          "value": "FAILED: SN . Status: @{outputs('HTTP')?['statusCode']}. Error: @{outputs('HTTP')?['body']}"
                        },
                        "runAfter": {
                          "Append_to_array_variable_FAILED": [
                            "Succeeded"
                          ]
                        }
                      },
                      "Append_to_array_variable_FAILED": {
                        "type": "AppendToArrayVariable",
                        "inputs": {
                          "name": "arrFailureLog",
                          "value": {
                            "Asset": "@{item()?['Asset']}",
                            "Serial Number": "@{item()?['Serial Number']}",
                            "Group Path": "@{item()?['Group Path']}"
                          }
                        }
                      }
                    }
                  },
                  "runAfter": {
                    "Compose": [
                      "Succeeded"
                    ]
                  }
                },
                "HTTP": {
                  "type": "Http",
                  "inputs": {
                    "uri": "https://zebrams001.eu.suremdm.io/api/deviceassignment",
                    "method": "PUT",
                    "headers": {
                      "ApiKey": "@{outputs('Get_secret_APIKEY')?['body/value']}",
                      "Content-TypeContent-Type": "application/json"
                    },
                    "body": [
                      {
                        "DeviceID": "@{item()?['DeviceID']}",
                        "GroupID": "@{outputs('ComposeGroupID')}"
                      }
                    ],
                    "authentication": {
                      "type": "Basic",
                      "username": "@{outputs('Get_secret_UID')?['body/value']}",
                      "password": "@{outputs('Get_secret_PSWD')?['body/value']}"
                    }
                  },
                  "runAfter": {
                    "Compose_1": [
                      "Succeeded"
                    ]
                  },
                  "runtimeConfiguration": {
                    "contentTransfer": {
                      "transferMode": "Chunked"
                    }
                  }
                },
                "Compose": {
                  "type": "Compose",
                  "inputs": "@int(outputs('HTTP')['statusCode'])",
                  "runAfter": {
                    "HTTP": [
                      "Succeeded"
                    ]
                  }
                },
                "Compose_1": {
                  "type": "Compose",
                  "inputs": "@item()?['DeviceID']"
                }
              },
              "runtimeConfiguration": {
                "concurrency": {
                  "repetitions": 30
                }
              }
            },
            "Create_HTML_table_PASSED": {
              "type": "Table",
              "inputs": {
                "from": "@variables('arrSuccessLog')",
                "format": "HTML",
                "columns": [
                  {
                    "header": "Asset",
                    "value": "@item()?['Asset']"
                  },
                  {
                    "header": "Serial Number",
                    "value": "@item()?['Serial Number']"
                  },
                  {
                    "header": "Group Path",
                    "value": "@item()?['Group Path']"
                  }
                ]
              },
              "runAfter": {
                "Apply_to_each": [
                  "Succeeded"
                ]
              }
            },
            "Compose_PASSED_HTML_Table": {
              "type": "Compose",
              "inputs": "@replace(outputs('Create_HTML_table_PASSED')?['body'], '<table>', '<style>table {border: 1px solid #ddd; border-collapse: collapse; font-family: sans-serif; width: 100%;} th, td {border: 1px solid #ddd; padding: 8px; text-align: left;} th {background-color: #C00000; color: white; font-weight: bold; text-align: center;}</style><table>')",
