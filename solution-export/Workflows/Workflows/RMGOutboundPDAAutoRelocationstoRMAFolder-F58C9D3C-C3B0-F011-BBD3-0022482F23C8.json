        "Run_a_query_against_a_dataset_RMAGroupID": {
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "groupid": "ed7233e2-1daf-4288-a3fd-d4943f0b8f89",
              "datasetid": "01eb5fcd-97e7-443a-aa11-6be57bed6ae7",
              "specification/query": "DEFINE\n\tVAR __DS0FilterTable = \n\t\tFILTER(\n\t\t\tKEEPFILTERS(VALUES('royal_mail_groups'[group_path])),\n\t\t\tSEARCH(\"/RMA\", 'royal_mail_groups'[group_path], 1, 0) >= 1\n\t\t)\n\n\tVAR __DS0Core = \n\t\tCALCULATETABLE(\n\t\t\tSUMMARIZE(\n\t\t\t\t'royal_mail_groups',\n\t\t\t\t'royal_mail_groups'[group_path],\n\t\t\t\t'royal_mail_groups'[group_name],\n\t\t\t\t'royal_mail_groups'[group_id]\n\t\t\t),\n\t\t\tKEEPFILTERS(__DS0FilterTable)\n\t\t)\n\nEVALUATE\n\t__DS0Core\n\nORDER BY\n\t'royal_mail_groups'[group_path],\n\t'royal_mail_groups'[group_name],\n\t'royal_mail_groups'[group_id]",
              "specification/serializerSettings/includeNulls": false
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_powerbi",
              "operationId": "ExecuteDatasetQuery",
              "connectionName": "shared_powerbi-1"
            }
          },
          "runAfter": {
            "varFailureLog": [
              "Succeeded"
            ]
          }
        },
        "ComposeGroupID": {
          "type": "Compose",
          "inputs": "@first(body('Run_a_query_against_a_dataset_RMAGroupID')?['firstTableRows'])?['royal_mail_groups[group_id]']",
          "runAfter": {
            "Run_a_query_against_a_dataset_RMAGroupID": [
              "Succeeded"
            ]
          }
        },
        "Run_a_query_against_a_dataset_RMADevices": {
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "groupid": "ed7233e2-1daf-4288-a3fd-d4943f0b8f89",
              "datasetid": "01eb5fcd-97e7-443a-aa11-6be57bed6ae7",
              "specification/query": "DEFINE\n\tVAR __DS0Core = \n\t\tSUMMARIZE(\n\t\t\t'OutboundToRMA',\n\t\t\t'OutboundToRMA'[Asset],\n\t\t\t'OutboundToRMA'[Company],\n\t\t\t'OutboundToRMA'[Customer Location Identifier],\n\t\t\t'OutboundToRMA'[Device ID],\n\t\t\t'OutboundToRMA'[Display name],\n\t\t\t'OutboundToRMA'[Group Path],\n\t\t\t'OutboundToRMA'[Name],\n\t\t\t'OutboundToRMA'[Number],\n\t\t\t'OutboundToRMA'[Outgoing asset],\n\t\t\t'OutboundToRMA'[Serial number],\n\t\t\t'OutboundToRMA'[SIM number]\n\t\t)\n\nEVALUATE\n\t__DS0Core\n\nORDER BY\n\t'OutboundToRMA'[Asset],\n\t'OutboundToRMA'[Company],\n\t'OutboundToRMA'[Customer Location Identifier],\n\t'OutboundToRMA'[Device ID],\n\t'OutboundToRMA'[Display name],\n\t'OutboundToRMA'[Group Path],\n\t'OutboundToRMA'[Name],\n\t'OutboundToRMA'[Number],\n\t'OutboundToRMA'[Outgoing asset],\n\t'OutboundToRMA'[Serial number],\n\t'OutboundToRMA'[SIM number]",
              "specification/serializerSettings/includeNulls": false
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_powerbi",
              "operationId": "ExecuteDatasetQuery",
              "connectionName": "shared_powerbi-1"
            }
          },
          "runAfter": {
            "ComposeGroupID": [
              "Succeeded"
            ]
          }
        },
        "Select_RMADevices": {
          "type": "Select",
          "inputs": {
            "from": "@outputs('Run_a_query_against_a_dataset_RMADevices')?['body/firstTableRows']",
            "select": {
              "Asset": "@item()?['OutboundToRMA[Asset]']",
              "Serial Number": "@item()?['OutboundToRMA[Serial number]']",
              "Company": "@item()?['OutboundToRMA[Company]']",
              "Customer Location Identifier": "@item()?['OutboundToRMA[Customer Location Identifier]']",
              "Display Name": "@item()?['OutboundToRMA[Display name]']",
              "Group Path": "@item()?['OutboundToRMA[Group Path]']",
              "Name": "@item()?['OutboundToRMA[Name]']",
              "Number": "@item()?['OutboundToRMA[Number]']",
              "Outgoing Asset": "@item()?['OutboundToRMA[Outgoing asset]']",
              "ICCID": "@item()?['OutboundToRMA[SIM number]']",
              "DeviceID": "@item()?['OutboundToRMA[Device ID]']"
            }
          },
          "runAfter": {
            "Run_a_query_against_a_dataset_RMADevices": [
              "Succeeded"
