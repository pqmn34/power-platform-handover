        },
        "runtimeSource": "embedded"
      },
      "shared_powerbi": {
        "api": {
          "name": "shared_powerbi"
        },
        "connection": {
          "connectionReferenceLogicalName": "dms_sharedpowerbi_50189"
        },
        "runtimeSource": "embedded"
      },
      "shared_sharepointonline": {
        "api": {
          "name": "shared_sharepointonline"
        },
        "connection": {
          "connectionReferenceLogicalName": "dms_sharedsharepointonline_4deeb"
        },
        "runtimeSource": "embedded"
      },
      "shared_office365": {
        "api": {
          "name": "shared_office365"
        },
        "connection": {
          "connectionReferenceLogicalName": "new_sharedoffice365_bd676"
        },
        "runtimeSource": "embedded"
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "undefined",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        }
      },
      "triggers": {
        "Recurrence": {
          "type": "Recurrence",
          "recurrence": {
            "interval": 1,
            "frequency": "Week",
            "timeZone": "Central Europe Standard Time",
            "schedule": {
              "hours": [
                "18",
                "11"
              ],
              "minutes": [
                10
              ],
              "weekDays": [
                "Monday",
                "Tuesday",
                "Wednesday",
                "Thursday",
                "Friday",
                "Saturday"
              ]
            }
          }
        }
      },
      "actions": {
        "Scope": {
          "type": "Scope",
          "actions": {
            "Get_secret_UID": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "secretName": "rmg-LnS-42g-uid"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_keyvault",
                  "operationId": "GetSecret",
                  "connectionName": "shared_keyvault"
                }
              },
              "runtimeConfiguration": {
                "secureData": {
                  "properties": [
                    "inputs",
                    "outputs"
                  ]
                }
              }
            },
            "Get_secret_PSWD": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "secretName": "rmg-LnS-42g-pswd"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_keyvault",
                  "operationId": "GetSecret",
                  "connectionName": "shared_keyvault"
                }
              },
              "runAfter": {
                "Get_secret_UID": [
                  "Succeeded"
                ]
              },
              "runtimeConfiguration": {
                "secureData": {
                  "properties": [
                    "inputs",
                    "outputs"
                  ]
                }
              }
            },
            "Run_a_query_against_a_dataset": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "groupid": "ed7233e2-1daf-4288-a3fd-d4943f0b8f89",
                  "datasetid": "b6a56604-7b3d-487e-9038-96e00e480413",
                  "specification/query": "DEFINE VAR __DS0FilterTable = \n\tFILTER(\n\t\tKEEPFILTERS(VALUES('PFW Daisy Release Table TC57X'[Device Name])),\n\t\tNOT(SEARCH(\"-\", 'PFW Daisy Release Table TC57X'[Device Name], 1, 0) >= 1)\n\t)\n\nEVALUATE\n\tSUMMARIZECOLUMNS(\n\t\t__DS0FilterTable,\n\t\t\"Total_PFW_Daisy_Serial_Number\", IGNORE('PFW Daisy Release Table TC57X'[Total PFW Daisy Serial Number])\n\t)",
                  "specification/serializerSettings/includeNulls": false
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_powerbi",
                  "operationId": "ExecuteDatasetQuery",
                  "connectionName": "shared_powerbi"
                }
              },
              "runAfter": {
                "Get_secret_PSWD": [
                  "Succeeded"
                ]
              }
            },
            "Compose": {
              "type": "Compose",
              "inputs": "@body('Run_a_query_against_a_dataset')",
              "runAfter": {
                "Run_a_query_against_a_dataset": [
                  "Succeeded"
                ]
              }
            },
            "Condition": {
              "type": "If",
              "expression": {
                "and": [
                  {
                    "greater": [
                      "@outputs('Compose')?['firstTableRows']?[0]?['[Total_PFW_Daisy_Serial_Number]']",
                      0
                    ]
                  }
                ]
              },
              "actions": {
                "SN_Needs_to_be_Tagged_Daisy": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "parameters": {
                      "groupid": "ed7233e2-1daf-4288-a3fd-d4943f0b8f89",
                      "datasetid": "b6a56604-7b3d-487e-9038-96e00e480413",
                      "specification/query": "DEFINE\n\tVAR __DS0FilterTable = \n\t\tFILTER(\n\t\t\tKEEPFILTERS(VALUES('PFW Daisy Release Table TC57X'[Device Name])),\n\t\t\tNOT(SEARCH(\"-\", 'PFW Daisy Release Table TC57X'[Device Name], 1, 0) >= 1)\n\t\t)\n\n\tVAR __DS0Core = \n\t\tCALCULATETABLE(\n\t\t\tSUMMARIZE(\n\t\t\t\t'PFW Daisy Release Table TC57X',\n\t\t\t\t'PFW Daisy Release Table TC57X'[Device Name],\n\t\t\t\t'PFW Daisy Release Table TC57X'[IMEI],\n\t\t\t\t'PFW Daisy Release Table TC57X'[Serial Number],\n\t\t\t\t'PFW Daisy Release Table TC57X'[Group Path],\n\t\t\t\t'PFW Daisy Release Table TC57X'[Device ID]\n\t\t\t),\n\t\t\tKEEPFILTERS(__DS0FilterTable)\n\t\t)\n\nEVALUATE\n\t__DS0Core\n\nORDER BY\n\t'PFW Daisy Release Table TC57X'[Device Name],\n\t'PFW Daisy Release Table TC57X'[IMEI],\n\t'PFW Daisy Release Table TC57X'[Serial Number],\n\t'PFW Daisy Release Table TC57X'[Group Path],\n\t'PFW Daisy Release Table TC57X'[Device ID]",
                      "specification/serializerSettings/includeNulls": false
                    },
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_powerbi",
                      "operationId": "ExecuteDatasetQuery",
                      "connectionName": "shared_powerbi"
                    }
                  }
                },
                "Select": {
                  "type": "Select",
                  "inputs": {
                    "from": "@outputs('SN_Needs_to_be_Tagged_Daisy')?['body/firstTableRows']",
                    "select": {
                      "Device Name": "@item()?['PFW Daisy Release Table TC57X[Device Name]']",
                      "Serial Number": "@item()?['PFW Daisy Release Table TC57X[Serial Number]']",
                      "IMEI": "@item()?['PFW Daisy Release Table TC57X[IMEI]']",
                      "Device Group Path": "@item()?['PFW Daisy Release Table TC57X[Group Path]']",
                      "Device ID": "@item()?['PFW Daisy Release Table TC57X[Device ID]']"
                    }
                  },
                  "runAfter": {
                    "SN_Needs_to_be_Tagged_Daisy": [
                      "Succeeded"
                    ]
                  }
                },
                "Create_CSV_table": {
                  "type": "Table",
                  "inputs": {
                    "from": "@body('Select')",
                    "format": "CSV"
                  },
                  "runAfter": {
                    "Select": [
                      "Succeeded"
                    ]
                  }
                },
                "Create_file": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "parameters": {
                      "dataset": "https://zebra.sharepoint.com/sites/StrategicInnovationandAutomation",
                      "folderPath": "/Shared Documents/DOCUMENTS/1. ACCOUNTS/ROYAL MAIL GROUP/3. PROJECT/DAISY PROJECT/1. TAG FROM SN TO DAISY",
                      "name": "SN_TO_DAISY_@{concat(formatDateTime(utcNow(), 'dd.MM.yyyy HH:mm'), '.csv')}",
                      "body": "@body('Create_CSV_table')"
                    },
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                      "operationId": "CreateFile",
                      "connectionName": "shared_sharepointonline"
                    }
                  },
                  "runAfter": {
                    "Create_CSV_table": [
                      "Succeeded"
                    ]
                  },
                  "runtimeConfiguration": {
                    "contentTransfer": {
                      "transferMode": "Chunked"
                    }
                  }
                },
                "Delay": {
                  "type": "Wait",
                  "inputs": {
                    "interval": {
                      "count": 1,
                      "unit": "Minute"
                    }
                  },
                  "runAfter": {
                    "Create_file": [
                      "Succeeded"
                    ]
                  }
                },
                "Apply_to_each": {
                  "type": "Foreach",
                  "foreach": "@body('Select')",
                  "actions": {
                    "ComposeDeviceID": {
                      "type": "Compose",
                      "inputs": "@items('Apply_to_each')?['Device ID']"
                    },
                    "ComposeDeviceName": {
                      "type": "Compose",
                      "inputs": "@items('Apply_to_each')?['Device Name']",
                      "runAfter": {
                        "ComposeDeviceID": [
                          "Succeeded"
                        ]
                      }
                    },
                    "ComposeSerialNumber": {
                      "type": "Compose",
                      "inputs": "@items('Apply_to_each')?['Serial Number']",
                      "runAfter": {
                        "ComposeDeviceName": [
                          "Succeeded"
                        ]
                      }
                    },
                    "HTTP": {
                      "type": "Http",
                      "inputs": {
                        "uri": "https://zebrams001.eu.suremdm.io/api/dynamicjob",
                        "method": "POST",
                        "headers": {
                          "ApiKey": "13967834-72B0-42F0-8F8C-66A69BE028D8",
                          "Content-Type": "application/json"
                        },
                        "body": {
                          "DeviceID": "@{outputs('ComposeDeviceID')}",
                          "JobType": "Set_Devicename",
                          "PayLoad": "@{outputs('ComposeSerialNumber')}-D"
                        },
                        "authentication": {
                          "type": "Basic",
                          "username": "@{outputs('Get_secret_UID')?['body/value']}",
                          "password": "@{outputs('Get_secret_PSWD')?['body/value']}"
                        }
                      },
                      "runAfter": {
                        "ComposeSerialNumber": [
                          "Succeeded"
                        ]
                      },
                      "metadata": {
                        "operationMetadataId": "c4a0f7d2-3c92-431c-b147-7397b27532f7"
                      }
                    }
                  },
                  "runAfter": {
                    "Delay": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "Compose": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {}
        },
        "Send_an_email_(V2)": {
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "emailMessage/To": "StrategicInnovationandAutomation@Zebra.com;prabhat.kumar@zebra.com",
              "emailMessage/Subject": "<b>🚨 FAILED ALERT: RMG PDA Rename from SN to Daisy Flow FAILED</b>",
              "emailMessage/Body": "<b>🚨 ALERT: RMG PDA Rename from SN to Daisy Flow FAILED</b>\n\n\n<b>Flow Name:</b> <code>@{workflow().name}</code>\n\n\n<b>Run ID:</b> <code>@{workflow().run.name}</code>\n\n\n<b>Time:</b> <code>@{utcNow()}</code>\n\n\n<b>Status:</b> One or more device processing scopes (RMG Devices Tag to DAISY) have <span style=\"color:red\"><b>FAILED</b></span> or timed out.\n\n\n<b>Action Needed:</b> Please check the Power Automate run log for more details.\n\n\n<i>This is an automated alert from Power Automate.</i>\n",
              "emailMessage/Importance": "High"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
              "operationId": "SendEmailV2",
              "connectionName": "shared_office365"
            }
          },
          "runAfter": {
            "Scope": [
              "TimedOut",
              "Skipped",
              "Failed"
            ]
          }
        }
      }
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}