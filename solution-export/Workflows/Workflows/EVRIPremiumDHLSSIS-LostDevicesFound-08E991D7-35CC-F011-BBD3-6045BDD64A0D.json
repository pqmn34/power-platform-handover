{
  "properties": {
    "connectionReferences": {
      "shared_powerbi-1": {
        "api": {
          "name": "shared_powerbi"
        },
        "connection": {
          "connectionReferenceLogicalName": "dms_sharedpowerbi_1e112"
        },
        "runtimeSource": "embedded"
      },
      "shared_office365": {
        "api": {
          "name": "shared_office365"
        },
        "connection": {
          "connectionReferenceLogicalName": "new_sharedoffice365_bd676"
        },
        "runtimeSource": "embedded"
      },
      "shared_sharepointonline": {
        "api": {
          "name": "shared_sharepointonline"
        },
        "connection": {
          "connectionReferenceLogicalName": "cr4bb_b6599cff35a24544bcf663b98e2da320"
        },
        "runtimeSource": "embedded"
      },
      "shared_teams": {
        "api": {
          "name": "shared_teams"
        },
        "connection": {
          "connectionReferenceLogicalName": "new_sharedteams_ade65"
        },
        "runtimeSource": "embedded"
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "undefined",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        }
      },
      "triggers": {
        "Recurrence": {
          "type": "Recurrence",
          "recurrence": {
            "interval": 1,
            "frequency": "Day",
            "timeZone": "UTC",
            "startTime": "2025-11-27T00:00Z",
            "schedule": {
              "hours": [
                "9",
                "21"
              ],
              "minutes": [
                30
              ]
            }
          }
        }
      },
      "actions": {
        "varCSVContent": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "varCSVContent",
                "type": "string"
              }
            ]
          },
          "runAfter": {
            "EmailCC": [
              "Succeeded"
            ]
          }
        },
        "EmailTO": {
          "type": "Compose",
          "inputs": " stephanie.keats@dhlevripremium.com;sam.turki@evri.com;Paul.Tate@Evri.com",
          "runAfter": {}
        },
        "EmailCC": {
          "type": "Compose",
          "inputs": "Jakub.Polak@zebra.com;GMSSBA@zebra.com;DMSDeliveryLeads@zebra.com",
          "runAfter": {
            "EmailTO": [
              "Succeeded"
            ]
          }
        },
        "Scope": {
          "type": "Scope",
          "actions": {
            "Run_a_query_against_a_dataset": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "groupid": "ed7233e2-1daf-4288-a3fd-d4943f0b8f89",
                  "datasetid": "3f0a252e-8705-4d80-96bc-e2060c3e501d",
                  "specification/query": "DEFINE\n\tVAR __DS0Core = \n\t\tSUMMARIZE(\n\t\t\t'LostDeviceFoundOnline_DHL',\n\t\t\t'LostDeviceFoundOnline_DHL'[Data Source],\n\t\t\t'LostDeviceFoundOnline_DHL'[SerialNumber],\n\t\t\t'LostDeviceFoundOnline_DHL'[Enrollment Time],\n\t\t\t'LostDeviceFoundOnline_DHL'[LastConnTime],\n\t\t\t'LostDeviceFoundOnline_DHL'[BatteryStatus],\n\t\t\t'LostDeviceFoundOnline_DHL'[Model],\n\t\t\t'LostDeviceFoundOnline_DHL'[Current SOTI Path],\n\t\t\t'LostDeviceFoundOnline_DHL'[Reference]\n\t\t)\n\n\tVAR __DS0PrimaryWindowed = \n\t\tTOPN(\n\t\t\t501,\n\t\t\t__DS0Core,\n\t\t\t'LostDeviceFoundOnline_DHL'[Data Source],\n\t\t\t1,\n\t\t\t'LostDeviceFoundOnline_DHL'[SerialNumber],\n\t\t\t1,\n\t\t\t'LostDeviceFoundOnline_DHL'[Enrollment Time],\n\t\t\t1,\n\t\t\t'LostDeviceFoundOnline_DHL'[LastConnTime],\n\t\t\t1,\n\t\t\t'LostDeviceFoundOnline_DHL'[BatteryStatus],\n\t\t\t1,\n\t\t\t'LostDeviceFoundOnline_DHL'[Model],\n\t\t\t1,\n\t\t\t'LostDeviceFoundOnline_DHL'[Current SOTI Path],\n\t\t\t1,\n\t\t\t'LostDeviceFoundOnline_DHL'[Reference],\n\t\t\t1\n\t\t)\n\nEVALUATE\n\t__DS0PrimaryWindowed\n\nORDER BY\n\t'LostDeviceFoundOnline_DHL'[Data Source],\n\t'LostDeviceFoundOnline_DHL'[SerialNumber],\n\t'LostDeviceFoundOnline_DHL'[Enrollment Time],\n\t'LostDeviceFoundOnline_DHL'[LastConnTime],\n\t'LostDeviceFoundOnline_DHL'[BatteryStatus],\n\t'LostDeviceFoundOnline_DHL'[Model],\n\t'LostDeviceFoundOnline_DHL'[Current SOTI Path],\n\t'LostDeviceFoundOnline_DHL'[Reference]",
                  "specification/serializerSettings/includeNulls": false
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_powerbi",
                  "operationId": "ExecuteDatasetQuery",
                  "connectionName": "shared_powerbi-1"
                }
              }
            },
            "Select": {
              "type": "Select",
              "inputs": {
                "from": "@outputs('Run_a_query_against_a_dataset')?['body/firstTableRows']",
                "select": {
                  "Device Serial Number": "@string(item()?['LostDeviceFoundOnline_DHL[SerialNumber]'])",
                  "Device Path": "@item()?['LostDeviceFoundOnline_DHL[Current SOTI Path]']",
                  "Reference": "@item()?['LostDeviceFoundOnline_DHL[Reference]']",
                  "Last Connect Time": "@item()?['LostDeviceFoundOnline_DHL[LastConnTime]']",
                  "Enrollment Time": "@item()?['LostDeviceFoundOnline_DHL[Enrollment Time]']",
                  "Model": "@item()?['LostDeviceFoundOnline_DHL[Model]']",
                  "Battery Level": "@item()?['LostDeviceFoundOnline_DHL[BatteryStatus]']",
                  "Data Source": "@item()?['LostDeviceFoundOnline_DHL[Data Source]']"
                }
              },
              "runAfter": {
                "Run_a_query_against_a_dataset": [
                  "Succeeded"
                ]
              }
            },
            "Condition": {
              "type": "If",
              "expression": {
                "and": [
                  {
                    "greater": [
                      "@length(body('Select'))",
                      0
                    ]
                  }
                ]
              },
              "actions": {
                "Create_CSV_table": {
                  "type": "Table",
                  "inputs": {
                    "from": "@body('Select')",
                    "format": "CSV"
                  }
                },
                "Set_variable": {
                  "type": "SetVariable",
                  "inputs": {
                    "name": "varCSVContent",
                    "value": "@body('Create_CSV_table')"
                  },
                  "runAfter": {
                    "Create_CSV_table": [
                      "Succeeded"
                    ]
                  }
                },
                "Create_HTML_table": {
                  "type": "Table",
                  "inputs": {
                    "from": "@body('Select')",
                    "format": "HTML"
                  },
                  "runAfter": {
                    "Set_variable": [
                      "Succeeded"
                    ]
                  }
                },
                "Compose": {
                  "type": "Compose",
                  "inputs": "<style>\n    table {\n        width:100%;\n        height:100%;\n        border:1px solid #b3adad;\n        border-collapse:collapse;\n    }\n    table th {\n        border:1px solid #b3adad;\n        background: #FFCC00; /* Changed to red */\n        color: #d40511;\n    }\n    table td {\n        border:1px solid #b3adad;\n        text-align:center;\n        background: #ffffff;\n        color: #313030;\n    }\n</style>\n@{body('Create_HTML_table')}",
                  "runAfter": {
                    "Create_HTML_table": [
                      "Succeeded"
                    ]
                  }
                },
                "Send_an_email_(V2)": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "parameters": {
                      "emailMessage/To": "@outputs('EmailTO')",
                      "emailMessage/Subject": "EVRI Premium: Lost Device Back Online - @{formatDateTime(utcNow(),'ddMMyyyy')}",
                      "emailMessage/Body": "<p class=\"editor-paragraph\">Dear customer,<br><br>Please find attached the device list of lost devices back online.</p><p class=\"editor-paragraph\">@{outputs('Compose')}<br>Important: This is an automated notification sent from an unmonitored mailbox. Please do not reply to this email.</p><p class=\"editor-paragraph\"><br>For any questions regarding the report data, please reach out to the Premier Analytics team at <b><strong class=\"editor-text-bold\">premier.analytics@zebra.com</strong></b>.<br><br>Regards,<br>Strategic Innovation and Automation<br><br><br><span style=\"color: rgb(208, 2, 27);\">- CONFIDENTIAL-</span><br><br>This email and any files transmitted with it are confidential and may also be legally privileged. If you are not the intended recipient, you may not review, use, copy, or distribute this message. If you receive this email in error, please notify the sender immediately by reply email and then delete this email.</p>",
                      "emailMessage/From": "strategicinnovationandautomation@zebra.com",
                      "emailMessage/Cc": "@outputs('EmailCC')",
                      "emailMessage/Attachments": [
                        {
                          "Name": "EVRIPremium_LostBackOnlineDevices_@{formatDateTime(utcNow(),'ddMMyyyy')}.csv",
                          "ContentBytes": "@variables('varCSVContent')"
                        }
                      ],
                      "emailMessage/Importance": "Normal"
                    },
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                      "operationId": "SendEmailV2",
                      "connectionName": "shared_office365"
                    }
                  },
                  "runAfter": {
                    "Compose": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "else": {
                "actions": {
                  "Set_variable_1": {
                    "type": "SetVariable",
                    "inputs": {
                      "name": "varCSVContent",
                      "value": "Device Serial Number,\tDevice Path,\tReference,\tLast Connect Time,\tEnrollment Time,\tModel,\tBattery Level,\tData Source"
                    }
                  }
                }
              },
              "runAfter": {
                "Select": [
                  "Succeeded"
                ]
              }
            },
            "Create_file": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "dataset": "https://zebra.sharepoint.com/sites/DMSBAExternal",
                  "folderPath": "/Shared Documents/DHLPARCEL/SSIS_LOSTDEVICEBACKONLINE/@{formatDateTime(utcNow(),'yyyy')}/@{formatDateTime(utcNow(),'MMMM')}",
                  "name": "dhl_lost_back_online_@{formatDateTime(utcNow(), 'yyyy-MM-dd')}.csv",
                  "body": "@variables('varCSVContent')"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "operationId": "CreateFile",
                  "connectionName": "shared_sharepointonline"
                }
              },
              "runAfter": {
                "Condition": [
                  "Succeeded"
                ]
              },
              "runtimeConfiguration": {
                "contentTransfer": {
                  "transferMode": "Chunked"
                }
              }
            }
          },
          "runAfter": {
            "varCSVContent": [
              "Succeeded"
            ]
          }
        },
        "Error_Handling": {
          "type": "Scope",
          "actions": {
            "Post_message_in_a_chat_or_channel": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "poster": "Flow bot",
                  "location": "Channel",
                  "body/recipient/groupId": "02deece1-19d7-41b6-b50c-75e3cd5178ea",
                  "body/recipient/channelId": "19:b32c3b1c47a04ebf909717aa6eb147bc@thread.tacv2",
                  "body/messageBody": "<p class=\"editor-paragraph\">🚨 <b><strong class=\"editor-text-bold\" style=\"color: rgb(208, 2, 27);\">FLOW FAILED ALERT</strong></b>: DHL SSIS-Lost Devices Found 🚨<br><br>Flow Name: @{workflow()?['tags']['flowDisplayName']}<br>Run ID: @{workflow()?['run']['name']}<br>Link to Run: @{concat('https://make.powerautomate.com/environments/', workflow()?['name'], '/flows/', workflow()?['tags']['logicAppName'], '/runs/', workflow()?['run']['name'])}</p>"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams",
                  "operationId": "PostMessageToConversation",
                  "connectionName": "shared_teams"
                }
              }
            },
            "FAILED_Send_an_email_(V2)": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "emailMessage/To": "PQMN34@zebra.com",
                  "emailMessage/Subject": "🚨 FLOW FAILED ALERT: DHL SSIS-Lost Devices Found 🚨",
                  "emailMessage/Body": "<p class=\"editor-paragraph\">🚨 FLOW FAILED ALERT: DHL SSIS-Lost Devices Found 🚨<br><br><br>Flow Name: @{workflow()?['tags']['flowDisplayName']}<br>Run ID: @{workflow()?['run']['name']}<br>Link to Run: @{concat('https://make.powerautomate.com/environments/', workflow()?['name'], '/flows/', workflow()?['tags']['logicAppName'], '/runs/', workflow()?['run']['name'])}</p>",
                  "emailMessage/From": "strategicinnovationandautomation@zebra.com",
                  "emailMessage/Importance": "High"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                  "operationId": "SendEmailV2",
                  "connectionName": "shared_office365"
                }
              },
              "runAfter": {
                "Post_message_in_a_chat_or_channel": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {
            "Scope": [
              "TimedOut",
              "Failed",
              "Skipped"
            ]
          }
        }
      }
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}