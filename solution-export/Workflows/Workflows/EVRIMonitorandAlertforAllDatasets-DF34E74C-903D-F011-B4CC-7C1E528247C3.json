                      "specification/query": "EVALUATE\nROW(\n    \"OnlineDevices\", 'Zebra DB'[OnlineDevices],\n    \"OnlinePercentage\", 'Zebra DB'[OnlinePercentage]\n)",
                      "specification/serializerSettings/includeNulls": false
