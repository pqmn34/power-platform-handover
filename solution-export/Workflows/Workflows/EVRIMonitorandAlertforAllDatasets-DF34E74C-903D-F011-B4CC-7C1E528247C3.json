                "Compose_ZebraDropPercentage": {
                  "type": "Compose",
                  "inputs": "@if(greater(outputs('Compose_BaselineZebraDevices'), 0), \r\n   mul(div(sub(outputs('Compose_BaselineZebraDevices'), outputs('Compose_ZebraTC75')), outputs('Compose_BaselineZebraDevices')), 100), \r\n   0)",
