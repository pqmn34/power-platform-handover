                  "type": "Compose",
                  "inputs": "<html>\n  <body>\n    <p><strong>🛑 Alert:</strong> More than 15% of online production devices are offline in ZebraTC75.</p>\n    <p>Online Drop %: <span style=\"font-weight: bold; color: red;\">@{outputs('Compose_ZebraDropPercentageHTML')}%</span></p>\n    <p>Baseline Online Devices:<span style=\"font-weight: bold;\"> @{outputs('Compose_BaselineZebraDevices')}</span></p>\n    <p>Current Online Devices: <span style=\"font-weight: bold;\">@{outputs('Compose_ZebraTC75')}</span></p>\n  </body>\n</html>",
                  "runAfter": {
