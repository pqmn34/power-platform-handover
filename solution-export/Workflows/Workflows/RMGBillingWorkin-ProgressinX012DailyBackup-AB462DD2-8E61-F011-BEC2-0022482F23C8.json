              "specification/query": "DEFINE\n\tVAR __DS0FilterTable = \n\t\tFILTER(\n\t\t\tKEEPFILTERS(VALUES('RMGX012_TBW'[Address])),\n\t\t\tSEARCH(\"TBW\", 'RMGX012_TBW'[Address], 1, 0) >= 1\n\t\t)\n\n\tVAR __DS0Core = \n\t\tSELECTCOLUMNS(\n\t\t\tKEEPFILTERS(\n\t\t\t\tFILTER(\n\t\t\t\t\tKEEPFILTERS(\n\t\t\t\t\t\tSUMMARIZECOLUMNS(\n\t\t\t\t\t\t\t'RMGX012_TBW'[Serial No.],\n\t\t\t\t\t\t\t'RMGX012_TBW'[Address],\n\t\t\t\t\t\t\t'RMG_42Gears_Standard'[Group Path],\n\t\t\t\t\t\t\t__DS0FilterTable,\n\t\t\t\t\t\t\t\"CountRowsRMGX012_TBW\", COUNTROWS('RMGX012_TBW'),\n\t\t\t\t\t\t\t\"CountRowsRMG_42Gears_Standard\", COUNTROWS('RMG_42Gears_Standard')\n\t\t\t\t\t\t)\n\t\t\t\t\t),\n\t\t\t\t\tOR(\n\t\t\t\t\t\tOR(\n\t\t\t\t\t\t\tNOT(ISBLANK('RMGX012_TBW'[Serial No.])),\n\t\t\t\t\t\t\tNOT(ISBLANK('RMGX012_TBW'[Address]))\n\t\t\t\t\t\t),\n\t\t\t\t\t\tNOT(ISBLANK('RMG_42Gears_Standard'[Group Path]))\n\t\t\t\t\t)\n\t\t\t\t)\n\t\t\t),\n\t\t\t\"'RMGX012_TBW'[Serial No.]\", 'RMGX012_TBW'[Serial No.],\n\t\t\t\"'RMGX012_TBW'[Address]\", 'RMGX012_TBW'[Address],\n\t\t\t\"'RMG_42Gears_Standard'[Group Path]\", 'RMG_42Gears_Standard'[Group Path]\n\t\t)\n\nEVALUATE\n\t__DS0Core\n\nORDER BY\n\t'RMGX012_TBW'[Serial No.],\n\t'RMGX012_TBW'[Address],\n\t'RMG_42Gears_Standard'[Group Path]",
              "specification/serializerSettings/includeNulls": false
            },
