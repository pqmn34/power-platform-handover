                  "datasetid": "b6a56604-7b3d-487e-9038-96e00e480413",
                  "specification/query": "EVALUATE\nCALCULATETABLE(\n    SELECTCOLUMNS(\n        'Last Mobile Data Use RML',\n        \"SerialNumber\", 'Last Mobile Data Use RML'[Serial Number],\n        \"SiteCode\", 'Last Mobile Data Use RML'[Site Code],\n        \"ICCID\", 'Last Mobile Data Use RML'[ICCID],\n        \"OfflineDays\", 'Last Mobile Data Use RML'[Offline Days]\n    ),\n    'Last Mobile Data Use RML'[Days Since Mobile Data] >= 30,\n    'Last Mobile Data Use RML'[Offline Days] <= 30 \n)",
