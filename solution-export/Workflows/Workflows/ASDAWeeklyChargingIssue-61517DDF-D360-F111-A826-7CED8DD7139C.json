{
  "properties": {
    "connectionReferences": {
      "shared_powerbi": {
        "api": {
          "name": "shared_powerbi"
        },
        "connection": {
          "connectionReferenceLogicalName": "dms_sharedpowerbi_50189"
        },
        "runtimeSource": "embedded"
      },
      "shared_office365": {
        "api": {
          "name": "shared_office365"
        },
        "connection": {
          "connectionReferenceLogicalName": "new_sharedoffice365_bd676"
        },
        "runtimeSource": "embedded"
      },
      "shared_teams": {
        "api": {
          "name": "shared_teams"
        },
        "connection": {
          "connectionReferenceLogicalName": "new_sharedteams_ade65"
        },
        "runtimeSource": "embedded"
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "undefined",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        }
      },
      "triggers": {
        "Recurrence": {
          "type": "Recurrence",
          "recurrence": {
            "interval": 1,
            "frequency": "Week",
            "schedule": {
              "hours": [
                "11"
              ],
              "weekDays": [
                "Monday"
              ]
            },
            "timeZone": "UTC"
          }
        }
      },
      "actions": {
        "Initialize_variable_–_EndDate": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "EndDate",
                "type": "string",
                "value": "@formatDateTime(convertTimeZone(utcNow(),'UTC','GMT Standard Time'),'yyyy-MM-dd')"
              }
            ]
          },
          "runAfter": {
            "Email_Footer": [
              "Succeeded"
            ]
          }
        },
        "Initialize_variable_–_StartDate": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "StartDate",
                "type": "string",
                "value": "@formatDateTime(addDays(startOfDay(convertTimeZone(utcNow(),'UTC','GMT Standard Time')), -7), 'yyyy-MM-dd')"
              }
            ]
          },
          "runAfter": {
            "Initialize_variable_–_EndDate": [
              "Succeeded"
            ]
          }
        },
        "Email_Footer": {
          "type": "Compose",
          "inputs": "<hr>\n<div style=\"font-family: Calibri, sans-serif; font-size: 11pt; color: #595959;\">\n    <p>\n        <i><b>Important:</b> This is an automated notification sent from an unmonitored mailbox. Please do not reply to this email.</i>\n    </p>\n    <ul>\n        <li>Send an email to <a href=\"mailto:adela.bodor@zebra.com\">adela.bodor@zebra.com</a> if there is any error in the data or email.</li>\n    </ul>\n    <p>\n        Regards,<br>\n        Strategic Innovation and Automation\n    </p>\n    <p style=\"font-size: 10pt; color: #7F7F7F;\">\n        <b>- CONFIDENTIAL -</b><br>\n        This email and any files transmitted with it are confidential and may also be legally privileged. If you are not the intended recipient, you may not review, use, copy, or distribute this message. If you receive this email in error, please notify the sender immediately by reply email and then delete this email.\n    </p>\n</div>",
          "runAfter": {
            "Email-TO": [
              "Succeeded"
            ]
          }
        },
        "Email-TO": {
          "type": "Compose",
          "inputs": "jamie.glover@zebra.com;adela.bodor@zebra.com",
          "runAfter": {}
        },
        "Scope": {
          "type": "Scope",
          "actions": {
            "Compose_–_DAX_Top_Title": {
              "type": "Compose",
              "inputs": "@concat(\r\n'DEFINE\r\n    VAR __DS0FilterTable =\r\n        FILTER(\r\n            KEEPFILTERS(VALUES(''asda_viqf_charging_issue_by_device_grid''[record_date_day])),\r\n            AND(\r\n                ''asda_viqf_charging_issue_by_device_grid''[record_date_day] >= DATEVALUE(\"', variables('StartDate'), '\"),\r\n                ''asda_viqf_charging_issue_by_device_grid''[record_date_day] < DATEVALUE(\"', variables('EndDate'), '\")\r\n            )\r\n        )\r\nEVALUATE\r\n    SUMMARIZECOLUMNS(\r\n        __DS0FilterTable,\r\n        \"Charging_Issue_Device_Count_By_Site_Title\",\r\n        IGNORE(''asda_viqf_charging_issue_by_device_grid''[Charging Issue Device Count By Site Title])\r\n    )'\r\n)"
            },
            "Run_Top_Title": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "groupid": "ed7233e2-1daf-4288-a3fd-d4943f0b8f89",
                  "datasetid": "43ce7783-a9ec-4eda-8986-81ea10323a71",
                  "specification/query": "@outputs('Compose_–_DAX_Top_Title')",
                  "specification/serializerSettings/includeNulls": false
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_powerbi",
                  "operationId": "ExecuteDatasetQuery",
                  "connectionName": "shared_powerbi"
                }
              },
              "runAfter": {
                "Compose_–_DAX_Top_Title": [
                  "Succeeded"
                ]
              }
            },
            "Compose_–_DAX_Top_Data": {
              "type": "Compose",
              "inputs": "@concat(\n'DEFINE\n    VAR __DS0FilterTable =\n        FILTER(\n            KEEPFILTERS(VALUES(''asda_viqf_charging_issue_by_device_grid''[record_date_day])),\n            AND(\n                ''asda_viqf_charging_issue_by_device_grid''[record_date_day] >= DATEVALUE(\"', variables('StartDate'), '\"),\n                ''asda_viqf_charging_issue_by_device_grid''[record_date_day] < DATEVALUE(\"', variables('EndDate'), '\")\n            )\n        )\n\n    VAR __DS0Core =\n        SUMMARIZECOLUMNS(\n            ROLLUPADDISSUBTOTAL(\n                ROLLUPGROUP(\n                    ''asda_viqf_charging_issue_by_site_grid''[avg_total_usable_devices_res],\n                    ''asda_viqf_charging_issue_by_site_grid''[avg_dwell_time_mins_res],\n                    ''asda_viqf_charging_issue_by_site_grid''[max_availability_issues_res],\n                    ''DimSite''[Store Code],\n\t\t\t\t\t''DimSite''[Store Name]\n                ),\n                \"IsGrandTotalRowTotal\"\n            ),\n            __DS0FilterTable,\n            \"Distinct_Charging_Issue_Devices\",\n            ''asda_viqf_charging_issue_by_device_grid''[Distinct Charging Issue Devices]\n        )\n\n    VAR __DS0Rounded =\n        SELECTCOLUMNS(\n            FILTER(__DS0Core, [IsGrandTotalRowTotal] = FALSE()),\n            \"avg_total_usable_devices_res\", ROUND(''asda_viqf_charging_issue_by_site_grid''[avg_total_usable_devices_res], 0),\n            \"avg_dwell_time_mins_res\", ROUND(''asda_viqf_charging_issue_by_site_grid''[avg_dwell_time_mins_res], 0),\n            \"max_availability_issues_res\", ROUND(''asda_viqf_charging_issue_by_site_grid''[max_availability_issues_res], 0),\n            \"Store Code\", ''DimSite''[Store Code],\n\t\t\t\"Store Name\", ''DimSite''[Store Name],\n            \"Distinct_Charging_Issue_Devices\", [Distinct_Charging_Issue_Devices]\n        )\n\nEVALUATE\n    __DS0Rounded\n\nORDER BY\n    [Distinct_Charging_Issue_Devices] DESC,\n    [avg_total_usable_devices_res],\n    [avg_dwell_time_mins_res],\n    [max_availability_issues_res],\n    [Store Code],\n\t[Store Name]'\n)",
              "runAfter": {
                "Run_Top_Title": [
                  "Succeeded"
                ]
              }
            },
            "Run_a_query_against_a_dataset_–_Top_Data": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "groupid": "ed7233e2-1daf-4288-a3fd-d4943f0b8f89",
                  "datasetid": "43ce7783-a9ec-4eda-8986-81ea10323a71",
                  "specification/query": "@outputs('Compose_–_DAX_Top_Data')",
                  "specification/serializerSettings/includeNulls": false
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_powerbi",
                  "operationId": "ExecuteDatasetQuery",
                  "connectionName": "shared_powerbi"
                }
              },
              "runAfter": {
                "Compose_–_DAX_Top_Data": [
                  "Succeeded"
                ]
              }
            },
            "HTML_Top": {
              "type": "Table",
              "inputs": {
                "from": "@body('Run_a_query_against_a_dataset_–_Top_Data')?['results'][0]?['tables'][0]?['rows']",
                "format": "HTML",
                "columns": [
                  {
                    "header": "Store Code",
                    "value": "@item()?['[Store Code]']"
                  },
                  {
                    "header": "Store Name",
                    "value": "@item()?['[Store Name]']"
                  },
                  {
                    "header": "Avg Total Usuable Devices",
                    "value": "@item()?['[avg_total_usable_devices_res]']"
                  },
                  {
                    "header": "Avg Dwell Time Mins",
                    "value": "@item()?['[avg_dwell_time_mins_res]']"
                  },
                  {
                    "header": "Max Availability Issues",
                    "value": "@item()?['[max_availability_issues_res]']"
                  },
                  {
                    "header": "Charging Issue Devices",
                    "value": "@item()?['[Distinct_Charging_Issue_Devices]']"
                  }
                ]
              },
              "runAfter": {
                "Run_a_query_against_a_dataset_–_Top_Data": [
                  "Succeeded"
                ]
              }
            },
            "Create_CSV_table_-_Top": {
              "type": "Table",
              "inputs": {
                "from": "@body('Run_a_query_against_a_dataset_–_Top_Data')?['results'][0]?['tables'][0]?['rows']",
                "format": "CSV",
                "columns": [
                  {
                    "header": "Store Code",
                    "value": "@item()?['[Store Code]']"
                  },
                  {
                    "header": "Store Name",
                    "value": "@item()?['[Store Name]']"
                  },
                  {
                    "header": "Avg Total Usuable Devices",
                    "value": "@item()?['[avg_total_usable_devices_res]']"
                  },
                  {
                    "header": "Avg Dwell Time Mins",
                    "value": "@item()?['[avg_dwell_time_mins_res]']"
                  },
                  {
                    "header": "Max Availability Issues",
                    "value": "@item()?['[max_availability_issues_res]']"
                  },
                  {
                    "header": "Charging Issue Devices",
                    "value": "@item()?['[Distinct_Charging_Issue_Devices]']"
                  }
                ]
              },
              "runAfter": {
                "HTML_Top": [
                  "Succeeded"
                ]
              }
            },
            "Top_Title_Value": {
              "type": "Compose",
              "inputs": "@first(body('Run_Top_Title')?['results'][0]?['tables'][0]?['rows'])?['[Charging_Issue_Device_Count_By_Site_Title]']",
              "runAfter": {
                "Create_CSV_table_-_Top": [
                  "Succeeded"
                ]
              }
            },
            "DAX_Bottom_Title": {
              "type": "Compose",
              "inputs": "@concat(\r\n'DEFINE\r\n    VAR __DS0FilterTable =\r\n        FILTER(\r\n            KEEPFILTERS(VALUES(''asda_viqf_charging_issue_by_device_grid''[record_date_day])),\r\n            AND(\r\n                ''asda_viqf_charging_issue_by_device_grid''[record_date_day] >= DATEVALUE(\"', variables('StartDate'), '\"),\r\n                ''asda_viqf_charging_issue_by_device_grid''[record_date_day] < DATEVALUE(\"', variables('EndDate'), '\")\r\n            )\r\n        )\r\nEVALUATE\r\n    SUMMARIZECOLUMNS(\r\n        __DS0FilterTable,\r\n        \"Charging_Issue_Site_Per_Serial_Number_Title\",\r\n        IGNORE(''asda_viqf_charging_issue_by_device_grid''[Charging Issue Site Per Serial Number Title])\r\n    )'\r\n)",
              "runAfter": {
                "Top_Title_Value": [
                  "Succeeded"
                ]
              }
            },
            "Run_Bottom_Title": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "groupid": "ed7233e2-1daf-4288-a3fd-d4943f0b8f89",
                  "datasetid": "43ce7783-a9ec-4eda-8986-81ea10323a71",
                  "specification/query": "@outputs('DAX_Bottom_Title')",
                  "specification/serializerSettings/includeNulls": false
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_powerbi",
                  "operationId": "ExecuteDatasetQuery",
                  "connectionName": "shared_powerbi"
                }
              },
              "runAfter": {
                "DAX_Bottom_Title": [
                  "Succeeded"
                ]
              }
            },
            "Compose_–_DAX_Bottom_Data": {
              "type": "Compose",
              "inputs": "@{concat(\n'DEFINE\n    VAR __DS0FilterTable =\n        FILTER(\n            KEEPFILTERS(VALUES(''asda_viqf_charging_issue_by_device_grid''[record_date_day])),\n            AND(\n                ''asda_viqf_charging_issue_by_device_grid''[record_date_day] >= DATEVALUE(\"', variables('StartDate'), '\"),\n                ''asda_viqf_charging_issue_by_device_grid''[record_date_day] < DATEVALUE(\"', variables('EndDate'), '\")\n            )\n        )\n\n    VAR __DS0Core =\n        SELECTCOLUMNS(\n            KEEPFILTERS(\n                FILTER(\n                    KEEPFILTERS(\n                        SUMMARIZECOLUMNS(\n                            ''Latest Charging Issue By Device''[Date],\n                            ''Latest Charging Issue By Device''[Model],\n                            ''Latest Charging Issue By Device''[PSS Status],\n                            ''Latest Charging Issue By Device''[Device Serial Number],\n                            ''DimSite''[Store Code],\n\t\t\t\t\t\t\t''DimSite''[Store Name],\n                            __DS0FilterTable,\n                            \"CountRows\",\n                            COUNTROWS(''asda_viqf_charging_issue_by_device_grid'')\n                        )\n                    ),\n                    OR(\n                        OR(\n                            OR(\n                                OR(\n                                    NOT(ISBLANK(''Latest Charging Issue By Device''[Date])),\n                                    NOT(ISBLANK(''Latest Charging Issue By Device''[Model]))\n                                ),\n                                NOT(ISBLANK(''Latest Charging Issue By Device''[PSS Status]))\n                            ),\n                            NOT(ISBLANK(''Latest Charging Issue By Device''[Device Serial Number]))\n                        ),\n                        NOT(ISBLANK(''DimSite''[Store Name]))\n                    )\n                )\n            ),\n            \"Date\", FORMAT(''Latest Charging Issue By Device''[Date], \"yyyy-MM-dd\"),\n            \"Model\", ''Latest Charging Issue By Device''[Model],\n            \"PSS Status\", ''Latest Charging Issue By Device''[PSS Status],\n            \"Device Serial Number\", ''Latest Charging Issue By Device''[Device Serial Number],\n            \"Store Code\", ''DimSite''[Store Code],\n\t\t\t\"Store Name\", ''DimSite''[Store Name]\n        )\nEVALUATE\n    __DS0Core\nORDER BY\n    [Date] DESC,\n    [Model],\n    [PSS Status],\n    [Device Serial Number],\n    [Store Code],\n\t[Store Name]'\n)\n}\n",
              "runAfter": {
                "Run_Bottom_Title": [
                  "Succeeded"
                ]
              }
            },
            "Run_a_query_against_a_dataset_-_Bottom_Data": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "groupid": "ed7233e2-1daf-4288-a3fd-d4943f0b8f89",
                  "datasetid": "43ce7783-a9ec-4eda-8986-81ea10323a71",
                  "specification/query": "@outputs('Compose_–_DAX_Bottom_Data')",
                  "specification/serializerSettings/includeNulls": false
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_powerbi",
                  "operationId": "ExecuteDatasetQuery",
                  "connectionName": "shared_powerbi"
                }
              },
              "runAfter": {
                "Compose_–_DAX_Bottom_Data": [
                  "Succeeded"
                ]
              }
            },
            "HTML_Bottom": {
              "type": "Table",
              "inputs": {
                "from": "@body('Run_a_query_against_a_dataset_-_Bottom_Data')?['results'][0]?['tables'][0]?['rows']",
                "format": "HTML",
                "columns": [
                  {
                    "header": "Date",
                    "value": "@item()?['[Date]']"
                  },
                  {
                    "header": "Model",
                    "value": "@item()?['[Model]']"
                  },
                  {
                    "header": "PSS Status",
                    "value": "@item()?['[PSS Status]']"
                  },
                  {
                    "header": "Device Serial Number",
                    "value": "@item()?['[Device Serial Number]']"
                  },
                  {
                    "header": "Store Code",
                    "value": "@item()?['[Store Code]']"
                  },
                  {
                    "header": "Store Name",
                    "value": "@item()?['[Store Name]']"
                  }
                ]
              },
              "runAfter": {
                "Run_a_query_against_a_dataset_-_Bottom_Data": [
                  "Succeeded"
                ]
              }
            },
            "Create_CSV_table_-_Bottom": {
              "type": "Table",
              "inputs": {
                "from": "@body('Run_a_query_against_a_dataset_-_Bottom_Data')?['results'][0]?['tables'][0]?['rows']",
                "format": "CSV",
                "columns": [
                  {
                    "header": "Date",
                    "value": "@item()?['[Date]']"
                  },
                  {
                    "header": "Model",
                    "value": "@item()?['[Model]']"
                  },
                  {
                    "header": "PSS Status",
                    "value": "@item()?['[PSS Status]']"
                  },
                  {
                    "header": "Device Serial Number",
                    "value": "@item()?['[Device Serial Number]']"
                  },
                  {
                    "header": "Store Code",
                    "value": "@item()?['[Store Code]']"
                  },
                  {
                    "header": "Store Name",
                    "value": "@item()?['[Store Name]']"
                  }
                ]
              },
              "runAfter": {
                "HTML_Bottom": [
                  "Succeeded"
                ]
              }
            },
            "Bottom_Title_Value": {
              "type": "Compose",
              "inputs": "@first(body('Run_Bottom_Title')?['results'][0]?['tables'][0]?['rows'])?['[Charging_Issue_Site_Per_Serial_Number_Title]']",
              "runAfter": {
                "Create_CSV_table_-_Bottom": [
                  "Succeeded"
                ]
              }
            },
            "Email_Body": {
              "type": "Compose",
              "inputs": "@concat(\r\n'<html><head><style>',\r\n'body{font-family:Arial,sans-serif;font-size:13px;color:#222;margin:0;padding:20px;background-color:#ffffff;}',\r\n'p{margin:0 0 12px 0;}',\r\n'.layout{width:100%;border-collapse:separate;border-spacing:18px 0;}',\r\n'.layout td{vertical-align:top;border:none;padding:0;}',\r\n'.card{border:1px solid #a6a6a6;background-color:#ffffff;box-shadow:0 0 8px #d9d9d9;}',\r\n'.titlebar{background-color:#70ad47;color:#ffffff;font-weight:bold;text-align:center;padding:10px 12px;font-size:16px;border-bottom:1px solid #a6a6a6;}',\r\n'.tablewrap{padding:0;text-align:center;}',\r\n'.tablewrap table{border-collapse:collapse;width:100%;margin:0 auto;}',\r\n'.tablewrap th{background-color:#70ad47;color:#ffffff;border:1px solid #d9d9d9;padding:6px 10px;text-align:center;white-space:nowrap;font-weight:bold;}',\r\n'.tablewrap td{border:1px solid #d9d9d9;padding:6px 10px;white-space:nowrap;text-align:center;}',\r\n'.tablewrap tr:nth-child(even) td{background-color:#f9f9f9;}',\r\n'</style></head><body>',\r\n'<p>Hello Team,</p>',\r\n'<p>Please find below the weekly charging issue summary for ',\r\nvariables('StartDate'),\r\n' to ',\r\nformatDateTime(addDays(variables('EndDate'),-1),'yyyy-MM-dd'),\r\n'.</p>',\r\n'<table class=\"layout\"><tr>',\r\n'<td width=\"50%\">',\r\n'<div class=\"card\">',\r\n'<div class=\"titlebar\">', outputs('Top_Title_Value'), '</div>',\r\n'<div class=\"tablewrap\">', body('HTML_Top'), '</div>',\r\n'</div>',\r\n'</td>',\r\n'<td width=\"50%\">',\r\n'<div class=\"card\">',\r\n'<div class=\"titlebar\">', outputs('Bottom_Title_Value'), '</div>',\r\n'<div class=\"tablewrap\">', body('HTML_Bottom'), '</div>',\r\n'</div>',\r\n'</td>',\r\n'</tr></table>',\r\n'<p style=\"margin-top:16px;\">Raw CSV data is attached for reference.</p>',\r\n'</body></html>'\r\n)",
              "runAfter": {
                "Bottom_Title_Value": [
                  "Succeeded"
                ]
              }
            },
            "Send_an_email_(V2)": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "emailMessage/To": "@outputs('Email-TO')",
                  "emailMessage/Subject": "ASDA: @{concat(\r\n'Weekly Charging Issue Summary - ',\r\nvariables('StartDate'),\r\n' to ',\r\nformatDateTime(addDays(variables('EndDate'),-1),'yyyy-MM-dd')\r\n)\r\n}",
                  "emailMessage/Body": "<p class=\"editor-paragraph\">@{outputs('Email_Body')}</p><p class=\"editor-paragraph\">@{outputs('Email_Footer')}</p>",
                  "emailMessage/From": "strategicinnovationandautomation@zebra.com",
                  "emailMessage/Attachments": [
                    {
                      "Name": "@concat('ChargingIssueBySite_', formatDateTime(utcNow(),'yyyyMMdd'), '.csv')",
                      "ContentBytes": "@body('Create_CSV_table_-_Top')"
                    },
                    {
                      "Name": "@concat('ChargingIssueBySerial_', formatDateTime(utcNow(),'yyyyMMdd'), '.csv')",
                      "ContentBytes": "@body('Create_CSV_table_-_Bottom')"
                    }
                  ],
                  "emailMessage/Importance": "Normal"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                  "operationId": "SendEmailV2",
                  "connectionName": "shared_office365"
                }
              },
              "runAfter": {
                "Email_Body": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {
            "Initialize_variable_–_StartDate": [
              "Succeeded"
            ]
          }
        },
        "ERROR_HANDLING": {
          "type": "Scope",
          "actions": {
            "Filter_array": {
              "type": "Query",
              "inputs": {
                "from": "@result('Scope')",
                "where": "@equals(item()?['status'],'Failed')"
              }
            },
            "COMPOSE-ERROR_MESSAGE": {
              "type": "Compose",
              "inputs": "@coalesce(\n    first(body('Filter_Array'))?['body']?['error']?['message'],\n    first(body('Filter_Array'))?['outputs']?['body']?['error']?['message'],\n    first(body('Filter_Array'))?['error']?['message'],\n    'Unknown Error')",
              "runAfter": {
                "Filter_array": [
                  "Succeeded"
                ]
              }
            },
            "Post_message_in_a_chat_or_channel": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "poster": "Flow bot",
                  "location": "Channel",
