        "EVRi_Offline_More_Than_30_Days": {
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "groupid": "ed7233e2-1daf-4288-a3fd-d4943f0b8f89",
              "datasetid": "197b214a-ad12-4a8d-bb1f-ec6f7a6e218f",
              "specification/query": "// DAX Query\nDEFINE\n\tVAR __DS0FilterTable = \n\t\tFILTER(\n\t\t\tKEEPFILTERS(VALUES('Samsung and ET45 DB'[DeviceGroupPath])),\n\t\t\tAND(\n\t\t\t\tSEARCH(\"EVRI \", 'Samsung and ET45 DB'[DeviceGroupPath], 1, 0) >= 1,\n\t\t\t\tNOT(SEARCH(\"##Temp\", 'Samsung and ET45 DB'[DeviceGroupPath], 1, 0) >= 1)\n\t\t\t)\n\t\t)\n\n\tVAR __DS0FilterTable2 = \n\t\tTREATAS({\"Offline\"}, 'Samsung and ET45 DB'[Offline > 30 Days])\n\n\tVAR __DS0Core = \n\t\tCALCULATETABLE(\n\t\t\tSUMMARIZE(\n\t\t\t\t'Samsung and ET45 DB',\n\t\t\t\t'Samsung and ET45 DB'[Asset ID],\n\t\t\t\t'Samsung and ET45 DB'[SerialNo],\n\t\t\t\t'Samsung and ET45 DB'[Model],\n\t\t\t\t'Samsung and ET45 DB'[EnrollmentTime],\n\t\t\t\t'Samsung and ET45 DB'[LastDisConnTime],\n\t\t\t\t'Samsung and ET45 DB'[Offline Days],\n\t\t\t\t'Samsung and ET45 DB'[Business Division],\n\t\t\t\t'Samsung and ET45 DB'[Business Site],\n\t\t\t\t'Samsung and ET45 DB'[Business Unit],\n\t\t\t\t'Samsung and ET45 DB'[DeviceGroupPath],\n\t\t\t\t'Samsung and ET45 DB'[Offline > 30 Days],\n\t\t\t\t'Samsung and ET45 DB'[ICCID],\n\t\t\t\t'Samsung and ET45 DB'[DevID]\n\t\t\t),\n\t\t\tKEEPFILTERS(__DS0FilterTable),\n\t\t\tKEEPFILTERS(__DS0FilterTable2)\n\t\t)\n\nEVALUATE\n\t__DS0Core\n\nORDER BY\n\t'Samsung and ET45 DB'[DeviceGroupPath],\n\t'Samsung and ET45 DB'[Asset ID],\n\t'Samsung and ET45 DB'[SerialNo],\n\t'Samsung and ET45 DB'[Model],\n\t'Samsung and ET45 DB'[EnrollmentTime],\n\t'Samsung and ET45 DB'[LastDisConnTime],\n\t'Samsung and ET45 DB'[Offline Days],\n\t'Samsung and ET45 DB'[Business Division],\n\t'Samsung and ET45 DB'[Business Site],\n\t'Samsung and ET45 DB'[Business Unit],\n\t'Samsung and ET45 DB'[Offline > 30 Days],\n\t'Samsung and ET45 DB'[ICCID],\n\t'Samsung and ET45 DB'[DevID]\n",
              "specification/serializerSettings/includeNulls": false
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_powerbi",
              "operationId": "ExecuteDatasetQuery",
              "connectionName": "shared_powerbi"
            }
          },
          "runAfter": {
            "Offlinemorethan30days": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "ccaa465d-4163-4488-8927-3bf69158edde"
          }
