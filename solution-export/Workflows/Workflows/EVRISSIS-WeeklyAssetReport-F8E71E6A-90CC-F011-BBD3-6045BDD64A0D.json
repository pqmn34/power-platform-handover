{
  "properties": {
    "connectionReferences": {
      "shared_powerbi-1": {
        "api": {
          "name": "shared_powerbi"
        },
        "connection": {
          "connectionReferenceLogicalName": "dms_sharedpowerbi_1e112"
        },
        "runtimeSource": "embedded"
      },
      "shared_sharepointonline": {
        "api": {
          "name": "shared_sharepointonline"
        },
        "connection": {
          "connectionReferenceLogicalName": "cr4bb_b6599cff35a24544bcf663b98e2da320"
        },
        "runtimeSource": "embedded"
      },
      "shared_office365": {
        "api": {
          "name": "shared_office365"
        },
        "connection": {
          "connectionReferenceLogicalName": "new_sharedoffice365_bd676"
        },
        "runtimeSource": "embedded"
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "undefined",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        }
      },
      "triggers": {
        "Recurrence": {
          "type": "Recurrence",
          "recurrence": {
            "interval": 1,
            "frequency": "Week",
            "timeZone": "UTC",
            "startTime": "2025-11-27T00:00Z",
            "schedule": {
              "hours": [
                "1"
              ],
              "minutes": [
                30
              ],
              "weekDays": [
                "Monday"
              ]
            }
          }
        }
      },
      "actions": {
        "Run_a_query_against_a_dataset": {
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "groupid": "ed7233e2-1daf-4288-a3fd-d4943f0b8f89",
              "datasetid": "197b214a-ad12-4a8d-bb1f-ec6f7a6e218f",
              "specification/query": "DEFINE\n\tVAR __DS0Core = \n\t\tSUMMARIZE(\n\t\t\t'Weekly Asset Report',\n\t\t\t'Weekly Asset Report'[HardwareSerialNumber],\n\t\t\t'Weekly Asset Report'[Latitude],\n\t\t\t'Weekly Asset Report'[Longitude],\n\t\t\t'Weekly Asset Report'[Model],\n\t\t\t'Weekly Asset Report'[SHOPID],\n\t\t\t'Weekly Asset Report'[Online],\n\t\t\t'Weekly Asset Report'[DeviceGroupPath],\n\t\t\t'Weekly Asset Report'[LastDisconnectTime]\n\t\t)\n\nEVALUATE\n\t__DS0Core\n\nORDER BY\n\t'Weekly Asset Report'[SHOPID] DESC,\n\t'Weekly Asset Report'[Latitude],\n\t'Weekly Asset Report'[Longitude],\n\t'Weekly Asset Report'[Model],\n\t'Weekly Asset Report'[HardwareSerialNumber],\n\t'Weekly Asset Report'[Online],\n\t'Weekly Asset Report'[DeviceGroupPath],\n\t'Weekly Asset Report'[LastDisconnectTime]",
              "specification/serializerSettings/includeNulls": false
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_powerbi",
              "operationId": "ExecuteDatasetQuery",
              "connectionName": "shared_powerbi-1"
            }
          },
          "runAfter": {
            "varCSVContent": [
              "Succeeded"
            ]
          }
        },
        "varCSVContent": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "varCSVContent",
                "type": "string"
              }
            ]
          },
          "runAfter": {}
        },
        "Select": {
          "type": "Select",
          "inputs": {
            "from": "@outputs('Run_a_query_against_a_dataset')?['body/firstTableRows']",
            "select": {
              "HardwareSerialNumber": "@item()?['Weekly Asset Report[HardwareSerialNumber]']",
              "Latitude": "@item()?['Weekly Asset Report[Latitude]']",
              "Longitude": "@item()?['Weekly Asset Report[Longitude]']",
              "LastDisconnectTime": "@if(empty(item()?['Weekly Asset Report[LastDisconnectTime]']), null, formatDateTime(item()?['Weekly Asset Report[LastDisconnectTime]'],'yyyy-MM-dd HH:mm:ss'))",
              "Model": "@item()?['Weekly Asset Report[Model]']",
              "SHOPID": "@item()?['Weekly Asset Report[SHOPID]']",
              "IsOnline": "@item()?['Weekly Asset Report[Online]']",
              "DeviceGroupPath": "@item()?['Weekly Asset Report[DeviceGroupPath]']"
            }
          },
          "runAfter": {
            "Run_a_query_against_a_dataset": [
              "Succeeded"
            ]
          }
        },
        "Condition": {
          "type": "If",
          "expression": {
            "and": [
              {
                "greater": [
                  "@length(body('Select'))",
                  0
                ]
              }
            ]
          },
          "actions": {
            "Create_CSV_table": {
              "type": "Table",
              "inputs": {
                "from": "@body('Select')",
                "format": "CSV"
              }
            },
            "Set_variable": {
              "type": "SetVariable",
              "inputs": {
                "name": "varCSVContent",
                "value": "@body('Create_CSV_table')"
              },
              "runAfter": {
                "Create_CSV_table": [
                  "Succeeded"
                ]
              }
            },
            "Create_HTML_table": {
              "type": "Table",
              "inputs": {
                "from": "@body('Select')",
                "format": "HTML"
              },
              "runAfter": {
                "Set_variable": [
                  "Succeeded"
                ]
              }
            },
            "Compose": {
              "type": "Compose",
              "inputs": "<style>\n    table {\n        width:100%;\n        height:100%;\n        border:1px solid #b3adad;\n        border-collapse:collapse;\n    }\n    table th {\n        border:1px solid #b3adad;\n        background: #FFCC00; /* Changed to red */\n        color: #d40511;\n    }\n    table td {\n        border:1px solid #b3adad;\n        text-align:center;\n        background: #ffffff;\n        color: #313030;\n    }\n</style>\n@{body('Create_HTML_table')}",
              "runAfter": {
                "Create_HTML_table": [
                  "Succeeded"
                ]
              }
            }
          },
          "else": {
            "actions": {
              "Set_variable_1": {
                "type": "SetVariable",
                "inputs": {
                  "name": "varCSVContent",
                  "value": "HardwareSerialNumber,\tLatitude,\tLongitude,\tLastDisconnectTime,\tModel,\tSHOPID,\tIsOnline,\tDeviceGroupPath"
                }
              }
            }
          },
          "runAfter": {
            "Select": [
              "Succeeded"
            ]
          }
        },
        "Create_file": {
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "dataset": "https://zebra.sharepoint.com/sites/DMSBAExternal",
              "folderPath": "/Shared Documents/EVRi/SSIS_ASSETREPORTS/WEEKLYASSETREPORT/@{formatDateTime(utcNow(),'yyyy')}/@{formatDateTime(utcNow(),'MMMM')}",
              "name": "EVRI_Weekly_Asset_Report_@{formatDateTime(utcNow(), 'yyyy-MM-dd')}.csv",
              "body": "@variables('varCSVContent')"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "operationId": "CreateFile",
              "connectionName": "shared_sharepointonline"
            }
          },
          "runAfter": {
            "Condition": [
              "Succeeded"
            ]
          },
          "runtimeConfiguration": {
            "contentTransfer": {
              "transferMode": "Chunked"
            }
          }
        },
        "Send_an_email_(V2)": {
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "emailMessage/To": "gmssba@zebra.com;Jakub.Polak@zebra.com",
              "emailMessage/Subject": "EVRI: Weekly Asset Report - @{formatDateTime(utcNow(),'ddMMyyyy')}",
              "emailMessage/Body": "<p class=\"editor-paragraph\">Dear Team,<br><br>Please find the latest data from SOTI for ET45, TC58E and SM-X205 device.</p><p class=\"editor-paragraph\"><br>Important: This is an automated notification sent from an unmonitored mailbox. Please do not reply to this email.</p><p class=\"editor-paragraph\"><br>For any questions regarding the report data, please reach out to the Premier Analytics team at <b><strong class=\"editor-text-bold\">premier.analytics@zebra.com</strong></b>.<br><br>Regards,<br>Strategic Innovation and Automation<br><br><br><span style=\"color: rgb(208, 2, 27);\">- CONFIDENTIAL-</span><br><br>This email and any files transmitted with it are confidential and may also be legally privileged. If you are not the intended recipient, you may not review, use, copy, or distribute this message. If you receive this email in error, please notify the sender immediately by reply email and then delete this email.</p>",
              "emailMessage/From": "strategicinnovationandautomation@zebra.com",
              "emailMessage/Attachments": [
                {
                  "Name": "EVRI_Weekly_Asset_Report_@{formatDateTime(utcNow(), 'yyyy-MM-dd')}.csv",
                  "ContentBytes": "@variables('varCSVContent')"
                }
              ],
              "emailMessage/Importance": "Normal"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
              "operationId": "SendEmailV2",
              "connectionName": "shared_office365"
            }
          },
          "runAfter": {
            "Create_file": [
              "Succeeded"
            ]
          }
        }
      }
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}