                "Create_HTML_table_-_YMSuccess": {
                  "type": "Table",
                  "inputs": {
                    "from": "@variables('SuccessList')",
                    "format": "HTML"
                  },
                  "runAfter": {
                    "Apply_to_each-YellowMsg": [
                      "Succeeded"
                    ]
                  }
                },
                "Send_an_email_(V2)_-_YellowMessage": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "parameters": {
                      "emailMessage/To": "pqmn34@zebra.com",
                      "emailMessage/Subject": "RMG: Battery Decommissioning Yellow Message",
                      "emailMessage/Body": "<p class=\"editor-paragraph\">Hello,</p><br><p class=\"editor-paragraph\">The 42Gears Yellow Message job has completed.</p><p class=\"editor-paragraph\"><br><b><strong class=\"editor-text-bold\">Job ID:</strong></b> @{outputs('Compose-YellowMsgJobId')}<br><b><strong class=\"editor-text-bold\">Successful devices:</strong></b> @{length(variables('SuccessList'))}<br><b><strong class=\"editor-text-bold\">Failed devices:</strong></b> @{length(variables('FailedList'))}</p><br><h3 class=\"editor-heading-h3\">Successful Devices<br>@{outputs('Create_HTML_table_-_YMSuccess')}<br></h3><p class=\"editor-paragraph\">Failed Devices<br>@{outputs('Create_HTML_table_-_YMFailed')}</p><br><h3 class=\"editor-heading-h3\"><br></h3>",
                      "emailMessage/Attachments": [
                        {
                          "Name": "rmg_yellow_message_@{formatDateTime(utcNow(),'yyyy-mm-dd')}.csv",
                          "ContentBytes": "@body('Create_CSV_table-YellowMsgDevices')"
                        }
                      ],
                      "emailMessage/Importance": "Normal"
                    },
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                      "operationId": "SendEmailV2",
                      "connectionName": "shared_office365"
                    }
                  },
                  "runAfter": {
                    "Post_message_in_a_chat_or_channel-YellowMessageStatus": [
                      "Succeeded"
                    ]
                  }
