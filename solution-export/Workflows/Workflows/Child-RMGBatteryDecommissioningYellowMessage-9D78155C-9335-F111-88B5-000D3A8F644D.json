        "Scope_-_CATCH_(Error_Handler)": {
          "type": "Scope",
          "actions": {
            "Post_message_in_a_chat_or_channel-FAILED": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "poster": "Flow bot",
                  "location": "Channel",
                  "body/recipient/groupId": "02deece1-19d7-41b6-b50c-75e3cd5178ea",
                  "body/recipient/channelId": "19:b32c3b1c47a04ebf909717aa6eb147bc@thread.tacv2",
                  "body/messageBody": "<p class=\"editor-paragraph\">🚨 <b><strong class=\"editor-text-bold\" style=\"background-color: rgb(208, 2, 27); color: rgb(255, 255, 255);\">FLOW FAILED</strong></b>: Battery Message Job 🚨<br>An error occurred during the flow execution.<br><br>Flow Run Link: [@{concat('https://make.powerautomate.com/environments/', workflow()?['tags']?['environmentName'], '/flows/', workflow()?['name'], '/runs/', workflow()?['run']?['name'])}]<br>Failed Step: [@{first(body('Filter_array'))?['name']}]<br>Error Details: [@{coalesce(first(body('Filter_array'))?['error']?['message'], 'No specific error message provided by the API/Action.')}]</p>"
