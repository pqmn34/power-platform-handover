                                "Device Serial Number": "@{items('Apply_to_each-YellowMsg')?['Device Serial Number']}",
                                "Job ID": "@{outputs('Compose-YellowMsgJobId')}",
                                "HTTP Status": "@{string(outputs('HTTP_Apply_YM_Job')?['statusCode'])}",
                                "API Message": "@{coalesce(outputs('HTTP_Apply_YM_Job')?['body']?['message'], 'Failed to apply job')}"
                              }
                            }
                          }
                        }
                      },
                      "runAfter": {
                        "HTTP_Apply_YM_Job": [
                          "Succeeded"
                        ]
                      }
                    },
                    "Delay_YellowMsg": {
                      "type": "Wait",
                      "inputs": {
                        "interval": {
                          "count": 1,
                          "unit": "Second"
                        }
                      },
                      "runAfter": {
                        "ConditionYM": [
                          "Succeeded"
                        ]
                      }
                    }
                  },
                  "runAfter": {
                    "Compose-YellowMsgJobId": [
                      "Succeeded"
                    ]
                  }
                },
                "Create_HTML_table_-_YMFailed": {
                  "type": "Table",
                  "inputs": {
                    "from": "@variables('FailedList')",
                    "format": "HTML"
