                "Apply_to_each-YellowMsg": {
                  "type": "Foreach",
                  "foreach": "@body('Select-YellowMsg')",
                  "actions": {
                    "HTTP_Apply_YM_Job": {
                      "type": "Http",
                      "inputs": {
                        "uri": "@outputs('URI')",
                        "method": "POST",
                        "headers": {
                          "ApiKey": "@{outputs('Get_secret_-_Key')?['body/value']}",
                          "Content-TypeContent-Type": "application/json"
                        },
                        "body": {
                          "DeviceIds": [
                            "@{items('Apply_to_each-YellowMsg')?['Device ID']}"
                          ],
                          "JobId": "@{outputs('Compose-YellowMsgJobId')}",
                          "DownloadType": "2"
                        },
                        "authentication": {
                          "type": "Basic",
                          "username": "@{outputs('Get_secret_UID')?['body/value']}",
                          "password": "@{outputs('Get_secret_PSWD')?['body/value']}"
                        }
                      },
                      "runtimeConfiguration": {
                        "contentTransfer": {
                          "transferMode": "Chunked"
                        }
                      }
                    },
                    "ConditionYM": {
                      "type": "If",
                      "expression": {
                        "and": [
                          {
                            "equals": [
                              "@coalesce(outputs('HTTP_Apply_YM_Job')?['body']?['status'], false)",
                              true
                            ]
                          }
                        ]
                      },
                      "actions": {
                        "Append_to_array_variable-YMSuccess": {
                          "type": "AppendToArrayVariable",
                          "inputs": {
                            "name": "SuccessList",
                            "value": {
                              "Device ID": "@{items('Apply_to_each-YellowMsg')?['Device ID']}",
                              "Site Name": "@{items('Apply_to_each-YellowMsg')?['Site Name']}",
                              "Device Serial Number": "@{items('Apply_to_each-YellowMsg')?['Device Serial Number']}",
                              "Job ID": "@{outputs('Compose-YellowMsgJobId')}",
                              "HTTP Status": "@{string(outputs('HTTP_Apply_YM_Job')?['statusCode'])}",
                              "API Message": "@{coalesce(outputs('HTTP_Apply_YM_Job')?['body']?['message'], 'Success')}"
                            }
                          }
                        }
                      },
                      "else": {
                        "actions": {
