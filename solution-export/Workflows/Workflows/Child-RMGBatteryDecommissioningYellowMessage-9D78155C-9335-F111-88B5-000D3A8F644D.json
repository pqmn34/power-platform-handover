                "Post_message_in_a_chat_or_channel-YellowMessageStatus": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "parameters": {
                      "poster": "User",
                      "location": "Channel",
                      "body/recipient/groupId": "02deece1-19d7-41b6-b50c-75e3cd5178ea",
                      "body/recipient/channelId": "19:b32c3b1c47a04ebf909717aa6eb147bc@thread.tacv2",
                      "body/messageBody": "<p class=\"editor-paragraph\"><b><strong class=\"editor-text-bold\">Message:</strong></b> \"✅ <b><strong class=\"editor-text-bold\" style=\"background-color: rgb(248, 231, 28);\">Yellow Message Update:</strong></b></p><br><p class=\"editor-paragraph\">The 42Gears Yellow Message job has completed.<br><br>Job ID: @{outputs('Compose-YellowMsgJobId')}<br>Successful devices: @{length(variables('SuccessList'))}<br>Failed devices: @{length(variables('FailedList'))}<br><br></p><br>"
                    },
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams",
                      "operationId": "PostMessageToConversation",
                      "connectionName": "shared_teams"
                    }
                  },
                  "runAfter": {
                    "Create_HTML_table_-_YMFailed": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "else": {
                "actions": {
                  "Post_message_in_a_chat_or_channel-YellowMessage": {
                    "type": "OpenApiConnection",
                    "inputs": {
                      "parameters": {
                        "poster": "User",
                        "location": "Channel",
                        "body/recipient/groupId": "02deece1-19d7-41b6-b50c-75e3cd5178ea",
                        "body/recipient/channelId": "19:b32c3b1c47a04ebf909717aa6eb147bc@thread.tacv2",
                        "body/messageBody": "<p class=\"editor-paragraph\"><b><strong class=\"editor-text-bold\">Message:</strong></b> \"✅ <b><strong class=\"editor-text-bold\" style=\"background-color: rgb(248, 231, 28);\">Yellow Message Update:</strong></b> There are 0 devices pending for Yellow messages today. No action taken.\"</p>"
                      },
                      "host": {
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams",
                        "operationId": "PostMessageToConversation",
                        "connectionName": "shared_teams"
                      }
                    }
                  }
                }
              }
            }
          },
          "runAfter": {
            "Delay_Until": [
