              "timestamp": "@if(\n  less(int(formatDateTime(utcNow(), 'HH')), 4),\n  concat(formatDateTime(utcNow(), 'yyyy-MM-dd'), 'T01:00:00Z'),\n  concat(formatDateTime(addDays(utcNow(), 1), 'yyyy-MM-dd'), 'T01:00:00Z')\n)"
