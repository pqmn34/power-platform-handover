                    "from": "@outputs('Run_a_query_against_a_dataset_-_YellowMsg')?['body/firstTableRows']",
                    "select": {
                      "RML DOBI": "@item()?['Yellow Message[RML DOBI]']",
                      "DOBI": "@item()?['Yellow Message[DOBI]']",
                      "Battery Health": "@item()?['Yellow Message[Battery Health]']",
                      "Device Serial Number": "@item()?['Yellow Message[Device Serial Number]']",
                      "Message Due Date": "@item()?['Yellow Message[Message Due Date]']",
                      "RML Site": "@item()?['Yellow Message[RML Site]']",
                      "Ship Date": "@item()?['Yellow Message[Ship Date]']",
                      "Missmatch DOBI": "@item()?['Yellow Message[Missmatch DOBI]']",
                      "Site Name": "@item()?['Yellow Message[Site Name]']",
                      "Device ID": "@item()?['Yellow Message[Device ID]']"
