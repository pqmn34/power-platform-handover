                        "datasetid": "1f3a7570-032b-4a95-924f-9dd86f205314",
                        "specification/query": "DEFINE\n\tVAR __DS0Core = \n\t\tSUMMARIZE(\n\t\t\t'Offiline Found GT7 Devices',\n\t\t\t'Offiline Found GT7 Devices'[DeviceName],\n\t\t\t'Offiline Found GT7 Devices'[DeviceOffline>7Days],\n\t\t\t'Offiline Found GT7 Devices'[DevID],\n\t\t\t'Offiline Found GT7 Devices'[HardwareSerialNumber],\n\t\t\t'Offiline Found GT7 Devices'[ICCID],\n\t\t\t'Offiline Found GT7 Devices'[IMEI],\n\t\t\t'Offiline Found GT7 Devices'[OfflineDays],\n\t\t\t'Offiline Found GT7 Devices'[Path]\n\t\t)\n\nEVALUATE\n\t__DS0Core\n\nORDER BY\n\t'Offiline Found GT7 Devices'[DeviceName],\n\t'Offiline Found GT7 Devices'[DeviceOffline>7Days],\n\t'Offiline Found GT7 Devices'[DevID],\n\t'Offiline Found GT7 Devices'[HardwareSerialNumber],\n\t'Offiline Found GT7 Devices'[ICCID],\n\t'Offiline Found GT7 Devices'[IMEI],\n\t'Offiline Found GT7 Devices'[OfflineDays],\n\t'Offiline Found GT7 Devices'[Path]",
                        "specification/serializerSettings/includeNulls": false
                      },
                      "host": {
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_powerbi",
                        "operationId": "ExecuteDatasetQuery",
                        "connectionName": "shared_powerbi-1"
