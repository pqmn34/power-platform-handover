                      "body/recipient/groupId": "02deece1-19d7-41b6-b50c-75e3cd5178ea",
                      "body/recipient/channelId": "19:b32c3b1c47a04ebf909717aa6eb147bc@thread.tacv2",
                      "body/messageBody": "<p class=\"editor-paragraph\"><b><strong class=\"editor-text-bold\" style=\"background-color: rgb(126, 211, 33); color: rgb(255, 255, 255);\">PASSED</strong></b>: XPO Found Folder CleanUp For Offline&gt;7Days</p><br><p class=\"editor-paragraph\"><b><strong class=\"editor-text-bold\">THERE IS NO DEVICE OFFLINE&gt;7DAYS IN THE FOUND FOLDER</strong></b><br><br>Flow Name: @{workflow()?['tags']['flowDisplayName']}<br>Run ID: @{workflow()?['run']['name']}<br>Link to Run: @{concat('https://make.powerautomate.com/environments/', workflow()?['name'], '/flows/', workflow()?['tags']['logicAppName'], '/runs/', workflow()?['run']['name'])}</p>"
                    },
