{
  "properties": {
    "connectionReferences": {
      "shared_powerbi": {
        "api": {
          "name": "shared_powerbi"
        },
        "connection": {
          "connectionReferenceLogicalName": "dms_sharedpowerbi_50189"
        },
        "runtimeSource": "embedded"
      },
      "shared_sharepointonline": {
        "api": {
          "name": "shared_sharepointonline"
        },
        "connection": {
          "connectionReferenceLogicalName": "dms_sharedsharepointonline_4deeb"
        },
        "runtimeSource": "embedded"
      },
      "shared_office365": {
        "api": {
          "name": "shared_office365"
        },
        "connection": {
          "connectionReferenceLogicalName": "new_sharedoffice365_bd676"
        },
        "runtimeSource": "embedded"
      },
      "shared_teams": {
        "api": {
          "name": "shared_teams"
        },
        "connection": {
          "connectionReferenceLogicalName": "new_sharedteams_ade65"
        },
        "runtimeSource": "embedded"
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "undefined",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        }
      },
      "triggers": {
        "Recurrence": {
          "type": "Recurrence",
          "recurrence": {
            "interval": 1,
            "frequency": "Week",
            "timeZone": "UTC",
            "startTime": "2026-02-24T09:00:00Z",
            "schedule": {
              "hours": [
                "7"
              ],
              "weekDays": [
                "Monday"
              ]
            }
          }
        }
      },
      "actions": {
        "MinRows": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "MinRows",
                "type": "integer",
                "value": 1
              }
            ]
          },
          "runAfter": {}
        },
        "IncrRows": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "incrRows",
                "type": "integer",
                "value": 5000
              }
            ]
          },
          "runAfter": {
            "MinRows": [
              "Succeeded"
            ]
          }
        },
        "appendCSV": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "appendCSV",
                "type": "string"
              }
            ]
          },
          "runAfter": {
            "IncrRows": [
              "Succeeded"
            ]
          }
        },
        "LoopsVar": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "LoopsVar",
                "type": "integer",
                "value": 1
              }
            ]
          },
          "runAfter": {
            "appendCSV": [
              "Succeeded"
            ]
          }
        },
        "Scope": {
          "type": "Scope",
          "actions": {
            "Calculate_Loops": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "groupid": "ed7233e2-1daf-4288-a3fd-d4943f0b8f89",
                  "datasetid": "b6a56604-7b3d-487e-9038-96e00e480413",
                  "specification/query": "EVALUATE\nROW(\n    \"loopsNeeded\", ROUNDUP(\n        CALCULATE(DISTINCTCOUNT('Battery Health Cleaned By BID'[Index]))/@{variables('incrRows')}, 1) + 1\n    )",
                  "specification/serializerSettings/includeNulls": false
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_powerbi",
                  "operationId": "ExecuteDatasetQuery",
                  "connectionName": "shared_powerbi"
                }
              }
            },
            "Loops2run": {
              "type": "Compose",
              "inputs": "@outputs('Calculate_Loops')?['body/firstTableRows']?[0]?['[loopsNeeded]']",
              "runAfter": {
                "Calculate_Loops": [
                  "Succeeded"
                ]
              }
            },
            "Do_until": {
              "type": "Until",
              "expression": "@greaterOrEquals(variables('LoopsVar'),outputs('Loops2run'))",
              "limit": {
                "count": 60,
                "timeout": "PT1H"
              },
              "actions": {
                "Run_a_query_against_a_dataset": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "parameters": {
                      "groupid": "ed7233e2-1daf-4288-a3fd-d4943f0b8f89",
                      "datasetid": "b6a56604-7b3d-487e-9038-96e00e480413",
                      "specification/query": "DEFINE\n    VAR __DS0FilterTable = \n        FILTER(\n            KEEPFILTERS(VALUES('Battery Health Cleaned By BID'[Index])), \n            AND('Battery Health Cleaned By BID'[Index] >= @{variables('MinRows')}, 'Battery Health Cleaned By BID'[Index] <= @{variables('incrRows')})\n        )\n\n    VAR __DS0Core = \n        CALCULATETABLE(\n            SELECTCOLUMNS(\n                'Battery Health Cleaned By BID',\n                \"Battery Health Cleaned By BID[Battery Discharge]\", 'Battery Health Cleaned By BID'[Battery Discharge],\n                \"Battery Health Cleaned By BID[Battery Health Status]\", 'Battery Health Cleaned By BID'[Battery Health Status],\n                \"Battery Health Cleaned By BID[Battery ID (BID)]\", 'Battery Health Cleaned By BID'[Battery ID (BID)],\n                \"Battery Health Cleaned By BID[Battery Level]\", 'Battery Health Cleaned By BID'[Battery Level],\n                \"Battery Health Cleaned By BID[Battery Serial Number]\", 'Battery Health Cleaned By BID'[Battery Serial Number],\n                \"Battery Health Cleaned By BID[Battery Type]\", 'Battery Health Cleaned By BID'[Battery Type],\n                \"Battery Health Cleaned By BID[Device Serial Number]\", 'Battery Health Cleaned By BID'[Device Serial Number],\n                \"Battery Health Cleaned By BID[DOBI]\", 'Battery Health Cleaned By BID'[DOBI],\n                \"Battery Health Cleaned By BID[Site Code Name]\", 'Battery Health Cleaned By BID'[Site Code Name],\n                \"Battery Health Cleaned By BID[Site Name]\", 'Battery Health Cleaned By BID'[Site Name],\n                \"Battery Health Cleaned By BID[Site Norm Hierarchy]\", 'Battery Health Cleaned By BID'[Site Norm Hierarchy],\n                \"Battery Health Cleaned By BID[Record Timestamp]\", 'Battery Health Cleaned By BID'[Record Timestamp],\n                \"Battery Health Cleaned By BID[Battery Part Number]\", 'Battery Health Cleaned By BID'[Battery Part Number],\n                \"Index\", 'Battery Health Cleaned By BID'[Index]\n            ),\n            __DS0FilterTable\n        )\n\nEVALUATE\n    __DS0Core\nORDER BY\n    [Index]\n",
                      "specification/serializerSettings/includeNulls": false
                    },
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_powerbi",
                      "operationId": "ExecuteDatasetQuery",
                      "connectionName": "shared_powerbi"
                    }
                  }
                },
                "Create_CSV_table": {
                  "type": "Table",
                  "inputs": {
                    "from": "@body('Select')",
                    "format": "CSV"
                  },
                  "runAfter": {
                    "Select": [
                      "Succeeded"
                    ]
                  }
                },
                "IncrMinRows": {
                  "type": "IncrementVariable",
                  "inputs": {
                    "name": "MinRows",
                    "value": 5000
                  },
                  "runAfter": {
                    "Create_CSV_table": [
                      "Succeeded"
                    ]
                  }
                },
                "IncrRows2": {
                  "type": "IncrementVariable",
                  "inputs": {
                    "name": "incrRows",
                    "value": 5000
                  },
                  "runAfter": {
                    "IncrMinRows": [
                      "Succeeded"
                    ]
                  }
                },
                "IncrLoops": {
                  "type": "IncrementVariable",
                  "inputs": {
                    "name": "LoopsVar",
                    "value": 1
                  },
                  "runAfter": {
                    "IncrRows2": [
                      "Succeeded"
                    ]
                  }
                },
                "Append_to_string_variable": {
                  "type": "AppendToStringVariable",
                  "inputs": {
                    "name": "appendCSV",
                    "value": "@if(equals(variables('LoopsVar'), 2), body('Create_CSV_Table'), join(skip(split(body('Create_CSV_Table'), decodeUriComponent('%0A')),1), decodeUriComponent('%0A')))"
                  },
                  "runAfter": {
                    "IncrLoops": [
                      "Succeeded"
                    ]
                  }
                },
                "Select": {
                  "type": "Select",
                  "inputs": {
                    "from": "@outputs('Run_a_query_against_a_dataset')?['body/firstTableRows']",
                    "select": {
                      "Battery Discharge": "@item()?['[Battery Health Cleaned By BID[Battery Discharge]]']",
                      "Battery Health Status": "@item()?['[Battery Health Cleaned By BID[Battery Health Status]]']",
                      "Battery ID (BID)": "@item()?['[Battery Health Cleaned By BID[Battery ID (BID)]]']",
                      "Battery Level": "@item()?['[Battery Health Cleaned By BID[Battery Level]]']",
                      "Battery Serial Number": "@item()?['[Battery Health Cleaned By BID[Battery Serial Number]]']",
                      "Battery Type": "@item()?['[Battery Health Cleaned By BID[Battery Type]]']",
                      "Device Serial Number": "@item()?['[Battery Health Cleaned By BID[Device Serial Number]]']",
                      "DOBI": "@item()?['[Battery Health Cleaned By BID[DOBI]]']",
                      "Site Code Name": "@item()?['[Battery Health Cleaned By BID[Site Code Name]]']",
                      "Site Name": "@item()?['[Battery Health Cleaned By BID[Site Name]]']",
                      "Site Norm Hierarchy": "@item()?['[Battery Health Cleaned By BID[Site Norm Hierarchy]]']",
                      "Record Timestamp": "@item()?['[Battery Health Cleaned By BID[Record Timestamp]]']",
                      "Battery Part Number": "@item()?['[Battery Health Cleaned By BID[Battery Part Number]]']"
                    }
                  },
                  "runAfter": {
                    "Run_a_query_against_a_dataset": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "runAfter": {
                "Loops2run": [
                  "Succeeded"
                ]
              }
            },
            "convert2csv": {
              "type": "Compose",
              "inputs": "@variables('appendCSV')",
              "runAfter": {
                "Do_until": [
                  "Succeeded"
                ]
              }
            },
            "Create_file": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "dataset": "https://zebra.sharepoint.com/sites/DMSBAExternal",
                  "folderPath": "/Shared Documents/RMG/VIQF BATTERY HEALTH/@{formatDateTime(utcNow(), 'yyyy')}/@{formatDateTime(utcNow(), 'MMMM')}/",
                  "name": "RMG_VIQF_Battery_Health_@{concat(formatDateTime(utcNow(), 'yyyy-MM-ddTHH-mm-ss'), '.csv')}",
                  "body": "@outputs('convert2csv')"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "operationId": "CreateFile",
                  "connectionName": "shared_sharepointonline"
                }
              },
              "runAfter": {
                "convert2csv": [
                  "Succeeded"
                ]
              },
              "runtimeConfiguration": {
                "contentTransfer": {
                  "transferMode": "Chunked"
                }
              }
            },
            "Condition": {
              "type": "If",
              "expression": {
                "and": [
                  {
                    "equals": [
                      "@dayOfWeek(utcNow())",
                      1
                    ]
                  }
                ]
              },
              "actions": {
                "Send_an_email_(V2)": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "parameters": {
                      "emailMessage/To": "veronika.anzidei@zebra.com;jan.zboril@zebra.com",
                      "emailMessage/Subject": "RMG: VIQF Battery Health Weekly Report",
                      "emailMessage/Body": "<p class=\"editor-paragraph\">Greetings!</p><br><p class=\"editor-paragraph\">Please find attached \"RMG VIQF Battery Health Report\" weekly.</p><br><p class=\"editor-paragraph\">Regards</p><br><p class=\"editor-paragraph\">Strategic Innovation and Automation</p>",
                      "emailMessage/Bcc": "StrategicInnovationandAutomation@Zebra.com",
                      "emailMessage/Attachments": [
                        {
                          "Name": "RMG_VIQF_Battery_Health_@{concat(formatDateTime(utcNow(), 'yyyy-MM-ddTHH-mm-ss'), '.csv')}",
                          "ContentBytes": "@outputs('convert2csv')"
                        }
                      ],
                      "emailMessage/Importance": "Normal"
                    },
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                      "operationId": "SendEmailV2",
                      "connectionName": "shared_office365"
                    }
                  }
                }
              },
              "else": {
                "actions": {
                  "Terminate": {
                    "type": "Terminate",
                    "inputs": {
                      "runStatus": "Succeeded"
                    }
                  }
                }
              },
              "runAfter": {
                "Create_file": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {
            "LoopsVar": [
              "Succeeded"
            ]
          }
        },
        "CatchError": {
          "type": "Scope",
          "actions": {
            "Post_message_in_a_chat_or_channel_2": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "poster": "Flow bot",
                  "location": "Channel",
                  "body/recipient/groupId": "02deece1-19d7-41b6-b50c-75e3cd5178ea",
                  "body/recipient/channelId": "19:b32c3b1c47a04ebf909717aa6eb147bc@thread.tacv2",
                  "body/messageBody": "<div style=\"border: 1px solid #e0e0e0; border-radius: 5px; overflow: hidden; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\">\n    <div style=\"background-color: #d83b01; color: white; padding: 10px; font-weight: bold; font-size: 16px;\">\n        🚨 FAILED: @{workflow()?['tags']['flowDisplayName']}\n    </div>\n    <div style=\"padding: 15px; background-color: #f9f9f9;\">\n        <table style=\"width: 100%; border-collapse: collapse;\">\n            <tbody>\n                <tr>\n                    <td style=\"padding: 5px 0; color: #666; width: 30%;\"><strong>Flow Name:</strong></td>\n                    <td style=\"padding: 5px 0;\">@{workflow()?['tags']['flowDisplayName']}</td>\n                </tr>\n                <tr>\n                    <td style=\"padding: 5px 0; color: #666;\"><strong>Failed Action:</strong></td>\n                    <td style=\"padding: 5px 0;\">@{body('Filter_array')?[0]?['name']}</td>\n                </tr>\n                <tr>\n                    <td style=\"padding: 5px 0; color: #d83b01;\"><strong>Error Message:</strong></td>\n                    <td style=\"padding: 5px 0; color: #d83b01;\"><b><u></u></b></td>\n                </tr>\n                <tr>\n                    <td style=\"padding: 5px 0; color: #666;\"><strong>Run ID:</strong></td>\n                    <td style=\"padding: 5px 0; font-family: monospace; font-size: 12px;\">@{workflow()?['run']?['name']}</td>\n                </tr>\n            </tbody>\n        </table>\n        <br>\n        <a href=\"@{concat('https://make.powerautomate.com/environments/', workflow()?['tags']?['environmentName'], '/flows/', workflow()?['name'], '/runs/', workflow()?['run']?['name'])}\" style=\"background-color: #0078d4; color: white; padding: 8px 16px; text-decoration: none; border-radius: 4px; display: inline-block;\">\n           View Failed Run\n        </a>\n    </div>\n</div>"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams",
                  "operationId": "PostMessageToConversation",
                  "connectionName": "shared_teams"
                }
              },
              "runAfter": {
                "Error_Message": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "17abc631-73de-42a9-8eed-e0fced8927f4"
              }
            },
            "Filter_array": {
              "type": "Query",
              "inputs": {
                "from": "@result('Scope')",
                "where": "@equals(item()?['status'],'Failed')"
              },
              "metadata": {
                "operationMetadataId": "08e78cd4-f7ed-4d96-af4f-ecde0685b1e1"
              }
            },
            "Error_Message": {
              "type": "Compose",
              "inputs": "@coalesce(\n    first(body('Filter_Array'))?['body']?['error']?['message'],\n    first(body('Filter_Array'))?['outputs']?['body']?['error']?['message'],\n    first(body('Filter_Array'))?['error']?['message'],\n    'Unknown Error')",
              "runAfter": {
                "Filter_array": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "a9e6c5c5-033e-49fc-9627-d2f232ced68a"
              }
            }
          },
          "runAfter": {
            "Scope": [
              "Failed",
              "Skipped",
              "TimedOut"
            ]
          },
          "metadata": {
            "operationMetadataId": "69d47855-5ed9-43dc-a4af-b9ea6ec2ff02"
          }
        }
      }
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}