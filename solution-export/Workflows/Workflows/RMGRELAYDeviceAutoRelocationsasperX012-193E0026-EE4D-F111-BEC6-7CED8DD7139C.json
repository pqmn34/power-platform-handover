              "datasetid": "01eb5fcd-97e7-443a-aa11-6be57bed6ae7",
              "specification/query": "DEFINE\n\tVAR __DS0FilterTable = \n\t\tFILTER(\n\t\t\tKEEPFILTERS(VALUES('groupId_42gears_relay_relocation_path'[X012_CleanedDOBI])),\n\t\t\tNOT('groupId_42gears_relay_relocation_path'[X012_CleanedDOBI] IN {BLANK()})\n\t\t)\n\n\tVAR __DS0FilterTable2 = \n\t\tFILTER(\n\t\t\tKEEPFILTERS(VALUES('groupId_42gears_relay_relocation_path'[Group Path])),\n\t\t\tSEARCH(\"_Staging\", 'groupId_42gears_relay_relocation_path'[Group Path], 1, 0) >= 1\n\t\t)\n\n\tVAR __DS0FilterTable3 = \n\t\tFILTER(\n\t\t\tKEEPFILTERS(VALUES('groupId_42gears_relay_relocation_path'[TargetGroupID])),\n\t\t\tNOT('groupId_42gears_relay_relocation_path'[TargetGroupID] IN {BLANK()})\n\t\t)\n\n\tVAR __DS0FilterTable4 = \n\t\tTREATAS({\"RELAY\"}, 'groupId_42gears_relay_relocation_path'[Build Profile])\n\n\tVAR __DS0Core = \n\t\tCALCULATETABLE(\n\t\t\tSUMMARIZE(\n\t\t\t\t'groupId_42gears_relay_relocation_path',\n\t\t\t\t'groupId_42gears_relay_relocation_path'[X012_CleanedDOBI],\n\t\t\t\t'groupId_42gears_relay_relocation_path'[Serial Number],\n\t\t\t\t'groupId_42gears_relay_relocation_path'[Group Path],\n\t\t\t\t'groupId_42gears_relay_relocation_path'[TargetGroupPath],\n\t\t\t\t'groupId_42gears_relay_relocation_path'[Device ID],\n\t\t\t\t'groupId_42gears_relay_relocation_path'[TargetGroupID]\n\t\t\t),\n\t\t\tKEEPFILTERS(__DS0FilterTable),\n\t\t\tKEEPFILTERS(__DS0FilterTable2),\n\t\t\tKEEPFILTERS(__DS0FilterTable3),\n\t\t\tKEEPFILTERS(__DS0FilterTable4)\n\t\t)\n\nEVALUATE\n\t__DS0Core\n\nORDER BY\n\t'groupId_42gears_relay_relocation_path'[X012_CleanedDOBI],\n\t'groupId_42gears_relay_relocation_path'[Serial Number],\n\t'groupId_42gears_relay_relocation_path'[Group Path],\n\t'groupId_42gears_relay_relocation_path'[TargetGroupPath],\n\t'groupId_42gears_relay_relocation_path'[Device ID],\n\t'groupId_42gears_relay_relocation_path'[TargetGroupID]",
              "specification/serializerSettings/includeNulls": false
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_powerbi",
              "operationId": "ExecuteDatasetQuery",
              "connectionName": "shared_powerbi-1"
            }
          },
