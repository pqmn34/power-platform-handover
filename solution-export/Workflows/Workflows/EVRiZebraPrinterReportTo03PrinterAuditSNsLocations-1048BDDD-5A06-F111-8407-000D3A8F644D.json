    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "undefined",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        }
      },
      "triggers": {
        "When_a_new_email_arrives_in_a_shared_mailbox_(V2)": {
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "mailboxAddress": "StrategicInnovationandAutomation@Zebra.com",
              "toOrCc": "StrategicInnovationandAutomation@Zebra.com",
              "from": "Donna.Ineson@Evri.com",
              "importance": "Any",
              "hasAttachments": false,
              "includeAttachments": true,
              "folderId": "Inbox"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
              "operationId": "SharedMailboxOnNewEmailV2",
              "connectionName": "shared_office365"
            }
          },
          "recurrence": {
            "frequency": "Minute",
            "interval": 1
          },
          "conditions": [
            {
              "expression": "@contains(triggerOutputs()?['body/subject'], 'Zebra printer report')"
            }
          ],
          "splitOn": "@triggerOutputs()?['body/value']"
        }
      },
      "actions": {
        "Scope": {
          "type": "Scope",
          "actions": {
            "For_each": {
              "type": "Foreach",
              "foreach": "@triggerOutputs()?['body/attachments']",
              "actions": {
                "Condition": {
                  "type": "If",
                  "expression": {
                    "and": [
                      {
                        "endsWith": [
                          "@outputs('Compose')",
                          "csv"
                        ]
                      }
                    ]
                  },
                  "actions": {
                    "Get_files_(properties_only)": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "parameters": {
                          "dataset": "https://zebra.sharepoint.com/sites/Evri-TC75Samsung",
                          "table": "5ee76847-ab2c-434c-ae26-350f0fbb4716",
                          "folderPath": "/Shared Documents/General/Printer Management (ZT410, ZT411, ZT230)/03. Printer Audit, SNs & Locations",
                          "viewScopeOption": "Default"
                        },
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                          "operationId": "GetFileItems",
                          "connectionName": "shared_sharepointonline-1"
                        }
                      },
                      "runAfter": {
                        "AttachmentName": [
                          "Succeeded"
                        ]
                      }
                    },
                    "Apply_to_each": {
                      "type": "Foreach",
                      "foreach": "@outputs('Get_files_(properties_only)')?['body/value']",
                      "actions": {
                        "Condition_1": {
                          "type": "If",
                          "expression": {
                            "and": [
                              {
                                "endsWith": [
                                  "@items('Apply_to_each')?['{FilenameWithExtension}']",
                                  "v"
                                ]
                              }
                            ]
                          },
                          "actions": {
                            "Move_file": {
                              "type": "OpenApiConnection",
                              "inputs": {
                                "parameters": {
                                  "dataset": "https://zebra.sharepoint.com/sites/Evri-TC75Samsung",
                                  "parameters/sourceFileId": "@items('Apply_to_each')?['{Identifier}']",
                                  "parameters/destinationDataset": "https://zebra.sharepoint.com/sites/Evri-TC75Samsung",
                                  "parameters/destinationFolderPath": "/Shared Documents/General/Printer Management (ZT410, ZT411, ZT230)/03. Printer Audit, SNs & Locations/0. Archive",
                                  "parameters/nameConflictBehavior": 2
                                },
                                "host": {
                                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                                  "operationId": "MoveFileAsync",
                                  "connectionName": "shared_sharepointonline-1"
                                }
                              }
                            }
                          },
                          "else": {
                            "actions": {}
                          }
                        }
                      },
                      "runAfter": {
                        "Get_files_(properties_only)": [
                          "Succeeded"
                        ]
                      }
                    },
                    "AttachmentName": {
                      "type": "Compose",
                      "inputs": "@outputs('Compose')"
                    },
                    "Create_file": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "parameters": {
                          "dataset": "https://zebra.sharepoint.com/sites/Evri-TC75Samsung",
                          "folderPath": "/Shared Documents/General/Printer Management (ZT410, ZT411, ZT230)/03. Printer Audit, SNs & Locations",
                          "name": "@outputs('AttachmentName')",
                          "body": "@base64ToBinary(item()?['contentBytes'])"
                        },
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                          "operationId": "CreateFile",
                          "connectionName": "shared_sharepointonline"
                        }
                      },
                      "runAfter": {
                        "Apply_to_each": [
                          "Succeeded"
                        ]
                      },
                      "runtimeConfiguration": {
                        "contentTransfer": {
                          "transferMode": "Chunked"
                        }
                      }
                    }
                  },
                  "else": {
                    "actions": {}
                  },
                  "runAfter": {
                    "Compose": [
                      "Succeeded"
                    ]
                  }
                },
                "Compose": {
                  "type": "Compose",
                  "inputs": "@item()?['name']"
                }
              }
            }
          },
          "runAfter": {}
        },
        "CatchError": {
          "type": "Scope",
          "actions": {
            "Post_message_in_a_chat_or_channel": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "poster": "Flow bot",
                  "location": "Channel",
                  "body/recipient/groupId": "02deece1-19d7-41b6-b50c-75e3cd5178ea",
                  "body/recipient/channelId": "19:b32c3b1c47a04ebf909717aa6eb147bc@thread.tacv2",
                  "body/messageBody": "<div style=\"border: 1px solid #e0e0e0; border-radius: 5px; overflow: hidden; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\">\n    <div style=\"background-color: #d83b01; color: white; padding: 10px; font-weight: bold; font-size: 16px;\">\n        🚨 FAILED: @{workflow()?['tags']['flowDisplayName']}\n    </div>\n    <div style=\"padding: 15px; background-color: #f9f9f9;\">\n        <table style=\"width: 100%; border-collapse: collapse;\">\n            <tbody>\n                <tr>\n                    <td style=\"padding: 5px 0; color: #666; width: 30%;\"><strong>Flow Name:</strong></td>\n                    <td style=\"padding: 5px 0;\">@{workflow()?['tags']['flowDisplayName']}</td>\n                </tr>\n                <tr>\n                    <td style=\"padding: 5px 0; color: #666;\"><strong>Failed Action:</strong></td>\n                    <td style=\"padding: 5px 0;\">@{body('Filter_array')?[0]?['name']}</td>\n                </tr>\n                <tr>\n                    <td style=\"padding: 5px 0; color: #d83b01;\"><strong>Error Message:</strong></td>\n                    <td style=\"padding: 5px 0; color: #d83b01;\"><b><u></u></b></td>\n                </tr>\n                <tr>\n                    <td style=\"padding: 5px 0; color: #666;\"><strong>Run ID:</strong></td>\n                    <td style=\"padding: 5px 0; font-family: monospace; font-size: 12px;\">@{workflow()?['run']?['name']}</td>\n                </tr>\n            </tbody>\n        </table>\n        <br>\n        <a href=\"@{concat('https://make.powerautomate.com/environments/', workflow()?['tags']?['environmentName'], '/flows/', workflow()?['name'], '/runs/', workflow()?['run']?['name'])}\" style=\"background-color: #0078d4; color: white; padding: 8px 16px; text-decoration: none; border-radius: 4px; display: inline-block;\">\n           View Failed Run\n        </a>\n    </div>\n</div>"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams",
                  "operationId": "PostMessageToConversation",
                  "connectionName": "shared_teams"
                }
              },
              "runAfter": {
                "Error_Message": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "17abc631-73de-42a9-8eed-e0fced8927f4"
              }
            },
            "Filter_array": {
              "type": "Query",
              "inputs": {
                "from": "@result('Scope')",
                "where": "@equals(item()?['status'],'Failed')"
              },
              "metadata": {
                "operationMetadataId": "08e78cd4-f7ed-4d96-af4f-ecde0685b1e1"
              }
            },
            "Error_Message": {
              "type": "Compose",
              "inputs": "@coalesce(\n    first(body('Filter_Array'))?['body']?['error']?['message'],\n    first(body('Filter_Array'))?['outputs']?['body']?['error']?['message'],\n    first(body('Filter_Array'))?['error']?['message'],\n    'Unknown Error')",
              "runAfter": {
                "Filter_array": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "a9e6c5c5-033e-49fc-9627-d2f232ced68a"
              }
            }
          },
          "runAfter": {
            "Scope": [
              "TimedOut",
              "Skipped",
              "Failed"
            ]
          },
          "metadata": {
            "operationMetadataId": "69d47855-5ed9-43dc-a4af-b9ea6ec2ff02"
          }
        }
      }
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}