              "specification/query": "DEFINE\n\tVAR __DS0FilterTable = \n\t\tFILTER(\n\t\t\tKEEPFILTERS(VALUES('Devices ET45'[build])),\n\t\t\tNOT('Devices ET45'[build] IN {\"HDP_PEAK\"})\n\t\t)\n\n\tVAR __DS0FilterTable2 = \n\t\tTREATAS({\"TC58E\",\n\t\t\t\"ET45\"}, 'Devices ET45'[Model])\n\n\tVAR __DS0FilterTable3 = \n\t\tTREATAS({\"Offline\"}, 'Devices ET45'[Offline > 30 Days])\n\n\tVAR __DS0FilterTable4 = \n\t\tFILTER(\n\t\t\tKEEPFILTERS(VALUES('Devices ET45'[Path])),\n\t\t\tSEARCH(\"EMEA\\UK\\\", 'Devices ET45'[Path], 1, 0) >= 1\n\t\t)\n\n\tVAR __DS0Core = \n\t\tCALCULATETABLE(\n\t\t\tSUMMARIZE(\n\t\t\t\t'Devices ET45',\n\t\t\t\t'Devices ET45'[DeviceName],\n\t\t\t\t'Devices ET45'[Serial Number],\n\t\t\t\t'Devices ET45'[Model],\n\t\t\t\t'Devices ET45'[EnrollmentTime],\n\t\t\t\t'Devices ET45'[LastAgentConnectTime],\n\t\t\t\t'Devices ET45'[Days Offline],\n\t\t\t\t'Devices ET45'[Project],\n\t\t\t\t'Devices ET45'[Site],\n\t\t\t\t'Devices ET45'[Deployment],\n\t\t\t\t'Devices ET45'[Path],\n\t\t\t\t'Devices ET45'[ICCID Text],\n\t\t\t\t'Devices ET45'[DeviceId],\n\t\t\t\t'Devices ET45'[Offline > 30 Days]\n\t\t\t),\n\t\t\tKEEPFILTERS(__DS0FilterTable),\n\t\t\tKEEPFILTERS(__DS0FilterTable2),\n\t\t\tKEEPFILTERS(__DS0FilterTable3),\n\t\t\tKEEPFILTERS(__DS0FilterTable4)\n\t\t)\n\nEVALUATE\n\t__DS0Core\n\nORDER BY\n\t'Devices ET45'[Deployment] DESC,\n\t'Devices ET45'[DeviceName],\n\t'Devices ET45'[Serial Number],\n\t'Devices ET45'[Model],\n\t'Devices ET45'[EnrollmentTime],\n\t'Devices ET45'[LastAgentConnectTime],\n\t'Devices ET45'[Days Offline],\n\t'Devices ET45'[Project],\n\t'Devices ET45'[Site],\n\t'Devices ET45'[Path],\n\t'Devices ET45'[ICCID Text],\n\t'Devices ET45'[DeviceId],\n\t'Devices ET45'[Offline > 30 Days]",
              "specification/serializerSettings/includeNulls": false
            },
            "host": {
