                  "else": {
                    "actions": {
                      "Send_an_email_(V2)": {
                        "type": "OpenApiConnection",
                        "inputs": {
                          "parameters": {
                            "emailMessage/To": "@outputs('EmailTO')",
                            "emailMessage/Subject": "EVRi Premium: Offline > 60 Days Lost Devices",
                            "emailMessage/Body": "<p class=\"editor-paragraph\">@{outputs('Compose_Email')}<br><b><strong class=\"editor-text-bold\">EVRI PREMIUM DEVICES</strong></b></p><p class=\"editor-paragraph\">@{outputs('Compose')}</p><br><p class=\"editor-paragraph\">For any questions regarding the report data, please contact your Zebra Service Manager (jakub.polak@zebra.com).<br><br><i><em class=\"editor-text-italic\">Important: This is an automated notification sent from an unmonitored mailbox. Please do not reply to this email.</em></i><br><br>Regards,<br>Strategic Innovation and Automation<br><br><br><span style=\"color: rgb(208, 2, 27);\">- CONFIDENTIAL-</span><br><br>This email and any files transmitted with it are confidential and may also be legally privileged. If you are not the intended recipient, you may not review, use, copy, or distribute this message. If you receive this email in error, please notify the sender immediately by reply email and then delete this email.</p><br>",
                            "emailMessage/Sensitivity": "9ca67e64-6921-4a30-921f-923231455f5f",
                            "emailMessage/From": "strategicinnovationandautomation@zebra.com",
                            "emailMessage/Cc": "@outputs('EmailCC')",
                            "emailMessage/Bcc": "PQMN34@zebra.com",
                            "emailMessage/Attachments": [
                              {
                                "Name": "evri_premium_offlineGT60days_lost.csv",
                                "ContentBytes": "@body('Create_CSV_tableGT60Days')"
                              }
                            ],
                            "emailMessage/Importance": "High"
                          },
                          "host": {
                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                            "operationId": "SendEmailV2",
                            "connectionName": "shared_office365"
                          }
                        },
                        "runAfter": {
                          "Compose_Email": [
                            "Succeeded"
                          ]
                        },
                        "metadata": {
                          "operationMetadataId": "e6f6822a-6a99-4569-8c54-fce4ceabd249"
                        }
                      },
                      "Compose_Email": {
                        "type": "Compose",
                        "inputs": "<html>\n<head>\n  <meta charset=\"UTF-8\">\n</head>\n<body style=\"font-family: Arial, Helvetica, sans-serif; font-size: 14px; color: #000000; line-height: 1.6;\">\n  \n  <p>Greetings!,</p>\n\n  <p>Please find attached the report of <b>Offline &gt; 60 Days Lost devices</b>.</p>\n\n  <p>As per the <b>Lost and Stolen Process Automation</b>:</p>\n\n  <ul>\n    <li>\n      <b>1st of the Month:</b> Receive the list of devices offline for more than 15 days for the Service Desk record only.\n    </li>\n    <li>\n      <b>15th of the Month:</b> Receive the list of devices offline for more than 30 days before moving the devices to the <b>\"Lost\"</b> category for the Service Desk record.\n      <br>\n      Review the report: If there is any <b>PEAK</b> device, move it back to the site folder mentioned in the attached report.\n    </li>\n    <li>\n      <b>28th of the Month:</b> Receive the list of Lost Devices offline for more than 60 days for the Service Desk record.\n    </li>\n  </ul>\n\n  <p><b>1st of the Month (again):</b> Receive the list of Lost Devices offline for more than 60 days for the Service Desk actions.</p>\n\n  <p><b>Review the report:</b></p>\n  <ul>\n    <li>\n      <b>If a PEAK device is found:</b><br>\n      Move the device back to the site where it belongs (site information can be found in the offline &gt; 30 days report received on the 15th of the month).\n    </li>\n    <li>\n      <b>If no PEAK device is found:</b><br>\n      Click on the \"<span style=\"color: red; font-weight: bold;\">Approve</span>\" button in the Teams notification once the data has been reviewed successfully.\n    </li>\n  </ul>\n\n  <p style=\"font-style: italic;\">\n  </p>\n  <p>\n    Kindly create a Salesforce case and share it in the email to \n    <a href=\"mailto:strategicinnovationandautomation@zebra.com\">strategicinnovationandautomation@zebra.com</a>\n    If there are any concerns or questions about the reported data.\n  </p>\n\n  <p>\n    To delete the devices:\n    <a href=\"Approve\" style=\"color: red; font-weight: bold; text-decoration: underline;\"></a>\n  </p>\n\n</body>\n</html>\n"
                      },
                      "Start_and_wait_for_an_approval": {
                        "type": "OpenApiConnectionWebhook",
                        "inputs": {
                          "parameters": {
                            "approvalType": "Basic",
                            "WebhookApprovalCreationInput/title": "Approval Required - Delete Lost Devices Offline > 60 Days [EVRI Premium]",
                            "WebhookApprovalCreationInput/assignedTo": "martin.zidek@zebra.com;michaela.pastourmatzi@zebra.com;PQMN34@zebra.com",
                            "WebhookApprovalCreationInput/details": "Please review the list of Lost Devices that have been offline for more than 60 days.\n\nTotal devices identified: @{outputs('CountOfflineGT60Days')?['body']?['firstTableRows'][0]?['[CountLostSNGT60Days]']}\n\nIf approved, the listed devices will be deleted from SOTI MobiControl.\nIf rejected, no deletion will happen.",
                            "WebhookApprovalCreationInput/enableNotifications": true,
                            "WebhookApprovalCreationInput/enableReassignment": true
                          },
                          "host": {
                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_approvals",
                            "operationId": "StartAndWaitForAnApproval",
                            "connectionName": "shared_approvals"
                          }
                        },
                        "runAfter": {
                          "Send_an_email_(V2)": [
                            "Succeeded"
                          ]
                        }
                      },
                      "Condition_ChildFlow": {
                        "type": "If",
                        "expression": {
                          "and": [
                            {
                              "equals": [
                                "@outputs('Start_and_wait_for_an_approval')?['body/outcome']",
                                "Approve"
                              ]
                            }
                          ]
                        },
                        "actions": {
                          "For_each": {
                            "type": "foreach",
                            "foreach": "@outputs('Start_and_wait_for_an_approval')?['body/responses']",
                            "actions": {
                              "Run_a_Child_Flow": {
                                "type": "Workflow",
                                "inputs": {
                                  "host": {
                                    "workflowReferenceName": "de022694-002e-f111-88b3-7ced8dd7139c"
                                  },
                                  "body": {
                                    "text": "@items('For_each')?['responder/email']"
                                  }
                                }
                              }
                            }
                          }
                        },
                        "else": {
                          "actions": {}
                        },
                        "runAfter": {
                          "Start_and_wait_for_an_approval": [
                            "Succeeded"
                          ]
                        }
                      }
                    }
