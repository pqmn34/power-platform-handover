                  "Succeeded"
                ]
              }
            },
            "Create_HTML_table": {
              "type": "Table",
              "inputs": {
                "from": "@body('SelectGT60Days')",
                "format": "HTML"
              },
              "runAfter": {
                "Compose_-_Devices_JSON_String": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "8eda08a8-3d37-4ec3-b5a7-164e7b69c72c"
              }
            },
            "Compose": {
              "type": "Compose",
              "inputs": "<style>\n    table {\n        width:100%;\n        height:100%;\n        border:1px solid #b3adad;\n        border-collapse:collapse;\n    }\n    table th {\n        border:1px solid #b3adad;\n        background: #0000FF; /* Blue background color */\n        color: #FFFFFF; /* White font color */\n    }\n    table td {\n        border:1px solid #b3adad;\n        text-align:center;\n        background: #ffffff;\n        color: #313030;\n    }\n</style>\n@{body('Create_HTML_table')}",
              "runAfter": {
